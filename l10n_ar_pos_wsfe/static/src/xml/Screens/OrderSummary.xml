<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="OrderWidget" t-inherit="point_of_sale.OrderWidget" t-inherit-mode="extension" owl="1">
        <xpath expr="//OrderSummary" position="attributes">
            <attribute name="perception">state.perception</attribute>
            <attribute name="show_perception">state.show_perception</attribute>
        </xpath>
    </t>

    <t t-name="OrderSummary" t-inherit="point_of_sale.OrderSummary" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('total')]" position="inside">
            <div t-if="props.perception and props.show_perception" class="subentry">
                Perceptions:
                <span class="value">
                    <t t-esc="props.perception" />
                </span>
            </div>
        </xpath>
    </t>

</templates>
