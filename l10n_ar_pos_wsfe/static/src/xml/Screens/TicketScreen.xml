<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[@class='header-row']/div[text()='Employee']" position="after">
            <div class="col">Origin</div>
        </xpath>
        <xpath expr="//div[@class='order-row']/div[div[text()='Employee']]" position="after">
            <div class="col">
                <div t-if="env.isMobile">Origin</div>
                <div><t t-esc="getDocOrigin(order)" /></div>
            </div>
        </xpath>
    </t>

</templates>
