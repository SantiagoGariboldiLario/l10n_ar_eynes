<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t
        t-name="ClientDetailsEdit"
        t-inherit="point_of_sale.ClientDetailsEdit"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[hasclass('client-details-left')]" position="inside">
            <div class="client-detail">
                <span class="label">Fiscal Position *</span>
                <select
                    class="detail client-address-states needsclick"
                    name="property_account_position_id"
                    t-on-change="captureChange"
                >
                    <option value="">None</option>
                    <t t-foreach="env.pos.all_fiscal_positions" t-as="acc_position" t-key="acc_position.id">
                        <option
                            t-att-value="acc_position.id"
                            t-att-selected="props.partner.property_account_position_id ? ((acc_position.id === props.partner.property_account_position_id[0]) ? true : undefined) : undefined"
                        >
                                <t t-esc="acc_position.name" />
                        </option>
                    </t>
                </select>
            </div>
        </xpath>
    </t>

</templates>
