<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">

        <xpath expr="//div[hasclass('message')]" position="before">
            <div class="subtotal">
                <span>Impuestos: <t t-esc="total_iva_and_retentions" /></span>
                <br />
                <span>Percepciones: <t t-esc="total_perceptions" /></span>
            </div>
        </xpath>

    </t>
</templates>
