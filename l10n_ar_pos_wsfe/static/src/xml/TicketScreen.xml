<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('header-row')]/div[text()='Employee']" position="after">
            <div class="col">Origin</div>
        </xpath>
        <xpath expr="//div[hasclass('order-row')]/div[div[text()='Employee']]" position="after">
            <div class="col">
                <div t-if="env.isMobile">Origin</div>
                <div><t t-esc="getDocOrigin(order)" /></div>
            </div>
        </xpath>
    </t>

    <t t-name="OrderDetails" t-inherit="point_of_sale.OrderDetails" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('summary')]/div/div/div" position="after">
            <div t-if="props.order.get_total_perception()" class="subentry">
                Percepciones:
                <span class="value">
                    <t t-esc="props.order.get_total_perception_formatted()" />
                </span>
            </div>
        </xpath>
    </t>

</templates>
