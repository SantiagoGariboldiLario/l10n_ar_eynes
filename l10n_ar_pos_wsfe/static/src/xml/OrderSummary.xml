<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" inherit_id="point_of_sale_template" xml:space="preserve">

    <!-- POS v19: extend the new OrderDisplay summary to show perceptions -->
    <t t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="extension">
        <!-- Use hasclass() to avoid the template warning about @class filtering -->
        <xpath expr="//div[hasclass('order-summary')]/div[hasclass('fs-3')]" position="before">
            <div t-if="order.get_total_perception()" class="perception-line subtotal d-flex justify-content-between w-100 fs-6 text-muted">
                <span>Percepciones</span>
                <span class="perception-value" t-esc="formatCurrency(order.get_total_perception())"/>
            </div>
        </xpath>
    </t>

</templates>
