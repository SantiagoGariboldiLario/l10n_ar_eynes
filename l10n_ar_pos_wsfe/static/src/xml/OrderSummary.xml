<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="OrderWidget" t-inherit="point_of_sale.OrderWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('subentry')]" position="after">
            <div class="fs-6 text-muted subentry">
                Perceptions: <span class="value" t-esc="props.perception_amount" />
            </div>
        </xpath>
    </t>
</templates>
