<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="pos_config_view_form" model="ir.ui.view">
        <field name="name">pos.config.inherit.wsfe</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <field
                        string="Invoice Journals"
                        name="invoice_manual_journal_ids"
                        widget="many2many_tags"
                        context="{
                            'default_company_id': company_id,
                            'default_type': 'sale',
                            'default_fiscal_type': 'internal',
                            'no_journal_in_pos': True,
                        }"
                    />
                    <field
                        string="WSFE Invoice Journals"
                        name="invoice_journal_ids"
                        widget="many2many_tags"
                        context="{
                            'default_company_id': company_id,
                            'default_type': 'sale',
                            'default_fiscal_type': 'electronic',
                            'no_journal_in_pos': True,
                        }"
                    />
                    <field name="default_invoice_mode" />
                    <field name="block_invoice_offline" widget="many2many_tags" />
                </group>
            </xpath>

        </field>
    </record>

</odoo>
