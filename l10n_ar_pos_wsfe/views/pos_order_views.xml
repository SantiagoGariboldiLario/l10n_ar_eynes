<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_order_tree" model="ir.ui.view">
        <field name="name">pos.order.tree.l10n_eynes</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field
                    name="invoice_state"
                    widget="badge"
                    decoration-success="invoice_state == 'posted'"
                    decoration-info="invoice_state == 'draft'"
                    decoration-muted="invoice_state == 'cancel'"
                />
                <field name="invoice_name" />
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_filter" model="ir.ui.view">
        <field name="name">pos.order.filter.l10n_eynes</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter" />
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Draft Invoices"
                    name="draft_invoices"
                    domain="[('invoice_state', '=', 'draft')]"
                />
            </search>
        </field>
    </record>
</odoo>
