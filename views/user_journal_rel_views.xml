<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="user_journal_rel_view_form" model="ir.ui.view">
        <field name="name">user.journal.rel.view.form</field>
        <field name="model">user.journal.rel</field>
        <field name="arch" type="xml">
            <form string="User Journal Relation">
                <sheet>
                    <group>
                        <field name="user_id" />
                        <field name="journal_id" />
                        <field name="sequence" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="user_journal_rel_view_tree" model="ir.ui.view">
        <field name="name">user.journal.rel.view.tree</field>
        <field name="model">user.journal.rel</field>
        <field name="arch" type="xml">
            <tree string="User Journal Relation">
                <field name="user_id" />
                <field name="journal_id" />
                <field name="sequence" />
            </tree>
        </field>
    </record>

    <record id="journal_configuration_action" model="ir.actions.act_window">
        <field name="name">Action User Journal Configuration</field>
        <field name="res_model">user.journal.rel</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="journal_configuration_menu"
        name="Journals and Users Configuration"
        groups="account.group_account_manager"
        parent="account.account_management_menu"
        sequence="1"
    />

</odoo>
