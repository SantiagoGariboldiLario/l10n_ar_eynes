<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record model="ir.rule" id="wsaa_comp_rule">
        <field name="name">WSAA multi-company</field>
        <field name="model_id" ref="model_wsaa_config" />
        <field name="global" eval="True" />
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids)
        ]</field>
    </record>

