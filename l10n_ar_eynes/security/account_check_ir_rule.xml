<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

        <record model="ir.rule" id="account_check_comp_rule">
            <field name="name">Check multi-company</field>
            <field name="model_id" ref="model_account_check" />
            <field name="global" eval="True" />
            <field name="domain_force">[
                ('company_id', 'in', company_ids)
            ]</field>
        </record>

        <record model="ir.rule" id="account_check_config_comp_rule">
            <field name="name">Check Config multi-company</field>
            <field name="model_id" ref="model_account_check_config" />
            <field name="global" eval="True" />
            <field name="domain_force">[
                ('company_id', 'in', company_ids)
            ]</field>
        </record>

</odoo>
