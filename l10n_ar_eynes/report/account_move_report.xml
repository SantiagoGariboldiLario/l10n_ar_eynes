<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <data noupdate="1">
        <record id="paperformat_invoice" model="report.paperformat">
            <field name="name">Invoice Report</field>
            <field name="default" eval="False" />
            <field name="format">A4</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">55</field>
            <field name="margin_bottom">35</field>
            <field name="margin_right">5</field>
            <field name="margin_left">5</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">5</field>
            <field name="dpi">90</field>
        </record>
    </data>

    <record id="account_move_report" model="ir.actions.report">
        <field name="name">Factura QWEB</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ar_eynes.account_move_report_qweb</field>
        <field name="report_file">l10n_ar_eynes.account_move_report_qweb</field>
        <field name="paperformat_id" ref="l10n_ar_eynes.paperformat_invoice" />
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment">(object.state == 'posted') and ((object.name or
            'INV').replace('/','_')+'.pdf')</field>
        <field name="binding_model_id" ref="model_account_move" />
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]" />
    </record>

    <template id="weblearns_layout">
        <div class="header">
            <table class="company-table">
                <tr>
                    <td class="right">
                        <img
                            t-if="o.journal_id.image"
                            t-attf-src="data:image/png;base64,#{o.journal_id.image}"
                        />
                        <img t-else="" t-attf-src="data:image/png;base64,#{o.company_id.logo}" />
                        <br />
                        <p>
                            Razón social: <span t-esc="o.journal_id.warehouse_id.company_id.name" />
                            <br />
                            Domicillio: <span t-esc="o.journal_id.warehouse_id.partner_id.street" />
                            <span t-esc="o.journal_id.warehouse_id.partner_id.city" /> (
                            <span t-esc="o.journal_id.warehouse_id.partner_id.zip" />) -
                            <span t-esc="o.journal_id.warehouse_id.partner_id.state_id.name" /> -
                            <span t-esc="o.journal_id.warehouse_id.partner_id.country_id.name" />
                            <br />
                            Tel.: <span t-esc="o.journal_id.warehouse_id.partner_id.phone" />
                            <br />
                            Condición frente al IVA: <span
                                t-esc="o.journal_id.warehouse_id.partner_id.property_account_position_id.name"
                            />
                        </p>

                    </td>
                    <td class="center">
                        <div class="denomination-render">
                            <h1
                                t-if="denomination_name != 'NOT_DEFINED'"
                                style="font-size: 65px;"
                                t-esc="denomination_name"
                            />
                            <p style="font-size: 15px; position: relative; bottom: 10px;">
                            cod. <span t-esc="o.voucher_type_id.afip_code" /></p>

                        </div>
                    </td>
                    <td class="left">
                        <span t-if="denomination_name == 'E'" style="font-size: 20px;">
                            FACTURA DE EXPORTACION
                        </span>
                        <span t-elif="o.voucher_type_id.afip_code in ['203', '208']" style="font-size: 16px;">
                            NOTA DE CRÉDITO ELECTRÓNICA MiPyMEs (FCE)
                        </span>
                        <span t-elif="o.move_type in ['out_refund', 'in_refund']" style="font-size: 20px;">
                            NOTA DE CREDITO
                        </span>
                        <span t-elif="o.voucher_type_id.afip_code in ['202', '207']" style="font-size: 16px;">
                            NOTA DE DÉBITO ELECTRÓNICA MiPyMEs (FCE)
                        </span>
                        <span t-elif="o.is_debit_note" style="font-size: 20px;">
                            NOTA DE DEBITO
                        </span>
                        <span t-elif="o.voucher_type_id.afip_code in ['201', '206']" style="font-size: 16px;">
                            FACTURA DE CRÉDITO ELECTRÓNICA MiPyMEs (FCE)
                        </span>
                        <span t-elif="o.denomination in ['a', 'b', 'c']" style="font-size: 20px;">
                            FACTURA
                        </span>
                        <br />
                        <span
                            t-if="denomination_name == 'A' and o.voucher_type_id.afip_code in ['051', '052', '053']"
                            style="font-size: 16px;"
                        >
                            OPERACIÓN SUJETA A RETENCIÓN
                        </span>
                        <span t-elif="o.inform_cbu" style="font-size: 16px;">
                            PAGO EN CBU INFORMADA
                        </span>
                        <br />
                        <span>N° <span t-esc="denomination" /></span>
                        <br />
                        <span>
                            Fecha:
                            <t t-if="o.invoice_date">
                                <span t-esc="o.invoice_date.strftime('%d/%m/%Y')" />
                            </t>
                        </span>
                        <br />
                        <span>C.U.I.T: <span t-esc="o.company_id.vat" />
                        </span>
                        <br />
                        <t t-if="o.company_id.partner_id.nro_insc_iibb">
                            <br />
                            <span class="partner-info">Ing. Brutos: </span><span
                                t-esc="o.company_id.partner_id.nro_insc_iibb"
                            />
                            <br />
                        </t>
                        <span>Email: <span t-esc="o.journal_id.warehouse_id.partner_id.email" />
                        </span>
                        <br />
                        <span>
                            Inic. Activ.:
                            <t t-if="o.journal_id.activity_start_date">
                                <span t-esc="o.journal_id.activity_start_date.strftime('%d/%m/%Y')" />
                            </t>
                        </span>
                        <t t-if="denomination_name == 'E'">
                            <br />
                            <span>IVA EXENTO OPERACIÓN DE EXPORTACION</span>
                        </t>
                    </td>
                </tr>
            </table>
            <style>
                .company-table {
                    width: 100%;
                    border-collapse: collapse;
                    margin: 25px 0;
                    border-radius: 5px 5px 0 0;
                    overflow: hidden;
                    box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
                    background-color: #f3f3f3;
                    border: transparent;
                }

                .right{
                    font-weight: bold;
                    width: 44%;
                    padding-right: 10px;
                }

                .right p, .left span{
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                }

                .right img {
                    height: 80px;
                    object-fit: contain;
                }

                .center{
                    width: 20%;
                    vertical-align: top;
                    text-align: center;
                }

                .left {
                    width: 44%;
                    font-weight: bold;
                    padding-left: 30px;
                }

                .denomination-render{
                    display: block;
                    margin: 0 auto;
                    border: 2px solid #000;
                    height: 100px;
                    width: 100px;
                    font-size: 40px;
                }
            </style>
        </div>
        <t t-raw="0" />
        <div class="footer last-page">
            <!--Footer afip-->
            <div class="row afip-footer">
                <div class="column-afip-1">
                    <img t-attf-src="data:image/png;base64,#{o._generate_qr()}" alt="QR" />
                </div>
                <div class="column-afip-2">
                    <img t-attf-src="data:image/png;base64,#{o.get_afip_logo()}" alt="Logo Afip" />
                    <br />
                    <p><strong>Comprobante Autorizado</strong><br
                        />Esta Administracion Federal no se responsabiliza por los datos ingresados en el detalle de la operacion</p>
                </div>
                <div class="column-afip-3">
                    <div style="height: 20px;" />
                    <table class="cae-table">
                        <tr>
                            <td>
                                Factura Electrónica / CAE:
                            </td>
                        </tr>
                        <tr>
                            <td style="background: #bcc0c4;">
                                <t t-if="o.cae">
                                    <span t-esc="o.cae" />
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td> F. Vto.: <t t-if="o.cae_due_date">
                                    <span t-esc="o.cae_due_date.strftime('%d-%m-%Y')" />
                                </t>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <style>
                /*Footer afip*/
                .afip-footer {
                    height: 155px;
                }

                .column-afip-1 {
                    width: 15%;
                }

                .column-afip-1 img {
                    height: 100px;
                    width: 100px;
                    margin-right: 10px;
                }

                .column-afip-2 {
                    width: 50%;
                }

                .column-afip-3 {
                    width: 35%;
                }

                .column-afip-2 img {
                    height: 35px;
                }

                .column-afip-2 p {
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                }

                .cae-table {
                    font-size: 18px;
                    text-align: center;
                    margin: 0 auto;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                    border: transparent;
                }

                .row{
                    width: 100%;
                    padding-top: 20px;
                    padding-botton: 0px;
                    display: -webkit-box;
                    -webkit-box-orient: horizontal;
                    -webkit-box-direction: normal;
                    clear: both;
                }

                .column,{
                    -webkit-box-flex: 1;
                }

                .column-1{
                    font-weight: bold;
                    text-align: center;
                    width: 40%;
                }

                .column-2 {
                    width: 60%;
                }
            </style>
        </div>
    </template>

    <template id="account_move_report_qweb">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="denomination" t-value="o.internal_number" />
                <t t-if="o.denomination">
                    <t t-set="denomination_name" t-value="o.denomination.upper()" />
                </t>
                <t t-else="">
                    <t t-set="denomination_name" t-value="''" />
                </t>
                <t t-set="iva_amount" t-value="0.0" />
                <t t-set="percepciones_amount" t-value="0.0" />
                <t t-set="retenciones_amount" t-value="0.0" />

                <t t-foreach="o.invoice_line_ids" t-as="product_line">

                    <t
                        t-if="o.move_type in ['out_invoice', 'out_refund']"
                        t-foreach="product_line.product_id.taxes_id"
                        t-as="taxe"
                    >
                    </t>
                        <div t-if="taxe">
                            <t t-if="'IVA' in taxe.name">
                                <t t-set="iva_amount" t-value="taxe.amount" />
                            </t>
                            <t t-elif="'Percepciones' in taxe.name">
                                <t t-set="percepciones_amount" t-value="taxe.amount" />
                            </t>
                            <t t-elif="'Retenciones' in taxe.name">
                                <t t-set="retenciones_amount" t-value="taxe.amount" />
                            </t>
                        </div>

                    <t
                        t-elif="o.move_type in ['in_invoice', 'in_refund']"
                        t-foreach="product_line.product_id.supplier_taxes_id"
                        t-as="taxe"
                    >
                    </t>
                        <div t-if="taxe">
                            <t t-if="'IVA' in taxe.name">
                                <t t-set="iva_amount" t-value="taxe.amount" />
                            </t>
                            <t t-elif="'Percepciones' in taxe.name">
                                <t t-set="percepciones_amount" t-value="taxe.amount" />
                            </t>
                            <t t-elif="'Retenciones' in taxe.name">
                                <t t-set="retenciones_amount" t-value="taxe.amount" />
                            </t>
                        </div>
                </t>

                <div
                    class="article o_report_layout_standard"
                    t-att-data-oe-model="o and o._name"
                    t-att-data-oe-id="o and o.id"
                >
                    <t t-call="l10n_ar_eynes.weblearns_layout">
                        <div class="page">
                            <!--Partner-->
                            <table class="partner-table">
                                <tr>
                                    <td width="60%">
                                        <span class="partner-info">Cliente: </span><span
                                            t-esc="o.partner_id.name"
                                        />
                                        <br />
                                        <span class="partner-info">Domicilio: </span><span
                                            t-esc="o.partner_id.street"
                                        />
                                        <br />
                                        <span class="partner-info">Condicion IVA: </span>
                                        <t t-if="o.partner_id.property_account_position_id.name == 'RI'">
                                            <span>RESPONSABLE INSCRIPTO</span>
                                        </t>
                                        <t t-elif="o.partner_id.property_account_position_id.name == 'RIM'">
                                            <span>RESPONSABLE INSCRIPTO "M"</span>
                                        </t>
                                        <t t-else="">
                                            <span t-esc="o.partner_id.property_account_position_id.name" />
                                        </t>
                                        <br />
                                        <t t-if="denomination_name == 'E'">
                                            <span class="partner-info">CUIT Pais: </span><span
                                                t-if="o.partner_id.dst_cuit_id.code"
                                                t-esc="int(o.partner_id.dst_cuit_id.code)"
                                            />
                                            <br />
                                            <span class="partner-info">ID Impositivo: </span>
                                        </t>
                                        <t t-else="">
                                            <span class="partner-info">CUIT: </span><span
                                                t-esc="o.partner_id.vat"
                                            />
                                            <t t-if="o.partner_id.nro_insc_iibb">
                                                <br />
                                                <span class="partner-info">Ing. Brutos: </span><span
                                                    t-esc="o.partner_id.nro_insc_iibb"
                                                />
                                            </t>
                                        </t>
                                        <br />
                                        <t t-if="o.associated_inv_ids">
                                            <br />
                                            <span class="partner-info">Comprobantes asociados: </span>
                                            <span>
                                                <t t-esc="', '.join(o.associated_inv_ids.mapped('name'))" />
                                            </span>
                                        </t>
                                    </td>
                                    <td width="40%">
                                        <span class="partner-info">Tel.: </span><span
                                            t-esc="o.partner_id.phone"
                                        />
                                        <br />
                                        <span class="partner-info">Condicion Venta: </span><span
                                            t-esc="o.invoice_payment_term_id.name"
                                        />
                                        <br />
                                        <span class="partner-info">F. Venc: </span>
                                        <t t-if="o.invoice_date_due">
                                            <span t-esc="o.invoice_date_due.strftime('%d/%m/%Y')" />
                                        </t>
                                        <t t-if="o.invoice_origin">
                                            <br />
                                            <span class="partner-info">Orden de venta: </span><span
                                                t-esc="o.get_sale_orders_name()"
                                            />
                                        </t>
                                    </td>
                                </tr>
                            </table>
                            <!--Table if is a export invoice-->
                            <div t-if="o.denomination == 'e'">
                                <table class="export-invoice-table">
                                    <tr>
                                        <td width="60%">
                                            <span class="partner-info">Divisa: </span><span
                                                t-esc="o.currency_id.name"
                                            />
                                            <br />
                                            <span class="partner-info">Destino del comprobante: </span><span
                                                t-esc="o.dst_country_id.name"
                                            />
                                        </td>
                                        <td width="40%">
                                            <span class="partner-info">Forma de pago: </span>
                                            <br />
                                            <span class="partner-info">Incoterms: </span><span
                                                t-esc="o.invoice_incoterm_id.name"
                                            />
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <!--Products-->
                            <table class="product-table">
                                    <thead>
                                        <tr>
                                            <th class="product-description-column" width="50%">
                                                Descripción
                                            </th>
                                            <th>
                                                Cantidad
                                            </th>
                                            <th>
                                                Precio Unit.
                                            </th>
                                            <div t-if="o.denomination in ['a', 'b'] or o.is_debit_note">
                                                <th>
                                                    % Desc.
                                                </th>
                                                <th t-if="o.denomination != 'b'">
                                                    Alic. IVA
                                                </th>
                                            </div>
                                            <th>
                                                Total
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="o.invoice_line_ids" t-as="line">
                                            <t t-set="iva_tax_amount" t-value="" />
                                        <t
                                            t-if="line.display_type == 'product'"
                                            name="account_invoice_line_accountable"
                                        >
                                            <td class="product-description-column">
                                                <span t-esc="line.name" />
                                            </td>
                                            <td>
                                                <span t-esc="line.quantity" />
                                            </td>
                                            <td>
                                                <t t-set="iva" t-value="line.get_iva_tax()" />
                                                <span
                                                    t-if="iva and iva.price_include"
                                                    t-esc="line.price_unit_to_PDF() / (1 + (iva.amount/100))"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                                />
                                                <span
                                                    t-else=""
                                                    t-esc="line.price_unit_to_PDF()"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                                />
                                            </td>
                                            <div t-if="o.denomination in ['a', 'b'] or o.is_debit_note">
                                                <t
                                                    t-set="sub_total_per_product"
                                                    t-value="line.quantity * line.price_unit"
                                                />
                                                <t t-foreach="line.tax_ids" t-as="tax">
                                                    <t t-if="'IVA' in tax.name">
                                                        <t t-set="iva_tax_amount" t-value="tax.amount" />
                                                    </t>
                                                </t>
                                                <td>
                                                    <span t-esc="line.discount" />%
                                                </td>
                                                <div t-if="o.denomination != 'b'">
                                                    <td t-if="iva_tax_amount">
                                                        <span t-if="iva_tax_amount" t-esc="iva_tax_amount" />%
                                                    </td>
                                                    <td t-else="">
                                                        <span> </span>
                                                    </td>
                                                </div>
                                            </div>
                                            <td>
                                                <span
                                                    t-if="iva_tax_amount and (o.denomination == 'a' or o.is_debit_note) and iva and not iva.price_include"
                                                    t-esc="(sub_total_per_product * (1 - line.discount/100)) * (1+ iva_tax_amount/100)"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                                />
                                                <span
                                                    t-elif="iva_tax_amount and (o.denomination == 'a' or o.is_debit_note) and iva and iva.price_include"
                                                    t-esc="(sub_total_per_product * (1 - line.discount/100)) / (1+ iva.amount/100) * (1+ iva.amount/100)"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                                />
                                                <span
                                                    t-elif="iva and iva.price_include"
                                                    t-esc="line.price_unit"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                                />
                                                <span
                                                    t-else=""
                                                    t-esc="line.price_subtotal_to_PDF()"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                                />
                                            </td>
                                            </t>
                                            <t t-if="line.display_type == 'line_section'">
                                                <td colspan="99" style="text-align: left">
                                                    <span
                                                    t-field="line.name"
                                                    t-options="{'widget': 'text'}"
                                                />
                                                </td>
                                                <t t-set="current_section" t-value="line" />
                                                <t t-set="current_subtotal" t-value="0" />
                                            </t>
                                            <t t-if="line.display_type == 'line_note'">
                                                <td colspan="99" style="text-align: left">
                                                    <span
                                                    t-field="line.name"
                                                    t-options="{'widget': 'text'}"
                                                />
                                                </td>
                                            </t>
                                        </tr>
                                    </tbody>
                            </table>
                            <!--Taxes-->
                            <table
                                class="taxes-table fix-position"
                                t-if="o.denomination not in ['b', 'c', 'e'] and o.line_ids.filtered('tax_line_id')"
                                style="width: 30%"
                            >
                                <thead>
                                    <tr>
                                        <th>
                                            Descripción
                                        </th>
                                        <th>
                                            Importe
                                        </th>
                                    </tr>
                                </thead>
                                <tbofy>
                                        <tr t-foreach="o.line_ids.filtered('tax_line_id')" t-as="line_tax">
                                            <td>
                                                <span t-esc="line_tax.tax_line_id.name" />
                                            </td>
                                            <td>
                                                <span
                                                t-if="o.is_multi_currency"
                                                t-esc="abs(line_tax.balance)/o.currency_rate"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                            />
                                                <span
                                                t-else=""
                                                t-esc="abs(line_tax.balance)"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                            />
                                            </td>
                                        </tr>
                                </tbofy>
                            </table>
                            <!--Observations/Total-->
                            <div>
                                <table class="total-table fix-position" style="width: 40%">
                                    <thead>
                                        <tr>
                                            <td t-if="o.denomination != 'e'">
                                                Subtotal
                                            </td>
                                            <td t-else="">
                                                Tipo de cambio
                                            </td>
                                            <td t-if="o.denomination == 'b'">
                                                Otros imp.
                                            </td>
                                            <td t-elif="o.denomination != 'e'">
                                                Impuestos
                                            </td>
                                            <td t-else="">
                                                Divisa
                                            </td>
                                            <td>
                                                Total
                                            </td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="o.denomination == 'b'">
                                            <td>
                                                <span
                                                    t-esc="o.amount_total - (percepciones_amount + retenciones_amount)"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                />
                                            </td>
                                            <td>
                                                <span
                                                    t-esc="percepciones_amount + retenciones_amount"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                />
                                            </td>
                                            <td>
                                                <span
                                                    t-esc="o.amount_total"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                />
                                            </td>
                                        </tr>
                                        <tr t-elif="o.denomination != 'e'">
                                            <td>
                                                <span
                                                    t-esc="o.price_subtotal_to_PDF()"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                />
                                            </td>
                                            <td t-if="o.denomination != 'b'">
                                                <span
                                                    t-esc="o.amount_tax"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                />
                                            </td>
                                            <td>
                                                <span
                                                    t-esc="o.amount_total"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                />
                                            </td>
                                        </tr>
                                        <tr t-else="">
                                            <td>
                                                $ <span t-esc="o.currency_rate" />
                                            </td>
                                            <td t-if="o.denomination != 'b'">
                                                <span t-esc="o.currency_id.name" />
                                            </td>
                                            <td>
                                                <span
                                                    t-esc="o.amount_total"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <t t-if="o.denomination == 'b'">
                                    <table class="total-table total-table-cf fix-position" style="width: 60%">
                                        <thead>
                                            <th>
                                                <td>
                                                    Régimen de Transparencia Fiscal al Consumidor Ley 27.743
                                                </td>
