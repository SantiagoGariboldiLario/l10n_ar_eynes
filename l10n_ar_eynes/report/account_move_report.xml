<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="paperformat_invoice" model="report.paperformat">
        <field name="name">Invoice Report</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">55</field>
        <field name="margin_bottom">45</field>
        <field name="margin_right">5</field>
        <field name="margin_left">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">50</field>
        <field name="dpi">90</field>
    </record>

    <record id="account_move_report" model="ir.actions.report">
        <field name="name">Factura QWEB</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ar_eynes.account_move_report_qweb</field>
        <field name="report_file">l10n_ar_eynes.account_move_report_qweb</field>
        <field name="paperformat_id" ref="l10n_ar_eynes.paperformat_invoice" />
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment">(object.state == 'posted') and ((object.name or
            'INV').replace('/','_')+'.pdf')</field>
        <field name="binding_model_id" ref="model_account_move" />
        <field name="binding_type">report</field>
        <field
            name="groups_id"
            eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"
        />
    </record>

    <template id="weblearns_layout">
        <div class="header">
            <table class="company-table">
                <tr>
                    <td class="right">
                        <img
                            t-if="o.journal_id.image"
                            t-attf-src="data:image/png;base64,#{o.journal_id.image}"
                        />
                        <img
                            t-else=""
                            t-attf-src="data:image/png;base64,#{o.company_id.logo}"
                        />
                        <br/>
                        <h3 t-esc="o.company_id.name" />
                        <p>
                            <span
                                t-esc="o.journal_id.warehouse_id.partner_id.street" />
                                <span
                                t-esc="o.journal_id.warehouse_id.partner_id.city" /> (<span
                                t-esc="o.journal_id.warehouse_id.partner_id.zip"
                            />) - <span
                                t-esc="o.journal_id.warehouse_id.partner_id.state_id.name"
                            /> - <span
                                t-esc="o.journal_id.warehouse_id.partner_id.country_id.name"
                            />
                                <br />
                        Tel.: <span t-esc="o.journal_id.warehouse_id.partner_id.phone" />
                        </p>

                    </td>
                    <td class="center">
                        <div class="denomination-render">
                            <h1
                                t-if="denomination_name != 'NOT_DEFINED'"
                                style="font-size: 65px;"
                                t-esc="denomination_name"
                            />
                            <p
                            style="font-size: 15px; position: relative; bottom: 10px;">
                            cod. <span t-esc="o.voucher_type_id.afip_code" /></p>

                        </div>
                    </td>
                    <td class="left">
                        <span>N° <span t-esc="denomination" /></span>
                        <br/>
                        <span>
                            Fecha:
                            <t t-if="o.invoice_date">
                                <span t-esc="o.invoice_date.strftime('%d/%m/%Y')" />
                            </t>
                        </span>
                        <br />
                        <span>C.U.I.T: <span t-esc="o.company_id.vat" />
                        </span>
                        <br/>
                        <span>Ing. Brutos: <span t-esc="o.company_id.vat" />
                        </span>
                        <br/>
                        <span>IVA Responsable Inscripto</span>
                        <br/>
                        <span>Email: <span t-esc="o.journal_id.warehouse_id.partner_id.email" />
                        </span>
                        <br/>
                        <span>
                            Inic. Activ.:
                            <t t-if="o.journal_id.activity_start_date">
                                <span
                                    t-esc="o.journal_id.activity_start_date.strftime('%d/%m/%Y')"
                                />
                            </t>
                        </span>
                        <br />
                    </td>
                </tr>
            </table>
            <style>
                .company-table {
                    width: 100%;
                    border-collapse: collapse;
                    margin: 25px 0;
                    border-radius: 5px 5px 0 0;
                    overflow: hidden;
                    box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
                    background-color: #f3f3f3;
                }

                .right{
                    font-weight: bold;
                    width: 40%;
                }

                .right p, .left span{
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                }

                .right img {
                    height: 80px;
                    width: 70%;
                }

                .center{
                    width: 20%;
                    vertical-align: top;
                    text-align: center;
                }

                .left {
                    width: 40%;
                    font-weight: bold;
                }
                
                .denomination-render{ 
                    display: block;
                    margin: 0 auto;
                    border: 2px solid #000;
                    height: 100px;
                    width: 100px;
                    font-size: 40px;
                }
            </style>
        </div>
        <t t-raw="0"/>
        <div class="footer last-page">
            <!--Footer afip-->
            <div class="row afip-footer">
                <div class="column-afip-1">
                    <img
                        t-attf-src="data:image/png;base64,#{o._generate_qr()}"
                        alt="QR"
                    />
                </div>
                <div class="column-afip-2">
                    <img
                        t-attf-src="data:image/png;base64,#{o.get_afip_logo()}"
                        alt="Logo Afip"
                    />
                    <br/>
                    <p><strong>Comprobante Autorizado</strong><br/>Esta Administracion Federal no se responsabiliza por los datos ingresados en el detalle de la operacion</p>
                </div>
                <div class="column-afip-3">
                    <table class="cae-table">
                        <tr>
                            <td>
                                Factura Electrónica / CAE:
                            </td>
                        </tr>
                        <tr>
                            <td style="background: #bcc0c4;">
                                <t t-if="o.cae">
                                    <span t-esc="o.cae" />
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td> F. Vto.: <t t-if="o.cae_due_date">
                                    <span
                                        t-esc="o.cae_due_date.strftime('%d-%m-%Y')" />
                                </t>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <style>
                /*Footer afip*/
                .afip-footer {
                    height: 155px;
                }

                .column-afip-1 {
                    width: 20%;
                }

                .column-afip-1 img {
                    height: 150px;
                    width: 150px;
                    margin-right: 20px;
                }

                .column-afip-2 {
                    width: 50%;
                }

                .column-afip-3 {
                    width: 30%;
                }

                .column-afip-2 img {
                    height: 60px;
                    width: 200px;
                }

                .cae-table {
                    font-size: 18px;
                    text-align: center;
                    margin: 0 auto;
                }
                .row{
                    width: 100%;
                    padding-top: 20px;
                    padding-botton: 0px;
                    display: -webkit-box;
                    -webkit-box-orient: horizontal;
                    -webkit-box-direction: normal;
                    clear: both;
                }
                        
                .column,{
                    -webkit-box-flex: 1;
                }

                .column-1{
                    font-weight: bold;
                    text-align: center;
                    width: 40%;
                }

                .column-2 {
                    width: 60%;
                }
            </style>
        </div>
    </template>

    <template id="account_move_report_qweb">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="denomination" t-value="o.internal_number" />
                <t t-if="o.denomination">
                    <t t-set="denomination_name" t-value="o.denomination.upper()" />
                </t>
                <t t-else="">
                    <t t-set="denomination_name" t-value="''" />
                </t>
                <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
                    <div t-call="l10n_ar_eynes.weblearns_layout">
                        <div class="page">
                            <!--Partner-->
                            <table class="partner-table">
                                    <tr>
                                        <td width="60%">
                                            <span class="partner-info">Cliente: </span><span t-esc="o.partner_id.name"/>
                                            <br/>
                                            <span class="partner-info">Domicilio: </span><span t-esc="o.partner_id.street"/>
                                            <br/>
                                            <span class="partner-info">Condicion IVA: </span>
                                            <t t-if="o.partner_id.property_account_position_id.name == 'RI'">
                                                <span>RESPONSABLE INSCRIPTO</span>
                                            </t>
                                            <t t-elif="o.partner_id.property_account_position_id.name == 'RIM'">
                                                <span>RESPONSABLE INSCRIPTO "M"</span>
                                            </t>
                                            <t t-else="">
                                                <span t-esc="o.partner_id.property_account_position_id.name" />
                                            </t>
                                            <br/>
                                            <span class="partner-info">Condicion Venta: </span><span t-esc="o.invoice_payment_term_id.name" />
                                        </td>
                                        <td width="40%">
                                            <span class="partner-info">Tel.: </span><span t-esc="o.partner_id.phone"/>
                                            <br/>
                                            <span class="partner-info">CUIT: </span><span t-esc="o.partner_id.vat"/>
                                            <br/>
                                            <span class="partner-info">IIBB: </span><span t-esc="o.partner_id.vat"/>
                                            <br/>
                                            <span class="partner-info">F. Venc: </span>
                                            <t t-if="o.invoice_date_due">
                                                <span t-esc="o.invoice_date_due.strftime('%d/%m/%Y')" />
                                            </t>
                                        </td>
                                    </tr>
                            </table>
                            <!--Products-->
                            <table class="product-table">
                                    <thead>
                                        <tr>
                                            <th>
                                                Descripción
                                            </th>
                                            <th>
                                                Cantidad
                                            </th>
                                            <th>
                                                Precio Unit.
                                            </th>
                                            <th>
                                                Total
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="o.invoice_line_ids" t-as="line">
                                            <td>
                                                <span t-esc="line.name" />
                                            </td>
                                            <td>
                                                <span t-esc="line.quantity" />
                                            </td>
                                            <td>
                                                <span
                                                    t-esc="line.price_unit_to_PDF()"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                                />
                                            </td>
                                            <td>
                                                <span
                                                    t-esc="line.price_subtotal_to_PDF()"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                                />
                                            </td>
                                        </tr>
                                    </tbody>
                            </table>
                            <!--Taxes-->
                            <table class="taxes-table" t-if="o.denomination != 'b' and o.denomination != 'c'" style="width: 50%">
                                <thead>
                                    <tr>
                                        <th>
                                            Descripción
                                        </th>
                                        <th>
                                            Importe
                                        </th>
                                    </tr>
                                </thead>
                                <tbofy>
                                        <tr t-foreach="o.line_ids.filtered('tax_line_id')" t-as="line_tax">
                                            <td>
                                                <span t-esc="line_tax.tax_line_id.name" />
                                            </td>
                                            <td>
                                                <span
                                                    t-esc="abs(line_tax.balance)"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                />
                                            </td>
                                        </tr>
                                </tbofy>
                            </table>
                            <!--Observations/Total-->
                            <div class="row total">
                                <div class="column column-1">
                                    <!-- <h3>Observaciones:</h3>
                                    <br/> -->
                                </div>
                                <div class="column column-2">
                                    <table class="total-table">
                                        <thead>
                                            <tr>
                                                <td>
                                                    Subtotal
                                                </td>
                                                <td t-if="o.denomination != 'b'">
                                                    Impuestos
                                                </td>
                                                <td>
                                                    Total
                                                </td>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <span
                                                        t-esc="o.price_subtotal_to_PDF()"
                                                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                    />
                                                </td>
                                                <td t-if="o.denomination != 'b'">
                                                    <span
                                                        t-esc="o.amount_tax"
                                                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                    />
                                                </td>
                                                <td>
                                                    <span
                                                        t-esc="o.amount_total"
                                                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                    />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <!--Masagge-->
                            <t t-if="o.move_type == 'out_invoice' and denomination_name == 'A' and o.partner_id.property_account_position_id.name == 'Responsable Monotributo'">
                                <div class="message">
                                    <p style="text-align: center">
                                        El crédito fiscal discriminado en el presente comprobante,
                                        sólo podrá ser computado a efectos del Régimen de
                                        Sostenimiento e Inclusión Fiscal para Pequeños
                                        Contribuyentes de la Ley Nº 27.618
                                    </p>
                                </div>
                            </t>
                            <!--Multicurrency-->
                            <div t-if="o.is_multi_currency">
                                <table>
                                    <tr>
                                        <td>Moneda: <span t-esc="o.currency_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td>Tasa de cambio: <span t-esc="o.currency_rate"/></td>
                                    </tr>
                                </table>
                                <p>El total de este comprobante expresado en la moneda de curso legal - Pesos Argentinos - asciende a $  <span t-esc="o.amount_total_cur"/></p>                
                            </div>
                        </div>
                    </div>
                    <style>
                        /*Taxes table*/
                        .taxes-table {
                            float: right;
                        }
                                
                        /*Total Table*/
                        .row{
                            width: 100%;
                            padding-top: 20px;
                            padding-botton: 0px;
                            display: -webkit-box;
                            -webkit-box-orient: horizontal;
                            -webkit-box-direction: normal;
                            clear: both;
                        }

                        .product-table,
                        .taxes-table,
                        .total {
                            font-family: Arial, Helvetica, sans-serif;
                            font-size: 13px;
                        }

                                
                        .column,{
                            -webkit-box-flex: 1;
                        }

                        .column-1{
                            font-weight: bold;
                            text-align: center;
                            width: 40%;
                        }

                        .column-2 {
                            width: 60%;
                        }  
                        /*Partner table - Product table*/

                        .partner-info{
                            font-weight: bold;
                        }

                        .product-table, 
                        .partner-table,
                        .total-table,
                        .taxes-table,
                        .message {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 1.2em;
                            margin: 25px 0;
                            border-radius: 5px 5px 5px 5px;
                            overflow: hidden;
                            box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
                            margin-bottom: 0px;
                            margin-top: 20px;
                        }

                        .product-table thead tr,
                        .total-table thead tr,
                        .taxes-table thead tr {
                            background-color: rgb(202, 215, 226);
                            color: black;
                            text-align: left;
                            font-weight: bold;
                            font-family: Arial, Helvetica, sans-serif;
                            font-size: 13px;
                        }

                        .partner-table th,
                        .partner-table td {
                            padding: 2px 2px;
                            font-family: Arial, Helvetica, sans-serif;
                            font-size: 14px;
                        }

                        .product-table th,
                        .product-table td,
                        .total-table th,
                        .total-table td,
                        .taxes-table th,
                        .taxes-table td {
                            padding: 2px 2px;
                            font-family: Arial, Helvetica, sans-serif;
                            font-size: 13px;
                        }

                        .product-table tbody tr {
                            border-bottom: 1px solid rgb(202, 215, 226);
                        }

                        .product-table tbody tr:nth-of-type(even), 
                        .partner-table,
                        .taxes-table tbody tr:nth-of-type(even),
                        .message {
                            background-color: #f3f3f3;
                        }

                        .product-table tbody tr:last-of-type {
                            border-bottom: 2px solid rgb(202, 215, 226);
                        }
                    </style>
                </div>
            </t>
        </t>
    </template>
</odoo>