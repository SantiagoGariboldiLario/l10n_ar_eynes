    <!-- Actividades para Percepcion de II BB -->
    <record
        forcecreate="0"
        id="perception_activity_alic_general"
        model="perception.activity"
    >
        <field name="name">Alicuota General</field>
        <field name="type">gross_income</field>
    </record>

    <record
        forcecreate="0"
        id="perception_activity_fab_comestibles"
        model="perception.activity"
    >
        <field
            name="name"
