<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="customer_payment_order_seq" model="ir.sequence">
        <field name="name">Customer Payment Order Sequence</field>
        <field name="code">customer.payment.order</field>
        <field name="active">TRUE</field>
        <field name="prefix">OC-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False" />
    </record>

    <record id="supplier_payment_order_seq" model="ir.sequence">
        <field name="name">Supplier Payment Order Sequence</field>
        <field name="code">supplier.payment.order</field>
        <field name="active">TRUE</field>
        <field name="prefix">OP-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False" />
    </record>

    <record id="seq_picking_out_ar" model="ir.sequence">
        <field name="name">Picking OUT AR</field>
        <field name="code">stock.picking.out.ar</field>
        <field name="prefix">REMITO 0003-</field>
        <field name="padding">8</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
