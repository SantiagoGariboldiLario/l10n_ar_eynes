<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.module.category" id="module_category_accounting_treasury">
        <field name="name">Treasury</field>
        <field name="sequence">5</field>
    </record>

    <record id="group_treasury_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="l10n_ar_eynes.module_category_accounting_treasury" />
    </record>

    <record id="group_treasury_responsible" model="res.groups">
        <field name="name">Responsible</field>
        <field name="category_id" ref="l10n_ar_eynes.module_category_accounting_treasury" />
        <field name="implied_ids" eval="[(6, 0, [ref('group_treasury_user')])]" />
    </record>

    <record id="group_arca_request_administrator" model="res.groups">
        <field name="name">ARCA Request Administrator</field>
        <field name="category_id" ref="base.module_category_usability" />
    </record>

</odoo>
