<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="module_category_treasury" model="ir.module.category">
        <field name="name">Tesoreria</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_privilege_treasury" model="res.groups.privilege">
        <field name="name">Tesoreria</field>
        <field name="category_id" ref="l10n_ar_eynes.module_category_treasury" />
    </record>

    <record id="group_treasury_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="l10n_ar_eynes.group_privilege_treasury" />
    </record>

    <record id="group_treasury_responsible" model="res.groups">
        <field name="name">Responsible</field>
        <field name="implied_ids" eval="[(6, 0, [ref('group_treasury_user')])]" />
        <field name="privilege_id" ref="l10n_ar_eynes.group_privilege_treasury" />
    </record>

    <record id="group_arca_request_administrator" model="res.groups">
        <field name="name">ARCA Request Administrator</field>
    </record>

</odoo>
