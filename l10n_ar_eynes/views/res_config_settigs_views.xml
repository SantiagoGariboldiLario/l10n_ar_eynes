<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="inside">
                <setting
                    id="apportionable_vat"
                    string="Apportionable VAT"
                    help="Enable custom fields to manage Apportionable VAT declaration"
                >
                    <field name="apportionable_vat" />
                </setting>
                <h2>ARBA Account Data</h2>
                <group>
                    <group>
                        <field name="cot_user" class="oe_inline" />
                    </group>
                    <group>
                        <field name="cot_pass" class="oe_inline" />
                    </group>
                    <group>
                        <field name="cot_url" class="oe_inline" />
                    </group>
                    <group>
                        <field name="group_check_cot" class="oe_inline" />
                    </group>
                </group>
                <!-- <setting id="afip_case_text" string="AFIP Text Case"
                    help="Default text case for data fetched from PADRON.">
                    <field name="case_convertion" class="oe_inline"/>
                </setting> -->
            </xpath>
            <xpath expr="//block[@name='contacts_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="partner_required_fields">
                    <div class="o_setting_left_pane">
                        <field name="special_partner_required_fields" />
                    </div>

                    <div class="o_setting_right_pane">
                        <label string="Required Fields for Partners" for="special_partner_required_fields" />
                        <div class="text-muted">
                            Set Document Type, NIF, and Fiscal Position to be required on partners
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
