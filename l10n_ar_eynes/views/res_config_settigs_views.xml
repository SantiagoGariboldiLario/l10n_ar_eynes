<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="inside">
                <h2>ARBA Account Data</h2>
                <group>
                    <group>
                        <field name="cot_user" class="oe_inline" />
                    </group>
                    <group>
                        <field name="cot_pass" class="oe_inline" />
                    </group>
                    <group>
                        <field name="cot_url" class="oe_inline" />
                    </group>
                    <group>
                        <field name="group_check_cot" class="oe_inline" />
                    </group>
                </group>
                <div id="afip_case_text">
                    <div class='row mt16 o_settings_container afip_case_text' name="afip_case_text">
                        <div class="col-12 col-lg-6 o_setting_box" id="afip_case_text">

                            <div class='o_setting_right_pane'>
                                <div class="o_form_label">
                                    AFIP Text Case
                                </div>
                                <div class="text-muted">
                                    Select the defaul text case to use when fetch values from PADRON
                                </div>
                                <div class="o_setting_left_pane">
                                    <field name="case_convertion" class="oe_inline" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
