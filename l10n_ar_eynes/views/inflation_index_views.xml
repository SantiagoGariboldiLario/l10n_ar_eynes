<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="inflation_index_view_form" model="ir.ui.view">
        <field name="name">inflation.index.view.form</field>
        <field name="model">inflation.index</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Inflation Indexes">
                <sheet>
                    <group>
                        <group>
                            <field name="coefficient" />
                        </group>
                        <group>
                            <field name="date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="inflation_index_view_tree" model="ir.ui.view">
        <field name="name">inflation.index.view.tree</field>
        <field name="model">inflation.index</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="coefficient" />
                <field name="date" widget='month_year_format' />
            </tree>
        </field>
    </record>

    <record id="inflation_index_action" model="ir.actions.act_window">
        <field name="name">Inflation Indexes</field>
        <field name="res_model">inflation.index</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
