<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- * Add button and AFIP tables to WSFE form view * -->
    <record id="view_wsfe_config_form" model="ir.ui.view">
        <field name="name">wsfe.config.form</field>
        <field name="model">wsfe.config</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="l10n_ar_eynes.view_ws_config_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='principal']" position="after">
                <group name="extra">
                    <button
                        name="get_afip_tables"
                        class="oe_highlight"
                        string="Get AFIP tables"
                        type="object"
                    />
                </group>

                <notebook colspan="4">
                    <page string="Points Of Sale">
                        <field name="point_of_sale_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="pos_id" domain="[('wsfe_config_id', '=', parent.id)]" />
                                <field name="code" readonly="True" />
                                <field name="name" readonly="True" />
                                <field name="to_date" readonly="True" />
                                <field name="blocked" readonly="True" />
                                <field
                                    name="journal_id"
                                    domain="[('type', '=', 'sale'), ('company_id', '=', parent.company_id)]"
                                />
                                <field name="priority" />
                                <field name="from_afip" readonly="True" />
                            </tree>
                        </field>
                    </page>

                    <page string="VAT Taxes">
                        <field
                            name="vat_tax_ids"
                            nolabel="1"
                            options="{'no_create_edit': True, 'no_quick_create': True}"
                        >
                            <tree editable="bottom">
                                <field name="code" readonly="True" />
                                <field name="name" readonly="True" />
                                <field name="from_date" readonly="True" />
                                <field name="to_date" readonly="True" />
                                <field name="tax_id" />
                                <field name="from_afip" readonly="True" />
                            </tree>
                        </field>
                        <field
                            name="exempt_operations_tax_ids"
                            context="{'default_exempt_operations': True}"
                            nolabel="1"
                        >
                            <tree editable="bottom">
                                <field name="name" />
                                <field name="tax_id" />
                                <field name="exempt_operations" invisible="1" />
                            </tree>
                        </field>
                    </page>

                    <page string="Optionals">
                        <field name="optional_ids" nolabel="1">
                            <tree readonly="True">
                                <field name="code" />
                                <field name="name" />
                                <field name="from_date" />
                                <field name="to_date" />
                                <field name="from_afip" />
                            </tree>
                        </field>
                    </page>

                    <page string="Currencies">
                        <field
                            name="currency_ids"
                            nolabel="1"
                            options="{'no_create_edit': True, 'no_quick_create': True}"
                        >
                            <tree editable="bottom">
                                <field name="code" readonly="True" />
                                <field name="name" readonly="True" />
                                <field name="from_date" readonly="True" />
                                <field name="to_date" readonly="True" />
                                <field name="currency_id" />
                                <field name="from_afip" readonly="True" />
                            </tree>
                        </field>
                    </page>

                    <page string="Validations">
                        <group col="6" string="Invoice Date Difference from Today">
                            <field name="services_date_difference" />
                            <field name="products_date_difference" />
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!--Window Action for wsfe.config-->
    <record id="action_wsfe_config" model="ir.actions.act_window">
        <field name="name">WSFE Config</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wsfe.config</field>
        <field name="view_mode">tree</field>
        <field
            name="view_ids"
            eval="[
        (5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('view_ws_config_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('view_wsfe_config_form')})
        ]"
        />
    </record>
</odoo>
