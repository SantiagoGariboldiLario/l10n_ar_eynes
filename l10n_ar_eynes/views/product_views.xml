<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="cot_product_template_view_form" model="ir.ui.view">
        <field name="name">cot.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_po_id']" position="after">
                <field name="cot_nomenclature_id" />
                <field name="area_id" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Taxes">
                    <group>
                        <group>
                            <field name="area_id" />
                            <field name="show_fiscal_credit" invisible="True" />
                            <field name="fiscal_credit" invisible="not show_fiscal_credit" />
                        </group>
                        <group>
                            <field name="manufacturer_id" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="cot_product_product_view_form" model="ir.ui.view">
        <field name="name">cot.product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_po_id']" position="after">
                <field name="cot_nomenclature_id" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Taxes">
                    <group>
                        <group>
                            <field name="area_id" />
                            <field name="show_fiscal_credit" invisible="True" />
                            <field name="fiscal_credit" invisible="not show_fiscal_credit" />
                        </group>
                        <group>
                            <field name="manufacturer_id" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="uom_form_view_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">uom.uom.view.form.inherit</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_type']" position="after">
                <field name="cot_code" />
            </xpath>
        </field>
    </record>

    <record id="cot_product_view_form" model="ir.ui.view">
        <field name="name">cot.nomenclature.view.form</field>
        <field name="model">cot.nomenclature</field>
        <field name="arch" type="xml">
            <form string="COT Nomenclature">
                <group col="4" colspan="2">
                    <field name="code" />
                    <field name="name" />
                </group>
            </form>
        </field>
    </record>

    <record id="cot_product_view_tree" model="ir.ui.view">
        <field name="name">cot.nomenclature.view.tree</field>
        <field name="model">cot.nomenclature</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="con_nomenclature_action" model="ir.actions.act_window">
        <field name="name">COT Nomenclature</field>
        <field name="res_model">cot.nomenclature</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_cot_nomenclature"
        name="COT Nomenclature"
        sequence="60"
        parent="stock.menu_product_in_config_stock"
        action="con_nomenclature_action"
    />
</odoo>
