<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_users_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="inside">
                <field name="used_journals_domain" invisible="True" />
                <field name="journal_rel_ids">
                    <tree editable="bottom">
                        <field name="priority" />
                        <field name="used_journals_domain" column_invisible="True" />
                        <field name="journal_id" domain="used_journals_domain" />
                        <field name="code" />
                        <field name="company_id" />
                    </tree>
                </field>
            </xpath>
        </field>
    </record>

</odoo>
