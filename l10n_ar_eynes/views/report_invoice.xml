<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]/h2/span[last()]" position="before">
            <span t-field="o.denomination" />
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="after">
            <table
                id="qrcode"
                t-if="o.move_type in ('out_invoice', 'out_refund') and o.fiscal_type == 'electronic' and qr_code_afip.get(o.id)"
                style="width:100%;border:solid"
            >
                <tr>
                    <td style="width:25%" rowspan="4">
                        <t t-set="qr_afip_code" t-value="qr_code_afip.get(o.id)" />
                        <t
                            t-set="qr_afip_code_url"
                            t-value="'data:image/png;base64,{}'.format(qr_afip_code)"
                        />
                        <img t-att-src="qr_afip_code_url" style="width:150px;height:150px" />
                    </td>
                    <td>
                    </td>
                </tr>
                <tr>
                    <td style="text-align:right;height:50%">
                        <t t-set="cae" t-value="'CAE: {}'.format(o.cae)" />
                        <span t-esc="cae" />
                    </td>
                </tr>
                <tr>
                    <td style="text-align:right;height:50%">
                        <t t-set="caeVto" t-value="'Fecha vto. CAE: {}'.format(o.cae_due_date)" />
                        <span t-esc="caeVto" />
                    </td>
                </tr>
                <tr>
                    <td>
                    </td>
                </tr>
            </table>
            <div t-if="o.is_multi_currency">
                <table>
                    <tr>
                        <td>Moneda: <span t-esc="o.currency_id.name" /></td>
                    </tr>
                    <tr>
                        <td>Tasa de cambio: <span t-esc="o.currency_rate" /></td>
                    </tr>
                </table>
                <p
                >El total de este comprobante expresado en la moneda de curso legal - Pesos Argentinos - asciende a $  <span
                        t-esc="tax_totals['amount_total'] * o.currency_rate"
                    /></p>
            </div>
        </xpath>

    </template>

