<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- * General Webservice Configuration Views *-->
    <record id="view_ws_config_form" model="ir.ui.view">
        <field name="name">ws.config.form</field>
        <field name="model">ws.config</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Config Electronic Invoice">
                <sheet>
                    <h1>
                        <field name="name" />
                    </h1>
                    <group name="principal">
                        <field name="company_id" />
                        <field name="cuit" />
                        <field name="url" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ws_config_tree" model="ir.ui.view">
        <field name="name">ws.config.tree</field>
        <field name="model">ws.config</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" />
                <field name="cuit" />
                <field name="url" />
            </list>
        </field>
    </record>
</odoo>
