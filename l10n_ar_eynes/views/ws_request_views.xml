<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ws_request_form" model="ir.ui.view">
        <field name="name">ws.request.form</field>
        <field name="model">ws.request</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="WS Request" create="false" edit="false">
                <sheet>
                    <h1>WS Request</h1>
                    <group col="4" colspan="6">
                        <separator colspan="6" string="Header" />
                        <field name="date_request" />
                        <field name="nregs" />
                    </group>
                    <notebook colspan="4">
                        <page string="Request Details">
                            <separator string="Details" colspan="4" />
                            <field name="detail_ids" colspan="4" nolabel="1">
                                <list>
                                    <field name="invoice_id" />
                                    <field name="cae" />
                                    <field name="result" />
                                    <field name="events" />
                                    <field name="observations" />
                                    <field name="errors" />
                                </list>
                                <form>
                                    <separator string="Main Information" colspan="4" />
                                    <group colspan="4" col="6">
                                        <group>
                                            <field name="invoice_id" />
                                            <field name="result" />
                                            <field name="cae" />
                                            <field name="cae_due_date" />
                                        </group>
                                        <group>
                                            <field name="pos_ar" />
                                            <field name="voucher_type" />
                                            <field name="voucher_number" />
                                            <field name="voucher_date" />
                                            <field name="currency" />
                                            <field name="currency_rate" />
                                        </group>
                                    </group>
                                    <separator string="XML Request" colspan="4" />
                                    <field name="xml_request" nolabel="1" colspan="4" />
                                    <separator string="Observations" colspan="4" />
                                    <field name="observations" nolabel="1" colspan="4" />
                                    <separator string="Events" colspan="4" />
                                    <field name="events" nolabel="1" colspan="4" />
                                    <separator string="Errors" colspan="4" />
                                    <field name="errors" nolabel="1" colspan="4" />
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ws_request_tree" model="ir.ui.view">
        <field name="name">ws.request.tree</field>
        <field name="model">ws.request</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="id" />
                <field name="date_request" />
                <field name="nregs" />
            </list>
        </field>
    </record>

    <record id="action_ws_request_tree" model="ir.actions.act_window">
        <field name="name">WS Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ws.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
