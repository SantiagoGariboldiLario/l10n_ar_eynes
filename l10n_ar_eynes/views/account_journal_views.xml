<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_journal_view_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">account.journal.view.form.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">

            <notebook position="inside">
                <page name="pos_info" string="POS information" invisible="[('type','!=','sale')]">
                    <group>
                        <group>
                            <field name="denomination" required="[('type','=','sale')]" />
                            <field name="fiscal_position_id" required="[('type','=','sale')]" invisible="1" />
                            <field
                                name="fiscal_position_ids"
                                widget="many2many_tags"
                                required="[('type','=','sale')]"
                            />
                            <field name="image_filename" invisible="True" />
                            <field name="image" widget="image" filename="image_filename" />
                        </group>
                        <group>
                            <field name="activity_start_date" required="[('type','=','sale')]" />
                            <field name="warehouse_id" required="[('type','=','sale')]" />
                        </group>
                    </group>
                </page>

                <page name="perceptions" string="Perceptions" invisible="[('type','!=','perceptions')]">
                    <group string="Tax Information">
                        <field name="tax_id" select="1" required="[('type', '=', 'perceptions')]" />
                        <field name="type_tax_use" select="1" />
                    </group>
                </page>

                <page name="retentions" string="Retentions" invisible="[('type','!=','retentions')]">
                    <group string="Tax Information">
                        <field name="tax_id" select="1" required="[('type', '=', 'retentions')]" />
                        <field name="type_tax_use" select="1" />
                    </group>
                </page>
            </notebook>

            <xpath expr="//field[@name='type']" position="after">
                <field
                    name="fiscal_type"
                    invisible="[('type', '!=', 'sale')]"
                    required="[('type', '=', 'sale')]"
                />
                <field name="fcred_is_fce_emitter" invisible="[('type', '!=', 'sale')]" />
                <field name="due_date" readonly="[('id', '!=', False)]" />
            </xpath>

            <xpath expr="//page[@name='advanced_settings']" position="attributes">
                <attribute name="invisible">
                    [('type', 'in', ('perceptions', 'retentions'))]
                </attribute>
            </xpath>

            <xpath
                expr="//field[@name='outbound_payment_method_line_ids']/tree/field[@name='name']"
                position="after"
            >
                <field name="format" readonly="1" />
            </xpath>

            <xpath expr="//field[@name='profit_account_id']" position="attributes">
                <attribute name="invisible">
                    ['!', ('type', 'in', ('cash', 'bank', 'third_party_checks'))]
                </attribute>
            </xpath>

            <xpath expr="//field[@name='loss_account_id']" position="attributes">
                <attribute name="invisible">
                    ['!', ('type', 'in', ('cash', 'bank', 'third_party_checks'))]
                </attribute>
            </xpath>

            <field name="code" position="after">
                <field name="afip_code" invisible="[('type', '!=', 'retentions')]" />
                <label
                    for="sequence_number_next"
                    invisible="[
                        '|',
                        ('type', 'not in', ('sale')),
                        ('fiscal_type', 'not in', ('internal')),
                        ('type', 'not in', ('receipt', 'payment', 'retentions')),
                    ]"
                />
                <div>
                    <field
                        name="sequence_number_next"
                        invisible="[
                            '|',
                            ('type', 'not in', ('sale')),
                            ('fiscal_type', 'not in', ('internal')),
                            ('type', 'not in', ('receipt', 'payment', 'retentions')),
                        ]"
                        style="padding-right: 1.0em"
                    />
                    <field
                        name="sequence_id"
                        invisible="[
                            '|',
                            '|',
                            ('id', '=', False),
                            ('type', 'not in', ('receipt', 'payment', 'retentions', 'perceptions')),
                            ('type', '=', 'sale'),
                            ('fiscal_type', '!=', 'internal'),
                        ]"
                    />
                </div>

                <label
                    for="cn_sequence_number_next"
                    invisible="['|', ('type', 'not in', ('sale')), ('fiscal_type', '!=', 'internal')]"
                />
                <div>
                    <field
                        name="cn_sequence_number_next"
                        invisible="['|', ('type', 'not in', ('sale')), ('fiscal_type', '!=', 'internal')]"
                        style="padding-right: 1.0em"
                    />
                    <field
                        name="cn_sequence_id"
                        invisible="[
                            '|',
                            '|',
                            ('id', '=', False),
                            ('type', 'not in', ('sale')),
                            ('fiscal_type', '!=', 'internal')
                        ]"
                    />
                </div>

                <label
                    for="dn_sequence_number_next"
                    invisible="['|', ('type', 'not in', ('sale')), ('fiscal_type', '!=', 'internal')]"
                />
                <div>
                    <field
                        name="dn_sequence_number_next"
                        invisible="['|', ('type', 'not in', ('sale')), ('fiscal_type', '!=', 'internal')]"
                        style="padding-right: 1.0em"
                    />
                    <field
                        name="dn_sequence_id"
                        invisible="[
                            '|',
                            '|',
                            ('id', '=', False),
                            ('type', 'not in', ('sale')),
                            ('fiscal_type', '!=', 'internal')
                        ]"
                    />
                </div>

                <label
                    for="fce_sequence_number_next"
                    invisible="['|', ('type', 'not in', ('sale')), ('fiscal_type', '!=', 'internal')]"
                />
                <div>
                    <field
                        name="fce_sequence_number_next"
                        invisible="['|', ('type', 'not in', ('sale')), ('fiscal_type', '!=', 'internal')]"
                        style="padding-right: 1.0em"
                    />
                    <field
                        name="fce_sequence_id"
                        invisible="[
                            '|',
                            '|',
                            ('id', '=', False),
                            ('type', 'not in', ('sale')),
                            ('fiscal_type', '!=', 'internal')
                        ]"
                    />
                </div>
                <label
                    for="nce_sequence_number_next"
                    invisible="[
                        '|',
                        ('type', 'not in', ('sale')),
                        ('fiscal_type', 'not in', ('internal')),
                        ('type', 'not in', ('receipt', 'payment', 'retentions')),
                    ]"
                />
                <div>
                    <field
                        name="nce_sequence_number_next"
                        invisible="[
                            '|',
                            ('type', 'not in', ('sale')),
                            ('fiscal_type', 'not in', ('internal')),
                            ('type', 'not in', ('receipt', 'payment', 'retentions')),
                        ]"
                        style="padding-right: 1.0em"
                    />
                    <field
                        name="nce_sequence_id"
                        invisible="[
                            '|',
                            '|',
                            ('id', '=', False),
                            ('type', 'not in', ('receipt', 'payment', 'retentions', 'perceptions')),
                            ('type', '=', 'sale'),
                            ('fiscal_type', '!=', 'internal'),
                        ]"
                    />
                </div>

                <label
                    for="nde_sequence_number_next"
                    invisible="['|', ('type', 'not in', ('sale')), ('fiscal_type', '!=', 'internal')]"
                />
                <div>
                    <field
                        name="nde_sequence_number_next"
                        invisible="['|', ('type', 'not in', ('sale')), ('fiscal_type', '!=', 'internal')]"
                        style="padding-right: 1.0em"
                    />
                    <field
                        name="nde_sequence_id"
                        invisible="[
                            '|',
                            '|',
                            ('id', '=', False),
                            ('type', 'not in', ('sale')),
                            ('fiscal_type', '!=', 'internal')
                        ]"
                    />
                </div>

            </field>

        </field>
    </record>

    <record id="account.action_account_journal_form" model="ir.actions.act_window">
        <field name="name">Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">tree,kanban,form</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('account.view_account_journal_tree')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('account.account_journal_view_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_account_journal_form')})]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Add a journal
            </p><p>
            A journal is used to record transactions of all accounting data
            related to the day-to-day business.
            </p>
        </field>
        <field name="domain">[('type', 'not in', ('perceptions', 'retentions'))]</field>
    </record>
</odoo>
