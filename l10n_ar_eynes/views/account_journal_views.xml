<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_journal_view_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">account.journal.view.form.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <notebook position="before">
                <group name="retentions_info" attrs="{'invisible' : [('type', '!=', 'retentions')]}">
                    <group string="Tax Information">
                        <field name="tax_id" select="1"/>
                        <field name="type_tax_use" select="1"/>
                    </group>
                    <group string="Jurisdiction Information">
                        <field name="jurisdiccion" select="1"/>
                        <field name="state_id" select="1" attrs="{'invisible':[('jurisdiccion','!=','provincial')], 'required':[('jurisdiccion','=','provincial')]}"/>
                        <field name="applicable_state" attrs="{'invisible':[('jurisdiccion','!=','provincial')], 'required':[('jurisdiccion','=','provincial')]}"/>
                        <field name="from_register_ARBA"/>
                        <field name="from_register_AGIP"/>
                    </group>
                    <group string="Usability Configuration">
                        <!-- <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/> -->
                        <field name="check_sit_iibb" attrs="{'invisible':[('jurisdiccion','!=','provincial')]}"/>
                        <field name="always_apply_padron"/>
                    </group>
                </group>
            </notebook>

            <notebook position="inside">
                <page name="pos_info" string="POS information" attrs="{'invisible': [('type','!=','sale')]}">
                    <group>
                        <group>
                            <field name="denomination" attrs="{'required':[('type','=','sale')]}"/>
                            <field name="fiscal_position_id" attrs="{'required':[('type','=','sale')]}"/>
                        </group>
                        <group>
                            <field name="activity_start_date" attrs="{'required':[('type','=','sale')]}"/>
                            <field name="warehouse_id" attrs="{'required':[('type','=','sale')]}"/>
                        </group>
                    </group>
                </page>

                <page name="perceptions" string="Perceptions" attrs="{'invisible': [('type','!=','perceptions')]}">
                    <p>Perceptions</p>
                </page>

                <page name="retentions" string="Retentions" attrs="{'invisible': [('type','!=','retentions')]}">
                    <p>Retentions</p>
                </page>
            </notebook>

            <xpath expr="//field[@name='type']" position="after">
                <field name="due_date" attrs="{'readonly': [('id', '!=', False)]}"/>
            </xpath>

            <xpath expr="//field[@name='outbound_payment_method_line_ids']/tree/field[@name='name']" position="after">
                <field name="format" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='profit_account_id']" position="attributes">
                <attribute name="attrs">
                    {'invisible': ['!', ('type', 'in', ('cash', 'bank', 'third_party_checks', 'retentions', 'perceptions'))]}
                </attribute>
            </xpath>

            <xpath expr="//field[@name='loss_account_id']" position="attributes">
                <attribute name="attrs">
                    {'invisible': ['!', ('type', 'in', ('cash', 'bank', 'third_party_checks', 'retentions', 'perceptions'))]}
                </attribute>
            </xpath>

            <xpath expr="//field[@name='default_account_id'][3]" position="attributes">
                <attribute name="attrs">
                    {'required':False}
                </attribute>
            </xpath>

        </field>
    </record>
</odoo>
