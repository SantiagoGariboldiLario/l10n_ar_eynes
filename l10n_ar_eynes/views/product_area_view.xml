<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_area_view_tree" model="ir.ui.view">
        <field name="name">product.area.view.tree</field>
        <field name="model">product.area</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="description" />
                <field name="active" widget="boolean_toggle" />
            </tree>
        </field>
    </record>

    <record id="product_area_view_form" model="ir.ui.view">
        <field name="name">product.area.view.form</field>
        <field name="model">product.area</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                    </group>
                    <group>
                        <field name="active" widget="boolean_toggle" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_area_action" model="ir.actions.act_window">
        <field name="name">Product area</field>
        <field name="res_model">product.area</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_product_area"
        name="Product area"
        sequence="2"
        parent="account.account_management_menu"
        action="product_area_action"
    />
</odoo>
