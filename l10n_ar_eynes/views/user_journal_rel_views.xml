<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- form-->
    <record id="user_journal_rel_view_form" model="ir.ui.view">
        <field name="name">user.journal.rel.view.form</field>
        <field name="model">user.journal.rel</field>
        <field name="arch" type="xml">
            <form string="User Journal Relation">
                <sheet>
                    <group>
                        <field name="user_id" />
                        <field name="journal_id" />
                        <field name="sequence" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- tree -->
    <record id="user_journal_rel_view_tree" model="ir.ui.view">
        <field name="name">user.journal.rel.view.tree</field>
        <field name="model">user.journal.rel</field>
        <field name="arch" type="xml">
            <tree>
                <field name="user_id" />
                <field name="journal_id" />
                <field name="sequence" />
            </tree>
        </field>
    </record>

    <!-- action -->
    <record id="journal_configuration_action" model="ir.actions.act_window">
        <field name="name">Assign Journals to Users</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">user.journal.rel</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="user_journal_rel_view_tree" />
    </record>

    <!-- menuitem -->
    <menuitem
        id="menu_action_journal_configuration"
        name="Assign Journals to Users"
        parent="account.menu_finance_entries_accounting_journals"
        action="journal_configuration_action"
    />

    <record id="view_upgrade_record_search" model="ir.ui.view">
        <field name="model">user.journal.rel</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter name="group_by_user" context="{'group_by': 'user_id'}" />
                    <filter
                        name="group_by_journal"
                        context="{'group_by': 'journal_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

</odoo>
