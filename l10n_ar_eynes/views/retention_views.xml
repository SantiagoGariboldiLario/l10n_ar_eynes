<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ********************** -->
    <!-- * Retention Concepts * -->
    <!-- ********************** -->
    <record id="view_retention_concept_form" model="ir.ui.view">
        <field name="name">retention.concept.form</field>
        <field name="model">retention.concept</field>
        <field name="arch" type="xml">
            <form string="Retention Concept" version="7.0">
                <sheet>
                    <group>
                        <group>
                            <field name="code" select="1" />
                            <field name="type" select="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                options="{'no_create': True}"
                            />
                        </group>
                        <group>
                            <field name="name" select="1" />
                            <field name="no_subject" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounts Associated" name="accounts">
                            <field name="account_ids">
                                <tree>
                                    <field name="name" />
                                    <field name="code" />
                                    <field name="internal_type" />
                                    <field name="user_type_id" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <separator string="Notes" name="notes" />
                    <field name="notes" colspan="4" nolabel="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_retention_concept_tree" model="ir.ui.view">
        <field name="name">retention.concept.tree</field>
        <field name="model">retention.concept</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="type" />
                <field name="name" />
                <field name="no_subject" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_retention_concept">
        <field name="name">Concepts</field>
        <field name="res_model">retention.concept</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ************************ -->
    <!-- * Retention Activities * -->
    <!-- ************************ -->
    <record id="view_retention_activity_form" model="ir.ui.view">
        <field name="name">retention.activity.form</field>
        <field name="model">retention.activity</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Retention Activity">
                <sheet>
                    <h1 style="width: 100%%">
                        <field name="name" select="1" style="width: 100%%" />
                    </h1>
                    <group>
                        <group>
                            <field name="code" select="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                options="{'no_create': True}"
                            />
                        </group>
                        <group>
                            <field name="type" select="1" />
                        </group>
                    </group>
                    <separator string="Notes" colspan="4" />
                    <field name="notes" colspan="4" nolabel="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_retention_activity_tree" model="ir.ui.view">
        <field name="name">retention.activity.tree</field>
        <field name="model">retention.activity</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="code" />
                <field name="type" />
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_retention_activity">
        <field name="name">Activities</field>
        <field name="res_model">retention.activity</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ************************ -->
    <!-- * Retention Scales * -->
    <!-- ************************ -->
    <record id="view_retention_scale_form" model="ir.ui.view">
        <field name="name">retention.scale.form</field>
        <field name="model">retention.scale</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Retention Scale">
                <sheet>
                    <h1 style="width: 100%%">
                        <field name="name" select="1" style="width: 100%%" />
                    </h1>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" colspan="4" nolabel="1">
                                <tree editable="bottom">
                                    <field name="name" />
                                    <field name="limit" />
                                    <field name="percent" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_retention_scale_tree" model="ir.ui.view">
        <field name="name">retention.scale.tree</field>
        <field name="model">retention.scale</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_retention_scale">
        <field name="name">Retention Scales</field>
        <field name="res_model">retention.scale</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ************************ -->
    <!-- * Retention Payment Order Lines * -->
    <!-- ************************ -->

    <record id="account_payment_order_retention_line_view_tree" model="ir.ui.view">
        <field name="name">account.payment.order.retention.line.view.tree</field>
        <field name="model">account.payment.order.retention.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date" />
                <field name="date_applied" />
                <field name="reg_code" />
                <field name="name" />
                <field name="partner_id" />
                <field name="vat" />
                <field name="certificate_no" />
                <field name="voucher_number" />
                <field name="concept_id" />
                <field name="invoice_id" />
                <field name="base" sum="Base Total" />
                <field name="amount" sum="Amount Total" />
                <field name="unlinkable" />
                <field name="state_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="account_id" invisible="1" />
                <field name="payment_order_id" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="supported_retentions_action" model="ir.actions.act_window">
        <field name="name">Supported Retentions</field>
        <field name="res_model">account.payment.order.retention.line</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('retention_id.type_tax_use', '=', 'sale')]</field>
    </record>

    <record id="applied_retentions_action" model="ir.actions.act_window">
        <field name="name">Applied Retentions</field>
        <field name="res_model">account.payment.order.retention.line</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('retention_id.type_tax_use', '=', 'purchase')]</field>
    </record>

</odoo>
