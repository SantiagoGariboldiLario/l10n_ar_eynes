<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fiscal_year_closing_view_form" model="ir.ui.view">
        <field name="name">fiscal.year.closing.view.form</field>
        <field name="model">fiscal.year.closing</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Fiscal Year Closing">
                <header>
                    <button name="action_draft" string="Continue" type="object" invisible="state != 'new'" />
                    <button
                        name="%(action_fiscal_year_closing)d"
                        string="Perform Operations"
                        type="action"
                        class="oe_highlight"
                        invisible="state not in ('draft', 'in_progress')"
                    />
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        invisible="state != 'in_progress'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state not in ('in_progress', 'done')"
                    />
                    <button
                        name="action_recover"
                        string="Draft"
                        type="object"
                        invisible="state != 'canceled'"
                    />
                    <field name="state" widget="statusbar" readonly="1" />
                </header>
                <sheet>
                    <group invisible="state != 'new'">
                        <field name="company_id_domain" invisible="True" />
                        <field name="company_id" select="1" required="1" domain="company_id_domain" />
                        <field name="name" select="2" />
                    </group>
                    <group string="Fiscal Years" invisible="state != 'new'">
                        <field name="closing_id" domain="[('company_id', '=', company_id)]" />
                        <field name="opening_id" domain="[('company_id', '=', company_id)]" />
                    </group>
                    <notebook invisible="state == 'new'">
                        <page string="General">
                            <group>
                                <group>
                                    <separator string="Operation to Perform" />
                                    <field
                                        name="create_loss_profit_move"
                                        readonly="state in ('done', 'cancel')"
                                    />
                                    <field
                                        name="create_closing_move"
                                        readonly="state in ('done', 'cancel')"
                                    />
                                    <field
                                        name="create_opening_move"
                                        readonly="state in ('done', 'cancel')"
                                    />
                                    <field name="create_recpam" readonly="state in ('done', 'cancel')" />
                                    <separator string="Move Created by the Operation" />
                                    <field name="loss_profit_move_id" />
                                    <field name="closing_move_id" />
                                    <field name="opening_move_id" />
                                    <field name="recpam_move_id" />
                                </group>
                                <group string="Checks">
                                    <field name="check_draft_moves" readonly="state in ('done', 'cancel')" />
                                    <field
                                        name="check_unbalanced_moves"
                                        readonly="state in ('done', 'cancel')"
                                    />
                                </group>
                            </group>
                        </page>
                        <page string="Configuration" invisible="state == 'new'">
                            <notebook>
                                <page string="Loss and Profit">
                                    <group>
                                        <group>
                                            <field
                                                name="loss_profit_description"
                                                readonly="state in ('done', 'cancel')"
                                            />
                                            <field
                                                name="loss_profit_journal_id"
                                                readonly="state in ('done', 'cancel')"
                                                required="create_loss_profit_move"
                                            />
                                        </group>
                                        <group>
                                            <field
                                                name="loss_profit_date"
                                                readonly="state in ('done', 'cancel')"
                                            />
                                        </group>
                                    </group>
                                    <separator string="Account Mapping" />
                                    <field
                                        name="loss_profit_account_mapping_ids"
                                        nolabel="1"
                                        readonly="state in ('done', 'cancel')"
                                    >
                                        <tree editable="top">
                                            <field
                                                name="source_account_type"
                                                widget="account_hierarchy_selection"
                                            />
                                            <field
                                                name="destination_account_id"
                                                required="True"
                                                domain="[('company_id', '=', parent.company_id)]"
                                            />
                                        </tree>
                                    </field>
                                </page>
                                <page string="Closing">
                                    <group>
                                        <group>
                                            <field
                                                name="closing_description"
                                                readonly="state in ('done', 'cancel')"
                                            />
                                            <field
                                                name="closing_journal_id"
                                                readonly="state in ('done', 'cancel')"
                                                required="create_closing_move"
                                            />
                                        </group>
                                        <group>
                                            <field
                                                name="closing_date"
                                                readonly="state in ('done', 'cancel')"
                                            />
                                        </group>
                                    </group>
                                    <separator string="Account Mapping" />
                                    <field
                                        name="closing_account_mapping_ids"
                                        nolabel="1"
                                        readonly="state in ('done', 'cancel')"
                                    >
                                        <tree editable="top">
                                            <field
                                                name="source_account_type"
                                                widget="account_hierarchy_selection"
                                            />
                                            <field
                                                name="destination_account_id"
                                                domain="[('company_id', '=', parent.company_id)]"
                                            />
                                        </tree>
                                    </field>
                                </page>
                                <page string="Opening">
                                    <group>
                                        <group>
                                            <field
                                                name="opening_description"
                                                readonly="state in ('done', 'cancel')"
                                            />
                                            <field
                                                name="opening_journal_id"
                                                readonly="state in ('done', 'cancel')"
                                                required="create_opening_move"
                                            />
                                        </group>
                                        <group>
                                            <field
                                                name="opening_date"
                                                readonly="state in ('done', 'cancel')"
                                            />
                                        </group>
                                    </group>
                                </page>
                                <page string="RECPAM">
                                    <group>
                                        <group>
                                            <field
                                                name="recpam_description"
                                                readonly="state in ('done', 'cancel')"
                                            />
                                            <field
                                                name="recpam_account_id"
                                                readonly="state in ('done', 'cancel')"
                                                required="create_recpam"
                                            />
                                        </group>
                                        <group>
                                            <field
                                                name="recpam_journal_id"
                                                readonly="state in ('done', 'cancel')"
                                                required="create_recpam"
                                            />
                                            <field name="rounding" readonly="state in ('done', 'cancel')" />
                                        </group>
                                    </group>
                                </page>
                            </notebook>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fiscal_year_closing_view_tree" model="ir.ui.view">
        <field name="name">fiscal.year.closing.view.tree</field>
        <field name="model">fiscal.year.closing</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree
                decoration-danger="state == 'new'"
                decoration-primary="state == 'draft'"
                decoration-success="state == 'in_progress'"
            >
                <field name="company_id" select="1" />
                <field name="name" select="2" />
                <field name="closing_id" select="1" />
                <field name="opening_id" select="1" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="action_fiscal_year_closing_form" model="ir.actions.act_window">
        <field name="name">Close Fiscal Year</field>
        <field name="res_model">fiscal.year.closing</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="fiscal_year_closing_view_form" />
        <field name="view_mode">form,tree</field>
    </record>

    <record model="ir.actions.act_window" id="action_fiscal_year_closing_tree">
        <field name="name">Fiscal Years Closings</field>
        <field name="res_model">fiscal.year.closing</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="fiscal_year_closing_view_tree" />
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
