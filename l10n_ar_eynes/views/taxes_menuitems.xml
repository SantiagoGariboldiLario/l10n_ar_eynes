<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="action_retention_journals" model="ir.actions.act_window">
        <field name="name">Retention Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">type == 'retentions'</field>
        <field name="context">{'default_type':'retentions'}</field>
    </record>

    <record id="action_perception_journals" model="ir.actions.act_window">
        <field name="name">Perception Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">type == 'perceptions'</field>
        <field name="context">{'default_type':'perceptions'}</field>
    </record>

    <menuitem id="taxes_submenu" name="Taxes" parent="account.menu_finance_configuration" sequence="3">
        <menuitem
            id="account.menu_action_tax_form"
            name="Taxes"
            action="account.action_tax_form"
            sequence="1"
        />
    </menuitem>

    <menuitem
        id="taxes_retentions_submenu"
        name="Retentions"
        parent="account.menu_finance_configuration"
        sequence="3"
    >
        <menuitem id="retentions_menu" name="Retentions" action="action_retention_journals" sequence="1" />
        <menuitem
            id="retention_concepts_menu"
            name="Concepts"
            action="action_retention_concept"
            sequence="2"
        />
        <menuitem
            id="retention_activities_menu"
            name="Activities"
            action="action_retention_activity"
            sequence="3"
        />
        <menuitem
            id="retention_retention_scales_menu"
            name="Scales"
            action="action_retention_scale"
            sequence="4"
        />
        <menuitem
            id="applied_retentions_menu"
            name="Applied Retentions"
            action="applied_retentions_action"
            sequence="5"
        />
        <menuitem
            id="supported_retentions_menu"
            name="Supported Retentions"
            action="supported_retentions_action"
            sequence="6"
        />
    </menuitem>

    <menuitem
        id="taxes_perceptions_menu"
        name="Perceptions"
        parent="account.menu_finance_configuration"
        sequence="3"
    >
        <menuitem id="perceptions_menu" name="Perceptions" action="action_perception_journals" />
        <menuitem
            id="perception_tax_line_menu_applied"
            name="Perception Applied"
            action="applied_perceptions_action"
        />
        <menuitem
            id="perception_tax_line_menu_supported"
            name="Perception Supported"
            action="supported_perceptions_action"
        />
        <menuitem id="perception_concepts_menu" name="Concepts" action="action_perception_concept_tree" />
        <menuitem
            id="perception_activities_menu"
            name="Activities"
            action="action_perception_activity_tree"
        />
    </menuitem>
</odoo>
