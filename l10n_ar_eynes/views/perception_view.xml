<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- *************************** -->
    <!-- * Perception Configuration * -->
    <!-- *************************** -->
    <!-- Form View for perception.perception -->
    <record id="view_perception_perception_form" model="ir.ui.view">
        <field name="name">perception.perception.auto.form</field>
        <field name="model">perception.perception</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Perceptions">
                <sheet>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Perception" />
                        <h1><field name="name" placeholder="Perception Name" /></h1>
                    </div>
                    <group>
                        <group string="Tax Information">
                            <field name="tax_id" select="1" />
                            <field name="type_tax_use" select="1" />
                        </group>
                        <group string="Jurisdiction Information">
                            <field name="jurisdiccion" select="1" />
                            <field
                                name="state_id"
                                select="1"
                                attrs="{'invisible':[('jurisdiccion','!=','provincial')], 'required':[('jurisdiccion','=','provincial')]}"
                            />
                            <field
                                name="applicable_state"
                                attrs="{'invisible':[('jurisdiccion','!=','provincial')], 'required':[('jurisdiccion','=','provincial')]}"
                            />
                            <field
                                name="applicable_location"
                                attrs="{'invisible': ['|', ('jurisdiccion', '!=', 'provincial'), ('applicable_state', 'not in', ['source', 'dest'])],
                                'required': [('applicable_state', 'in', ['source', 'dest'])]}"
                            />
                        </group>
                        <group string="Usability Configuration">
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                options="{'no_create': True}"
                            />
                            <field
                                name="check_sit_iibb"
                                attrs="{'invisible':[('jurisdiccion','!=','provincial')]}"
                            />
                            <field name="always_apply_padron" />
                        </group>
                        <group string="Other Info">
                            <field name="code" />
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page string="Tax Application">
                            <group colspan="4" col="6">
                                <field name="type" colspan="6" />
                            </group>

                            <separator string="Tax Application" />
                            <field
                                name="vat_application_ids"
                                nolabel="1"
                                colspan="4"
                                attrs="{'invisible':[('type','!=','vat')]}"
                                context="{'default_type':'vat'}"
                            >
                                <tree string="VAT Tax Application">
                                    <field name="reg_code" />
                                    <field name="activity_id" />
                                    <field name="concept_id" />
                                    <field name="tax_allowance" />
                                    <field name="exclude_tax_allowance" />
                                    <field name="calculation_base" required="1" />
                                    <field name="tax_minimum" />
                                    <!--<field name="aliq_type" required="1"/>-->
                                    <field name="percent" />
                                    <field name="type" invisible="1" />
                                </tree>
                                <form string="VAT Tax Application">
                                    <group>
                                        <field
                                            name="activity_id"
                                            domain="[('type','=','vat')]"
                                        />
                                        <field
                                            name="concept_id"
                                            domain="[('type','=','vat')]"
                                        />
                                        <field name="tax_allowance" />
                                        <field name="exclude_tax_allowance" />
                                        <field name="calculation_base" required="1" />
                                        <field name="tax_minimum" />
                                        <!--<field name="aliq_type" required="1"/>-->
                                        <field name="percent" />
                                        <field name="name" />
                                        <field name="reg_code" />
                                        <field name="type" invisible="1" />
                                    </group>

                                    <group
                                        name="proportional"
                                        colspan="4"
                                        attrs="{'invisible':[('calculation_base','!=','proportional_vat')]}"
                                    >
                                        <separator string="Configuration" colspan="4" />
                                        <field name="vat_tax_ids" nolabel="1">
                                            <tree
                                                editable="bottom"
                                                string="VAT Taxes for Calculation"
                                            >
                                                <field name="tax_id" />
                                                <field name="rate" />
                                            </tree>
                                        </field>
                                    </group>
                                </form>
                            </field>

                            <field
                                name="gi_application_ids"
                                nolabel="1"
                                colspan="4"
                                attrs="{'invisible':[('type','!=','gross_income')]}"
                                context="{'default_type':'gross_income'}"
                            >
                                <tree string="Gross Income Tax Application">
                                    <field name="reg_code" />
                                    <field name="activity_id" />
                                    <field name="concept_id" />
                                    <field name="tax_allowance" />
                                    <field name="exclude_tax_allowance" />
                                    <field name="calculation_base" required="1" />
                                    <field name="tax_minimum" />
                                    <!--<field name="aliq_type" required="1"/>-->
                                    <field name="percent" />
                                    <field name="sit_iibb" />
                                    <field name="type" invisible="1" />
                                </tree>
                                <form string="Gross Income Tax Application">
                                    <group>
                                        <field
                                            name="activity_id"
                                            domain="[('type','=','gross_income')]"
                                        />
                                        <field
                                            name="concept_id"
                                            domain="[('type','=','gross_income')]"
                                        />
                                        <field name="tax_allowance" />
                                        <field name="exclude_tax_allowance" />
                                        <field name="calculation_base" required="1" />
                                        <field name="tax_minimum" />
                                        <!--<field name="aliq_type" required="1"/>-->
                                        <field name="percent" />
                                        <field name="name" />
                                        <field name="reg_code" />
                                        <field name="sit_iibb" />
                                        <field name="type" invisible="1" />
                                    </group>
                                </form>
                            </field>

                            <field
                                name="profit_application_ids"
                                nolabel="1"
                                colspan="4"
                                attrs="{'invisible':[('type','!=','profit')]}"
                                context="{'default_type':'profit'}"
                            >
                                <tree string="Profit Tax Application">
                                    <field name="reg_code" />
                                    <field name="activity_id" />
                                    <field name="concept_id" />
                                    <field name="tax_allowance" />
                                    <field name="exclude_tax_allowance" />
                                    <field name="calculation_base" required="1" />
                                    <field name="tax_minimum" />
                                    <!--<field name="aliq_type" required="1"/>-->
                                    <field name="percent" />
                                    <field name="type" invisible="1" />
                                </tree>
                                <form string="Profit Tax Application">
                                    <group>
                                        <field
                                            name="activity_id"
                                            domain="[('type','=','profit')]"
                                        />
                                        <field
                                            name="concept_id"
                                            domain="[('type','=','profit')]"
                                        />
                                        <field name="tax_allowance" />
                                        <field name="exclude_tax_allowance" />
                                        <field name="calculation_base" required="1" />
                                        <field name="tax_minimum" />
                                        <!--<field name="aliq_type" required="1"/>-->
                                        <field name="percent" />
                                        <field name="name" />
                                        <field name="reg_code" />
                                        <field name="type" invisible="1" />
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Other Information">
                            <field
                                name="general_resolution"
                                string="General Resolution Associated"
                            />
                            <newline />
                            <separator string="Notes" colspan="4" />
                            <field name="notes" nolabel="1" colspan="4" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View for perception.perception -->
    <record id="perception_perception_view_tree" model="ir.ui.view">
        <field name="name">perception.perception.tree</field>
        <field name="model">perception.perception</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="Perceptions">
                <field name="name" />
                <field name="tax_id" />
                <field name="type_tax_use" />
                <field name="state_id" />
            </tree>
        </field>
    </record>

    <!-- Search View for perception.tax.line -->
    <record id="perception_tax_line_view_search" model="ir.ui.view">
        <field name="name">perception.tax.line.search</field>
        <field name="model">perception.tax.line</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Perception Tax Lines">
                <filter
                    icon="terp-check"
                    name="applied"
                    string="Applied"
                    domain="[('perception_id.type_tax_use', '=', 'sale')]"
                    help="Perception Applied"
                />
                <filter
                    icon="gtk-cancel"
                    name="supported"
                    string="Supported"
                    domain="[('perception_id.type_tax_use', '=', 'purchase')]"
                    help="Perception Supported"
                />
                <separator orientation="vertical" />
                <field name="name" />
                <field name="date" />
                <field name="concept_id" />
                <field name="reg_code" />
                <field name="invoice_id" />
                <field name="partner_id" />
                <field name="perception_id" />
                <field name="state_id" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    widget="selection"
                />
                <group
                    expand="0"
                    string="Group By..."
                    groups="account.group_account_user"
                >
                    <filter
                        name="province"
                        string="Province"
                        icon="terp-stock_effects-object-colorize"
                        domain="[]"
                        context="{'group_by':'state_id'}"
                    />
                    <filter
                        name="group_date"
                        string="Date"
                        icon="terp-go-month"
                        domain="[]"
                        context="{'group_by':'date'}"
                    />
                    <filter
                        string="Concept"
                        name="group_concept"
                        domain="[]"
                        context="{'group_by':'concept_id'}"
                    />
                    <filter
                        string="Reg. Code"
                        name="group_code"
                        domain="[]"
                        context="{'group_by':'reg_code'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="perception_tax_line_view_tree" model="ir.ui.view">
        <field name="name">perception.tax.line.tree</field>
        <field name="model">perception.tax.line</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="Perception Tax Lines">
                <field name="reg_code" />
                <field name="concept_id" />
                <field name="date" />
                <field name="name" />
                <field name="invoice_id" />
                <field name="partner_id" />
                <field name="vat" />
                <field name="amount" sum="Amount Total" />
                <field name="base" sum="Base Total" />
                <field name="state_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record id="perception_tax_line_view_form" model="ir.ui.view">
        <field name="name">perception.tax.line.form</field>
        <field name="model">perception.tax.line</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <label for="name" string="Perception Tax Line" />
                        <field name="name" class="oe_inline" readonly="0" />
                    </h1>
                    <group>
                        <field name="date" />
                        <field name="partner_id" />
                        <field name="vat" />
                        <field name="concept_id" />
                        <field name="perception_id" invisible="True" />
                    </group>
                    <group>
                        <group>
                            <field name="amount" sum="Amount Total" />
                            <field name="base" sum="Base Total" />
                        </group>
                        <group>
                            <field name="state_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- *********************** -->
    <!-- * perception Concepts * -->
    <!-- *********************** -->
    <record id="view_perception_concept_form" model="ir.ui.view">
        <field name="name">perception.concept.form</field>
        <field name="model">perception.concept</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Perception Concept">
                <group>
                    <group>
                        <field name="code" />
                        <field name="type" />
                        <field
                            name="company_id"
                            groups="base.group_multi_company"
                            options="{'no_create': True}"
                        />
                    </group>
                    <group>
                        <field name="name" select="1" />
                        <field name="no_subject" />
                    </group>
                </group>
                <separator string="Accounts Associated" />
                <field name="account_ids">
                    <tree>
                        <field name="name" />
                        <field name="code" />
                        <field name="internal_type" />
                        <field name="user_type_id" />
                    </tree>
                </field>
                <separator string="Notes" />
                <field name="notes" colspan="4" nolabel="1" />
            </form>
        </field>
    </record>

    <record id="view_perception_concept_tree" model="ir.ui.view">
        <field name="name">perception.concept.tree</field>
        <field name="model">perception.concept</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="Perception Concepts">
                <field name="code" />
                <field name="type" />
                <field name="name" />
                <field name="no_subject" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_perception_concept_tree">
        <field name="name">Concepts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">perception.concept</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ************************ -->
    <!-- * perception Activities * -->
    <!-- ************************ -->
    <record id="view_perception_activity_form" model="ir.ui.view">
        <field name="name">perception.activity.form</field>
        <field name="model">perception.activity</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Perception Activity">
                <field name="code" select="1" />
                <field name="type" select="1" />
                <field name="name" select="1" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    options="{'no_create': True}"
                />
                <separator string="Notes" colspan="4" />
                <field name="notes" colspan="4" nolabel="1" />
            </form>
        </field>
    </record>

    <record id="view_perception_activity_tree" model="ir.ui.view">
        <field name="name">perception.activity.tree</field>
        <field name="model">perception.activity</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="Perception Activities" editable="bottom">
                <field name="code" />
                <field name="type" />
                <field name="name" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    options="{'no_create': True}"
                />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_perception_activity_tree">
        <field name="name">Activities</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">perception.activity</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!--Window Action para Perceptions -->
    <record id="perception_perception_action_tree" model="ir.actions.act_window">
        <field name="name">Perception</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">perception.perception</field>
        <field
            name="help"
        >Here you can define Perceptions and their configuration to be used in Customer Invoices or Supplier Invoices</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record
        id="perception_perception_action_tree_view"
        model="ir.actions.act_window.view"
    >
        <field eval="20" name="sequence" />
        <field name="view_mode">tree</field>
        <field name="view_id" ref="perception_perception_view_tree" />
        <field name="act_window_id" ref="perception_perception_action_tree" />
    </record>

    <record id="perception_tax_line_action_tree" model="ir.actions.act_window">
        <field name="name">Perception Tax Applied</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">perception.tax.line</field>
        <field name="view_id" ref="perception_tax_line_view_tree" />
        <field name="context">
            {"search_default_applied":1, "use_internal_number": 1}</field>
        <field name="domain">
            [('invoice_id.state','in',['open','paid'])]</field>
        <field name="search_view_id" ref="perception_tax_line_view_search" />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a perception.
            </p>
        </field>
    </record>

    <record
        id="perception_tax_line_action_tree_supported"
        model="ir.actions.act_window"
    >
        <field name="name">Perception Tax Supported</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">perception.tax.line</field>

        <field name="view_id" ref="perception_tax_line_view_tree" />
        <field name="context">
            {"search_default_supported":1, "use_internal_number": 1}</field>
        <field name="domain">
            [('invoice_id.state','in',['open','paid'])]</field>
        <field name="search_view_id" ref="perception_tax_line_view_search" />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a perception.
            </p>
        </field>
    </record>
</odoo>
