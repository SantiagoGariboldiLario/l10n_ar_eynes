<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_checkbook_view_tree" model="ir.ui.view">
        <field name="name">account.checkbook.view.tree</field>
        <field name="model">account.payment.method.line</field>
        <field name="arch" type="xml">
            <tree string="Checkbooks" create="false" edit="false">
                <field name="number" />
                <field name="journal_id" />
                <field name="bank_account_id" />
                <field name="bank_id" />
                <field name="format" />
                <field name="account_check_id" />
            </tree>
        </field>
    </record>

    <record id="account_checkbook_action" model="ir.actions.act_window">
        <field name="name">Checkbooks</field>
        <field name="res_model">account.payment.method.line</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('code', '=', 'check_printing')]</field>
        <field name="view_id" ref="account_checkbook_view_tree"/>
    </record>
</odoo>
