<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_arba_generated_files_tree" model="ir.ui.view">
        <field name="name">arba.generated.files.tree</field>
        <field name="model">arba.generated.files</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="ARBA generated files" create="false" edit="false">
                <field name="code" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="attachment_id" />
            </tree>
        </field>
    </record>

    <record id="action_arba_generated_files" model="ir.actions.act_window">
        <field name="name">ARBA generated files</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">arba.generated.files</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem parent="menu_taxes_reports" id="menu_arba" name="ARBA" sequence="3" />

    <menuitem
        id="menu_action_arba_generated_files"
        name="ARBA generated files"
        action="action_arba_generated_files"
        parent="menu_arba"
    />
</odoo>
