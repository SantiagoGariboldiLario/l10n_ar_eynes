<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_view_tax_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">account.tax.view.form.inherit</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <field name="group_type" invisible="True" />
                <page string="Retentions" invisible="group_type != 'retention'">
                    <group>
                        <group string="Jurisdiction Information">
                            <field name="jurisdiccion" select="1" />
                            <field
                                name="state_id"
                                select="1"
                                invisible="jurisdiccion != 'provincial'"
                                required="jurisdiccion == 'provincial'"
                            />
                            <field
                                name="applicable_state"
                                invisible="jurisdiccion != 'provincial'"
                                required="jurisdiccion == 'provincial'"
                            />
                            <field name="from_register_ARBA" invisible="jurisdiccion != 'provincial'" />
                            <field name="from_register_AGIP" invisible="jurisdiccion != 'provincial'" />
                        </group>
                        <group string="Usability Configuration" invisible="jurisdiccion != 'provincial'">
                            <field name="check_sit_iibb" />
                            <field name="always_apply_padron" />
                            <field name="is_bank_settlement" />
                            <field name="inform_arba" />
                            <field name="inform_arciba" />
                        </group>
                    </group>

                    <group col="6" string="Tax Application">
                        <field name="retention_type" />
                        <field name="is_for_voucher_with_legend" />
                        <field name="apply_custom_code" />
                        <field
                            name="python_code"
                            colspan="6"
                            widget="ace"
                            options="{'mode': 'python'}"
                            invisible="not apply_custom_code"
                            nolabel="1"
                        />
                        <field
                            name="retention_application_ids"
                            nolabel="1"
                            colspan="6"
                            invisible="apply_custom_code"
                            context="{'default_perception_tax_id': id}"
                        >
                            <tree>
                                <field name="retention_tax_id" column_invisible="True" />
                                <field name="reg_code" />
                                <field name="concept_id_domain" column_invisible="True" />
                                <field name="concept_id" domain="concept_id_domain" />
                                <field name="activity_id_domain" column_invisible="True" />
                                <field name="activity_id" domain="activity_id_domain" />
                                <field name="tax_allowance" />
                                <field name="exclude_tax_allowance" />
                                <field name="calculation_base" required="1" />
                                <field name="tax_minimum" />
                                <field name="aliq_type" required="1" />
                                <field name="percent" />
                                <field name="scale_id" />
                            </tree>
                            <form>
                                <group>
                                    <field name="retention_tax_id" invisible="True" />
                                    <field name="concept_id_domain" invisible="True" />
                                    <field name="concept_id" domain="concept_id_domain" />
                                    <field name="activity_id_domain" invisible="True" />
                                    <field name="activity_id" domain="activity_id_domain" />
                                    <field name="tax_allowance" />
                                    <field name="exclude_tax_allowance" />
                                    <field name="calculation_base" required="1" />
                                    <field name="tax_minimum" />
                                    <field name="aliq_type" required="1" />
                                    <field name="percent" invisible="aliq_type == 'scale'" />
                                    <field
                                        name="scale_id"
                                        required="aliq_type == 'scale'"
                                        invisible="aliq_type == 'percent'"
                                    />
                                    <field name="name" />
                                    <field name="reg_code" />
                                </group>
                            </form>
                        </field>
                    </group>

                    <group string="Other information">
                        <group>
                            <field name="general_resolution" string="General Resolution Associated" />
                            <field name="sequence_to_use" />
                        </group>
                        <newline />
                        <separator string="Notes" colspan="4" />
                        <field name="notes" nolabel="1" colspan="4" />
                    </group>
                </page>

                <page string="Perceptions" invisible="group_type != 'perception'">
                    <group>
                        <group string="Jurisdiction Information">
                            <field name="jurisdiccion" select="1" />
                            <field
                                name="state_id"
                                select="1"
                                invisible="jurisdiccion != 'provincial'"
                                required="jurisdiccion == 'provincial'"
                            />
                            <field
                                name="applicable_state"
                                invisible="jurisdiccion != 'provincial'"
                                required="jurisdiccion == 'provincial'"
                            />
                            <field name="from_register_ARBA" />
                            <field name="from_register_AGIP" />
                        </group>
                        <group string="Usability Configuration">
                            <field name="check_sit_iibb" invisible="jurisdiccion != 'provincial'" />
                            <field name="is_bank_settlement" />
                            <field name="always_apply_padron" />
                            <field name="inform_arba" />
                            <field name="inform_arciba" />
                        </group>
                    </group>

                    <group col="6" string="Tax Application">
                        <field name="retention_type" />
                        <field name="apply_custom_code" />
                        <separator name="tax_application" />
                        <field
                            name="python_code"
                            colspan="6"
                            widget="ace"
                            options="{'mode': 'python'}"
                            invisible="not apply_custom_code"
                            nolabel="1"
                        />
                        <field
                            name="perception_application_ids"
                            nolabel="1"
                            colspan="6"
                            invisible="apply_custom_code"
                            context="{'default_perception_tax_id': id}"
                        >
                            <tree>
                                <field name="perception_tax_id" column_invisible="True" />
                                <field name="reg_code" />
                                <field name="concept_id_domain" column_invisible="True" />
                                <field name="concept_id" domain="concept_id_domain" />
                                <field name="activity_id_domain" column_invisible="True" />
                                <field name="activity_id" domain="activity_id_domain" />
                                <field name="tax_allowance" />
                                <field name="exclude_tax_allowance" />
                                <field name="calculation_base" required="1" />
                                <field name="tax_minimum" />
                                <field name="percent" />
                            </tree>
                            <form>
                                <group>
                                    <field name="perception_tax_id" invisible="True" />
                                    <field name="concept_id_domain" invisible="True" />
                                    <field name="concept_id" domain="concept_id_domain" />
                                    <field name="activity_id_domain" invisible="True" />
                                    <field name="activity_id" domain="activity_id_domain" />
                                    <field name="tax_allowance" />
                                    <field name="exclude_tax_allowance" />
                                    <field name="calculation_base" required="1" />
                                    <field name="tax_minimum" />
                                    <field name="percent" />
                                    <field name="name" />
                                    <field name="reg_code" />
                                </group>
                            </form>
                        </field>
                    </group>
                    <group string="Other information">
                        <group>
                            <field name="general_resolution" string="General Resolution Associated" />
                            <field name="sequence_to_use" />
                        </group>
                        <newline />
                        <separator string="Notes" colspan="4" />
                        <field name="notes" nolabel="1" colspan="4" />
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
