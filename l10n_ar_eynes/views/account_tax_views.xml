<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_view_tax_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">account.tax.view.form.inherit</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="before">
                <field name="tax_group_name" invisible="1" />
            </xpath>

            <notebook position="inside">
                <page
                    string="Retentions"
                    attrs="{'invisible': [('tax_group_name', 'not in', ('Retentions', 'Retenciones'))]}"
                >
                    <group>
                        <group string="Jurisdiction Information">
                            <field name="jurisdiccion" select="1" />
                            <field
                                name="state_id"
                                select="1"
                                attrs="{'invisible':[('jurisdiccion','!=','provincial')], 'required':[('jurisdiccion','=','provincial')]}"
                            />
                            <field
                                name="applicable_state"
                                attrs="{'invisible':[('jurisdiccion','!=','provincial')], 'required':[('jurisdiccion','=','provincial')]}"
                            />
                            <field
                                name="from_register_ARBA"
                                attrs="{'invisible': [('jurisdiccion','!=','provincial')]}"
                            />
                            <field
                                name="from_register_AGIP"
                                attrs="{'invisible': [('jurisdiccion','!=','provincial')]}"
                            />
                        </group>
                        <group
                            string="Usability Configuration"
                            attrs="{'invisible':[('jurisdiccion','!=','provincial')]}"
                        >
                            <field name="check_sit_iibb" />
                            <field name="always_apply_padron" />
                            <field name="is_bank_settlement" />
                            <field name="inform_arba" />
                            <field name="inform_arciba" />
                        </group>
                    </group>

                    <group string="Tax Application" name="tax_application">
                        <group colspan="4" col="6">
                            <field name="retention_type" colspan="2" />
                        </group>
                        <field
                            name="vat_application_ids"
                            nolabel="1"
                            colspan="4"
                            attrs="{'invisible':[('retention_type','!=','vat')]}"
                            context="{'default_type':'vat'}"
                        >
                            <tree>
                                <field name="reg_code" />
                                <field name="concept_id" />
                                <field name="activity_id" />
                                <field name="tax_allowance" />
                                <field name="exclude_tax_allowance" />
                                <field name="calculation_base" required="1" />
                                <field name="tax_minimum" />
                                <field name="aliq_type" required="1" />
                                <field name="percent" />
                                <field name="scale_id" />
                                <field name="type" invisible="1" />
                            </tree>
                            <form string="VAT Tax Application">
                                <group>
                                    <field name="concept_id" domain="[('type', '=', 'vat')]" />
                                    <field name="activity_id" domain="[('type', '=', 'vat')]" />
                                    <field name="tax_allowance" />
                                    <field name="exclude_tax_allowance" />
                                    <field name="calculation_base" required="1" />
                                    <field name="tax_minimum" />
                                    <field name="aliq_type" required="1" />
                                    <field
                                        name="percent"
                                        attrs="{'invisible':[('aliq_type', '=', 'scale')]}"
                                    />
                                    <field
                                        name="scale_id"
                                        attrs="{'invisible':[('aliq_type', '=', 'percent')], 'required':[('aliq_type', '=', 'scale')]}"
                                    />
                                    <field name="name" />
                                    <field name="reg_code" />
                                    <field name="type" invisible="1" />
                                </group>
                            </form>
                        </field>
                        <field
                            name="gi_application_ids"
                            nolabel="1"
                            colspan="4"
                            attrs="{'invisible':[('retention_type','!=','gross_income')]}"
                            context="{'default_type':'gross_income'}"
                        >
                            <tree>
                                <field name="reg_code" />
                                <field name="concept_id" />
                                <field name="activity_id" />
                                <field name="tax_allowance" />
                                <field name="exclude_tax_allowance" />
                                <field name="calculation_base" required="1" />
                                <field name="tax_minimum" />
                                <field name="aliq_type" required="1" />
                                <field name="percent" />
                                <field name="scale_id" />
                                <field name="sit_iibb" />
                                <field name="type" invisible="1" />
                            </tree>
                            <form string="Gross Income Tax Application">
                                <group>
                                    <field name="concept_id" domain="[('type', '=', 'gross_income')]" />
                                    <field name="activity_id" domain="[('type', '=', 'gross_income')]" />
                                    <field name="tax_allowance" />
                                    <field name="exclude_tax_allowance" />
                                    <field name="calculation_base" required="1" />
                                    <field name="tax_minimum" />
                                    <field name="aliq_type" required="1" />
                                    <field
                                        name="percent"
                                        attrs="{'invisible':[('aliq_type', '=', 'scale')]}"
                                    />
                                    <field
                                        name="scale_id"
                                        attrs="{'invisible':[('aliq_type', '=', 'percent')], 'required':[('aliq_type', '=', 'scale')]}"
                                    />
                                    <field name="name" />
                                    <field name="reg_code" />
                                    <field name="sit_iibb" />
                                    <field name="type" invisible="1" />
                                </group>
                            </form>
                        </field>
                        <field
                            name="profit_application_ids"
                            nolabel="1"
                            colspan="4"
                            attrs="{'invisible':[('retention_type','!=','profit')]}"
                            context="{'default_type':'profit'}"
                        >
                            <tree>
                                <field name="reg_code" />
                                <field name="concept_id" />
                                <field name="activity_id" />
                                <field name="tax_allowance" />
                                <field name="exclude_tax_allowance" />
                                <field name="calculation_base" required="1" />
                                <field name="tax_minimum" />
                                <field name="aliq_type" required="1" />
                                <field name="percent" />
                                <field name="scale_id" />
                                <field name="type" invisible="1" />
                            </tree>
                            <form string="Profit Tax Application">
                                <group>
                                    <field name="concept_id" domain="[('type', '=', 'profit')]" />
                                    <field name="activity_id" domain="[('type', '=', 'profit')]" />
                                    <field name="tax_allowance" />
                                    <field name="exclude_tax_allowance" />
                                    <field name="calculation_base" required="1" />
                                    <field name="tax_minimum" />
                                    <field name="aliq_type" required="1" />
                                    <field
                                        name="percent"
                                        attrs="{'invisible':[('aliq_type', '=', 'scale')]}"
                                    />
                                    <field
                                        name="scale_id"
                                        attrs="{'invisible':[('aliq_type', '=', 'percent')], 'required':[('aliq_type', '=', 'scale')]}"
                                    />
                                    <field name="name" />
                                    <field name="reg_code" />
                                    <field name="type" invisible="1" />
                                </group>
                            </form>
                        </field>
                    </group>

                    <group string="Other information">
                        <group>
                            <field name="general_resolution" string="General Resolution Associated" />
                            <field name="sequence_to_use" />
                        </group>
                        <newline />
                        <separator string="Notes" colspan="4" />
                        <field name="notes" nolabel="1" colspan="4" />
                    </group>
                </page>

                <page
                    string="Perceptions"
                    attrs="{'invisible': [('tax_group_name', 'not in', ('Perceptions', 'Percepciones'))]}"
                >
                    <group>
                        <group string="Jurisdiction Information">
                            <field name="jurisdiccion" select="1" />
                            <field
                                name="state_id"
                                select="1"
                                attrs="{'invisible':[('jurisdiccion','!=','provincial')], 'required':[('jurisdiccion','=','provincial')]}"
                            />
                            <field
                                name="applicable_state"
                                attrs="{'invisible':[('jurisdiccion','!=','provincial')], 'required':[('jurisdiccion','=','provincial')]}"
                            />
                            <field name="from_register_ARBA" />
                            <field name="from_register_AGIP" />
                        </group>
                        <group string="Usability Configuration">
                            <field
                                name="check_sit_iibb"
                                attrs="{'invisible':[('jurisdiccion','!=','provincial')]}"
                            />
                            <field name="is_bank_settlement" />
                            <field name="always_apply_padron" />
                            <field name="inform_arba" />
                            <field name="inform_arciba" />
                        </group>
                    </group>

                    <group colspan="4" col="6" string="Tax Application">
                        <field name="retention_type" />
                        <field name="apply_custom_code" />
                        <separator name="tax_application" />
                        <field
                            name="python_code"
                            colspan="6"
                            widget="ace"
                            options="{'mode': 'python'}"
                            attrs="{'invisible':[('apply_custom_code', '=', False)]}"
                            nolabel="1"
                        />
                        <field
                            name="perc_vat_application_ids"
                            nolabel="1"
                            colspan="6"
                            attrs="{'invisible':['|', ('retention_type','!=','vat'), ('apply_custom_code', '=', True)]}"
                            context="{'default_type':'vat'}"
                        >
                            <tree>
                                <field name="reg_code" />
                                <field name="concept_id" />
                                <field name="activity_id" />
                                <field name="tax_allowance" />
                                <field name="exclude_tax_allowance" />
                                <field name="calculation_base" required="1" />
                                <field name="tax_minimum" />
                                <field name="percent" />
                                <field name="type" invisible="1" />
                            </tree>
                            <form string="VAT Tax Application">
                                <group>
                                    <field name="concept_id" domain="[('type', '=', 'vat')]" />
                                    <field name="activity_id" domain="[('type', '=', 'vat')]" />
                                    <field name="tax_allowance" />
                                    <field name="exclude_tax_allowance" />
                                    <field name="calculation_base" required="1" />
                                    <field name="tax_minimum" />
                                    <field name="percent" />
                                    <field name="name" />
                                    <field name="reg_code" />
                                    <field name="type" invisible="1" />
                                </group>
                            </form>
                        </field>
                        <field
                            name="perc_gi_application_ids"
                            nolabel="1"
                            colspan="4"
                            attrs="{'invisible':['|', ('retention_type','!=','gross_income'), ('apply_custom_code', '=', True)]}"
                            context="{'default_type':'gross_income'}"
                        >
                            <tree>
                                <field name="reg_code" />
                                <field name="concept_id" />
                                <field name="activity_id" />
                                <field name="tax_allowance" />
                                <field name="exclude_tax_allowance" />
                                <field name="calculation_base" required="1" />
                                <field name="tax_minimum" />
                                <field name="percent" />
                                <field name="sit_iibb" />
                                <field name="type" invisible="1" />
                            </tree>
                            <form string="Gross Income Tax Application">
                                <group>
                                    <field name="concept_id" domain="[('type', '=', 'gross_income')]" />
                                    <field name="activity_id" domain="[('type', '=', 'gross_income')]" />
                                    <field name="tax_allowance" />
                                    <field name="exclude_tax_allowance" />
                                    <field name="calculation_base" required="1" />
                                    <field name="tax_minimum" />
                                    <field name="percent" />
                                    <field name="name" />
                                    <field name="reg_code" />
                                    <field name="sit_iibb" />
                                    <field name="type" invisible="1" />
                                </group>
                            </form>
                        </field>
                        <field
                            name="perc_profit_application_ids"
                            nolabel="1"
                            colspan="4"
                            attrs="{'invisible':['|', ('retention_type','!=','profit'), ('apply_custom_code', '=', True)]}"
                            context="{'default_type':'profit'}"
                        >
                            <tree>
                                <field name="reg_code" />
                                <field name="concept_id" />
                                <field name="activity_id" />
                                <field name="tax_allowance" />
                                <field name="exclude_tax_allowance" />
                                <field name="calculation_base" required="1" />
                                <field name="tax_minimum" />
                                <field name="percent" />
                                <field name="type" invisible="1" />
                            </tree>
                            <form string="Profit Tax Application">
                                <group>
                                    <field name="concept_id" domain="[('type', '=', 'profit')]" />
                                    <field name="activity_id" domain="[('type', '=', 'profit')]" />
                                    <field name="tax_allowance" />
                                    <field name="exclude_tax_allowance" />
                                    <field name="calculation_base" required="1" />
                                    <field name="tax_minimum" />
                                    <field name="percent" />
                                    <field name="name" />
                                    <field name="reg_code" />
                                    <field name="type" invisible="1" />
                                </group>
                            </form>
                        </field>
                    </group>

                    <group string="Other information">
                        <group>
                            <field name="general_resolution" string="General Resolution Associated" />
                            <field name="sequence_to_use" />
                        </group>
                        <newline />
                        <separator string="Notes" colspan="4" />
                        <field name="notes" nolabel="1" colspan="4" />
                    </group>
                </page>
            </notebook>

        </field>
    </record>

</odoo>
