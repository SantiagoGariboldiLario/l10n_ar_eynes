<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="other_payment_view_form" model="ir.ui.view">
        <field name="name">account.payment.order.other.payment.form</field>
        <field name="model">account.payment.order</field>
        <field name="arch" type="xml">
        <form string="Other Payment">
            <header invisible="context.get('line_type', False)">
                <button
                        name="proforma_voucher"
                        string="Validate"
                        class="oe_highlight"
                        type="object"
                        states="draft"
                    />
                <button name="cancel_voucher" string="Cancel Receipt" type="object" states="draft,proforma" />
                <button
                        name="cancel_voucher"
                        string="Unreconcile"
                        type="object"
                        states="posted"
                        confirm="Are you sure to unreconcile and cancel this record ?"
                    />
                <button name="action_cancel_draft" type="object" states="cancel" string="Set to Draft" />
                <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,posted"
                        type="object"
                        statusbar_colors='{"proforma":"blue"}'
                    />
            </header>
            <sheet>
                <h1 attrs="{'invisible': [('number','=',False)]}">
                    <field name="number" attrs="{'readonly': [('state', 'not in', ('draft',))]}" />
                </h1>
                <group invisible="context.get('line_type', False)">
                    <group>
                        <field name="employee_payment" invisible="1" />
                        <field
                                name="partner_id"
                                context="{'search_default_customer': 1}"
                                attrs="{
                                'readonly': [
                                    '&amp;',
                                    ('state', 'not in', ('draft')),
                                    ('employee_payment','=',False)
                                ],
                                'invisible': [('employee_payment','=',True)]
                            }"
                            />
                        <field
                                name="employee_id"
                                attrs="{
                                'readonly': [
                                    '&amp;',
                                    ('state', 'not in', ('draft')),
                                    ('employee_payment','=',True)
                                ],
                                'invisible': [('employee_payment','=', False)]
                            }"
                            />
                        <field name="currency_id" invisible="1" />
                        <field name="company_currency" invisible="1" readonly="1" />
                        <field
                                name="journal_id"
                                string="Journal"
                                options="{'no_quick_create': True, 'no_create': True, 'no_create_edit': True}"
                                attrs="{'readonly': [('state', 'not in', ('draft',))]}"
                            />
                        <field name="other_payment" invisible="1" />
                        <field
                                name="amount"
                                class="oe_inline"
                                string="Paid Amount"
                                widget="monetary"
                                options="{'currency_field': 'company_currency'}"
                                force_save="True"
                                attrs="{'readonly': True}"
                            />
                    </group>
                    <group>
                        <field name="date" attrs="{'readonly': [('state', 'not in', ('draft',))]}" />
                        <field
                                name="reference"
                                string="Payment Ref"
                                placeholder="e.g. 003/10"
                                attrs="{'readonly': [('state', 'not in', ('draft',))]}"
                            />
                        <field
                                name="name"
                                colspan="2"
                                placeholder="e.g. Invoice SAJ/0042"
                                attrs="{'readonly': [('state', 'not in', ('draft',))]}"
                            />
                        <field name="company_id" readonly="1" groups="base.group_multi_company" />
                        <field
                                name="account_id"
                                widget="selection"
                                invisible="True"
                                attrs="{'readonly': [('state', 'not in', ('draft',))]}"
                            />
                        <field name="pre_line" invisible="1" />
                        <field
                                name="type"
                                invisible="1"
                                attrs="{'readonly': [('state', 'not in', ('draft',))]}"
                            />
                        <field name="currency_id" attrs="{'readonly': True}" force_save="True" />
                    </group>
                    <group attrs="{'invisible':[('is_multi_currency','=',False)]}">
                        <field name="is_multi_currency" invisible="1" />
                        <label for="payment_rate" colspan="1" />
                        <div>
                            <field
                                    name="payment_rate"
                                    required="1"
                                    class="oe_inline"
                                    attrs="{'readonly': [('state', 'not in', ('draft',))]}"
                                />
                            <field
                                    name="payment_rate_currency_id"
                                    class="oe_inline"
                                    attrs="{'readonly': [('state', 'not in', ('draft',))]}"
                                    groups="base.group_multi_currency"
                                />
                        </div>
                    </group>
                    <group col="2">
                        <separator string="Payment Options" colspan="2" />
                        <field
                                name="writeoff_amount"
                                widget="monetary"
                                options="{'currency_field': 'company_currency'}"
                            />
                        <field
                                name="payment_option"
                                required="1"
                                attrs="{
                                'invisible': [('writeoff_amount','=',0)],
                                'readonly': [('state', '!=', 'draft')]
                            }"
                            />
                        <field
                                name="writeoff_acc_id"
                                attrs="{
                                'invisible': [
                                    '|',
                                    ('payment_option','!=','with_writeoff'),
                                    ('writeoff_amount','=',0)
                                ],
                                'required': [('payment_option','=','with_writeoff')],
                                'readonly': [('state', '!=', 'draft')]
                            }"
                                domain="[('user_type_id.type','=','other')]"
                            />
                        <field
                                name="comment"
                                attrs="{
                                'invisible': [
                                    '|',
                                    ('payment_option','!=','with_writeoff'),
                                    ('writeoff_amount','=',0)
                                ],
                                'readonly': [('state', '!=', 'draft')]
                            }"
                            />
                        <field
                                name="analytic_id"
                                groups="analytic.group_analytic_accounting"
                                attrs="{
                                'invisible': [
                                    '|',
                                    ('payment_option','!=','with_writeoff'),
                                    ('writeoff_amount','=',0)
                                ],
                                'readonly': [('state', '!=', 'draft')]
                            }"
                            />
                    </group>
                </group>
                <notebook>
                    <page string="Payment Information" name="payment_information" groups="base.group_user">
                        <label for="payment_mode_line_ids" />
                        <field
                                name="payment_mode_line_ids"
                                attrs="{'readonly': [('state', 'not in', ('draft',))]}"
                            >
                            <tree editable="bottom" decoration-muted="amount == 0">
                                <field
                                        name="payment_mode_id"
                                        invisible="0"
                                        attrs="{'required': True}"
                                        domain="[('type', 'in', ['cash', 'bank']), ('company_id', '=', parent.company_id)]"
                                    />
                                <field name="name" invisible="1" />
                                <field name="currency_id" readonly="1" force_save="True" invisible="True" />
                                <field name="date" />
                                <field name="payment_order_id" invisible="1" />
                                <field
                                        name="amount"
                                        sum="Total"
                                        widget="monetary"
                                        options="{'currency_field': 'original_currency_id'}"
                                    />
                                <field
                                        name="amount_currency"
                                        sum="Total Allocation CCY"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}"
                                        attrs="{'column_invisible':[('parent.is_multi_currency','=',False)]}"
                                        groups="base.group_multi_currency"
                                    />
                            </tree>
                        </field>
                        <label for="concept_line_ids" />
                        <field
                                name="concept_line_ids"
                                context="{'journal_id':journal_id}"
                                attrs="{'readonly': [('state', 'not in', ('draft',))]}"
                            >
                            <tree editable="bottom">
                                <field name="name" />
                                <field name="account_id" />
                                <field name="journal_id" domain="[('type', 'in', ['bank', 'cash'])]" />
                                <field name="amount" />
                                <field
                                        name="account_analytic_id"
                                        groups="analytic.group_analytic_accounting"
                                    />
                            </tree>
                        </field>
                        <group col="3">
                            <group>
                                <field
                                        name="narration"
                                        colspan="2"
                                        nolabel="1"
                                        attrs="{'readonly': [('state', 'not in', ('draft',))]}"
                                    />
                            </group>
                        </group>
                    </page>
                    <page string="Checks">
                        <field name="issued_check_ids" string="Issued Checks" nolabel="1" colspan="4">
                            <tree>
                                <field name="number" />
                                <field name="type" />
                                <field name="issue_date" />
                                <field name="payment_date" />
                                <field name="bank_id" />
                                <field name="amount" sum="Total Amount" />
                            </tree>
                            <form string="Issued Checks">
                                <group>
                                    <group>
                                        <field name="number" invisible="1" />
                                        <field name="checkbook_id" required="1" />
                                        <!-- <field name="check_id" attrs="{'readonly': [('state','in',['issued','cancel'])]}"
                                            domain="[('state', '=', 'draft'), ('checkbook_id', '=?', checkbook_id)]"/> -->
                                        <field name="type" readonly="1" />
                                        <field name="amount" />
                                        <field name="bank_id" invisible="1" />
                                        <field name="company_id" invisible="0" />
                                    </group>
                                    <group>
                                        <field name="issue_date" />
                                        <field
                                                name="payment_date"
                                                attrs="{'invisible': [('type', '=', 'common')],
                                            'required': [('type', '=', 'postdated')]}"
                                            />
                                        <!-- <field name="account_bank_id" domain="[('company_id', '=', company_id)]" required="1" readonly="1"/> -->
                                        <field name="clearing" />
                                        <field name="signatory" />
                                        <field name="origin" />
                                        <field name="issued_check_state" invisible="1" />
                                        <field name="crossed" />
                                        <field name="not_order" />
                                    </group>
                                </group>
                                <field name="receiving_partner_id" invisible="1" />
                            </form>
                        </field>
                        <label for="third_party_check_ids" />
                        <field
                                name="third_party_check_ids"
                                string="Third Checks"
                                nolabel="1"
                                colspan="4"
                                domain="[('internal_type', '=', 'third_party'), ('third_party_check_state', '=', 'wallet')]"
                            >
                            <tree>
                                <field name="number" />
                                <field name="source_partner_id" />
                                <field name="issue_date" />
                                <field name="payment_date" />
                                <field name="bank_id" />
                                <field name="origin" />
                                <field name="amount" sum="Total" />
                                <field name="third_party_check_state" invisible="1" />
                            </tree>
                        </field>
                    </page>
                    <page
                            string="Journal Items"
                            name="journal_items"
                            attrs="{'invisible': [('state','!=','posted')]}"
                        >
                        <group col="4">
                            <!-- TODO: Este campo era un related a 'to_check' en account.move pero ya no existe mas -->
                            <!-- <field name="audit"/> -->
                            <field name="move_id" />
                        </group>
                        <field name="move_line_ids" readonly="1">
                            <tree>
                                <field name="move_id" />
                                <field name="ref" />
                                <field name="date" />
                                <field name="statement_id" />
                                <field name="partner_id" />
                                <field name="account_id" />
                                <field name="name" />
                                <field name="debit" />
                                <field name="credit" />
                                <field
                                        name="amount_currency"
                                        widget="monetary"
                                        options="{'currency_field': 'original_currency_id'}"
                                        attrs="{'column_invisible':[('parent.is_multi_currency','=',False)]}"
                                    />
                                <field name="currency_id" groups="base.group_multi_currency" />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <div class="oe_chatter" invisible="context.get('line_type', False)">
                <field name="message_follower_ids" widget="mail_followers" />
                <field name="message_ids" widget="mail_thread" />
</div>
        </form>
        </field>
    </record>

    <record id="other_receipts_action" model="ir.actions.act_window">
        <field name="name">Other Receipts</field>
        <field name="res_model">account.payment.order</field>
        <field name="view_mode">tree,form</field>
        <field
            name="domain"
        >[('journal_id.type','=','receipt'), ('type','=','receipt'), ('other_payment', '=', True)]</field>
        <field
            name="context"
        >{'default_type': 'receipt', 'type': 'receipt', 'default_other_payment': True}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('account_payment_order_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('other_payment_view_form')})]"
        />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to register a receipt.
                </p><p>
                Other ways of getting receipts.
            </p>
        </field>
    </record>

    <record id="other_payments_action" model="ir.actions.act_window">
        <field name="name">Other Payments</field>
        <field name="res_model">account.payment.order</field>
        <field name="view_mode">tree,form</field>
        <field
            name="domain"
        >[('journal_id.type','=','payment'), ('type','=','payment'), ('other_payment', '=', True), ('employee_payment', '=', False)]</field>
        <field
            name="context"
        >{'default_type': 'payment', 'type': 'payment', 'default_other_payment': True}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('account_payment_order_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('other_payment_view_form')})]"
        />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to register a purchase receipt.
                </p><p>
                When the purchase receipt is confirmed, you can record the
                supplier payment related to this purchase receipt.
            </p>
        </field>
    </record>

    <menuitem
        id="other_payments_menu"
        name="Other Payments"
        action="other_payments_action"
        parent="account.menu_finance_payables"
        sequence="5"
    />

    <menuitem
        id="other_receipts_menu"
        name="Other Receipts"
        action="other_receipts_action"
        parent="account.menu_finance_receivables"
        sequence="5"
    />

</odoo>
