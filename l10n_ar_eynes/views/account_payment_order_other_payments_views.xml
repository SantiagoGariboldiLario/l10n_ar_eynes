<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="other_payment_view_form" model="ir.ui.view">
        <field name="name">account.payment.order.other.payment.form</field>
        <field name="model">account.payment.order</field>
        <field name="arch" type="xml">
        <form string="Other Payment">
            <header invisible="context.get('line_type', False)">
                <button
                        name="proforma_voucher"
                        string="Validate"
                        class="oe_highlight"
                        type="object"
                        invisible="state != 'draft'"
                    />
                <button
                        name="cancel_voucher"
                        string="Cancel Receipt"
                        type="object"
                        invisible="state not in ('draft', 'proforma')"
                    />
                <button
                        name="cancel_voucher"
                        string="Unreconcile"
                        type="object"
                        invisible="state != 'posted'"
                        confirm="Are you sure to unreconcile and cancel this record ?"
                    />
                <button
                        name="action_cancel_draft"
                        type="object"
                        invisible="state != 'cancel'"
                        string="Set to Draft"
                    />
                <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,posted,cancel"
                        type="object"
                        statusbar_colors='{"proforma":"blue"}'
                    />
            </header>
            <sheet>
                <h1 invisible="not number">
                    <field name="number" readonly="state != 'draft'" />
                </h1>
                <group invisible="context.get('line_type', False)">
                    <group>
                        <field name="employee_payment" invisible="True" />
                        <field
                                name="partner_id"
                                context="{'search_default_customer': 1}"
                                readonly="state != 'draft' and not employee_payment"
                                invisible="employee_payment"
                            />
                        <field
                                name="employee_id"
                                readonly="state != 'draft' and employee_payment"
                                invisible="not employee_payment"
                            />
                        <field name="currency_id" invisible="True" />
                        <field name="company_currency" invisible="True" readonly="True" />
                        <field name="journal_id_domain" invisible="True" />
                        <field
                                name="journal_id"
                                string="Journal"
                                options="{'no_quick_create': True, 'no_create': True, 'no_create_edit': True}"
                                readonly="state != 'draft'"
                                domain="journal_id_domain"
                            />
                        <field name="other_payment" invisible="True" />
                        <field
                                name="amount"
                                class="oe_inline"
                                string="Paid Amount"
                                widget="monetary"
                                options="{'currency_field': 'company_currency'}"
                                force_save="True"
                                readonly="True"
                            />
                    </group>
                    <group>
                        <field name="date" readonly="state != 'draft'" />
                        <field
                                name="reference"
                                string="Payment Ref"
                                placeholder="e.g. 003/10"
                                readonly="state != 'draft'"
                            />
                        <field
                                name="name"
                                colspan="2"
                                placeholder="e.g. Invoice SAJ/0042"
                                readonly="state != 'draft'"
                            />
                        <field name="company_id" readonly="True" groups="base.group_multi_company" />
                        <field name="company_id" invisible="True" />
                        <field
                                name="account_id"
                                widget="selection"
                                invisible="True"
                                readonly="state != 'draft'"
                            />
                        <field name="pre_line" invisible="True" />
                        <field name="type" invisible="True" readonly="state != 'draft'" />
                        <field name="currency_id" readonly="True" force_save="True" />
                    </group>
                    <group invisible="not is_multi_currency">
                        <field name="is_multi_currency" invisible="True" />
                        <label for="payment_rate" colspan="1" />
                        <div>
                            <field
                                    name="payment_rate"
                                    required="True"
                                    class="oe_inline"
                                    readonly="state != 'draft'"
                                />
                            <field
                                    name="payment_rate_currency_id"
                                    class="oe_inline"
                                    readonly="state != 'draft'"
                                    groups="base.group_multi_currency"
                                />
                        </div>
                    </group>
                    <group col="2">
                        <separator string="Payment Options" colspan="2" />
                        <field
                                name="writeoff_amount"
                                widget="monetary"
                                options="{'currency_field': 'company_currency'}"
                            />
                        <field
                                name="payment_option"
                                required="True"
                                invisible="writeoff_amount == 0"
                                readonly="state != 'draft'"
                            />
                        <field
                                name="writeoff_acc_id"
                                invisible="writeoff_amount == 0 or payment_option != 'with_writeoff'"
                                required="payment_option == 'with_writeoff'"
                                readonly="state != 'draft'"
                                domain="[('account_type','=','income_other')]"
                            />
                        <field
                                name="comment"
                                invisible="writeoff_amount == 0 or payment_option != 'with_writeoff'"
                                readonly="state != 'draft'"
                            />
                        <field
                                name="analytic_id"
                                groups="analytic.group_analytic_accounting"
                                invisible="writeoff_amount == 0 or payment_option != 'with_writeoff'"
                                readonly="state != 'draft'"
                            />
                    </group>
                </group>
                <notebook>
                    <page string="Payment Information" name="payment_information" groups="base.group_user">
                        <label for="payment_mode_line_ids" />
                        <field name="payment_mode_line_ids" readonly="state != 'draft'">
                            <list editable="bottom" decoration-muted="amount == 0">
                                <field
                                        name="payment_mode_id"
                                        invisible="0"
                                        required="True"
                                        domain="[('type', 'in', ['cash', 'bank']), ('company_id', '=', parent.company_id)]"
                                    />
                                <field name="name" invisible="True" />
                                <field
                                        name="currency_id"
                                        readonly="True"
                                        force_save="True"
                                        invisible="True"
                                    />
                                <field name="date" />
                                <field name="payment_order_id" invisible="True" />
                                <field
                                        name="amount"
                                        sum="Total"
                                        widget="monetary"
                                        options="{'currency_field': 'original_currency_id'}"
                                    />
                                <field
                                        name="amount_currency"
                                        sum="Total Allocation CCY"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}"
                                        column_invisible="not parent.is_multi_currency"
                                        groups="base.group_multi_currency"
                                    />
                            </list>
                        </field>
                        <label for="concept_line_ids" />
                        <field
                                name="concept_line_ids"
                                context="{'journal_id':journal_id}"
                                readonly="state != 'draft'"
                            >
                            <list editable="bottom">
                                <field name="name" />
                                <field name="account_id" />
                                <field name="journal_id" domain="[('type', 'in', ['bank', 'cash'])]" />
                                <field name="amount" />
                                <field
                                        name="account_analytic_id"
                                        groups="analytic.group_analytic_accounting"
                                    />
                            </list>
                        </field>
                        <group col="3">
                            <group>
                                <field
                                        name="narration"
                                        colspan="2"
                                        nolabel="True"
                                        readonly="state != 'draft'"
                                    />
                            </group>
                        </group>
                    </page>
                    <page string="Checks">
                        <!-- ******************************* COBROS ********************************* -->
                        <field
                                name="third_party_check_receipt_ids"
                                string="Third Checks"
                                nolabel="1"
                                colspan="4"
                                context="{'default_internal_type': 'third_party'}"
                                readonly="state != 'draft'"
                                invisible="type == 'payment'"
                            >
                            <list>
                                <field name="number" />
                                <field name="reception_date" />
                                <field name="issue_date" />
                                <field name="payment_date" />
                                <field name="bank_id" />
                                <field name="type" />
                                <field name="amount" sum="Total" />
                                <field name="third_party_check_state" />
                            </list>
                            <form string="Third Checks">
                                <field name="source_partner_id" invisible="1" />
                                <group>
                                    <group>
                                        <field name="source_payment_order_id" invisible="1" />
                                        <field
                                                name="journal_id"
                                                domain="[('type', '=', 'third_party_checks')]"
                                            />
                                        <field name="internal_type" invisible="1" />
                                        <field name="number" />
                                        <field name="type" />
                                        <field name="checkbook_format" />
                                        <field name="amount" required="1" />
                                        <field name="bank_id" required="1" />
                                        <field name="crossed" />
                                        <field name="not_order" />
                                    </group>
                                    <group>
                                        <field name="reception_date" required="1" />
                                        <field name="issue_date" required="1" />
                                        <field
                                                name="payment_date"
                                                invisible="type == 'common'"
                                                required="type == 'deferred'"
                                            />
                                        <field name="clearing" />
                                        <field name="signatory" />
                                        <field name="signatory_vat" />
                                        <field name="signatory_account" />
                                    </group>
                                </group>
                                <field name="third_party_check_state" invisible="1" />
                            </form>
                        </field>
                        <!-- ******************************* FIN COBROS ********************************* -->

                        <!-- ********************************* PAGOS ********************************* -->
                        <label for="issued_check_line_ids" invisible="type == 'receipt'" />
                        <field
                                name="issued_check_line_ids"
                                nolabel="True"
                                colspan="4"
                                readonly="state != 'draft'"
                                invisible="type == 'receipt'"
                            >
                            <list>
                                <field name="issued_check_id" />
                                <field name="type" />
                                <field name="issue_date" />
                                <field name="payment_date" />
                                <field name="bank_id" />
                                <field name="amount" sum="Total Amount" />
                                <field
                                        name="amount_currency"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}"
                                        column_invisible="not parent.is_multi_currency"
                                        sum="Total Amount"
                                    />
                            </list>
                            <form string="Issued Checks">
                                <group>
                                    <group>
                                        <field name="journal_id" required="True" />
                                        <field
                                                name="checkbook_id"
                                                domain="[('journal_id', '=', journal_id), ('payment_method_id.code', '=', 'checks')]"
                                            />
                                        <field
                                                name="issued_check_id"
                                                options="{
                                                'no_create_edit': True,
                                                'no_create':True,
                                                'no_open':True,
                                            }"
                                                domain="[
                                                ('internal_type', '=', 'issued'),
                                                ('issued_check_state', '=', 'draft'),
                                                ('checkbook_id', '=', checkbook_id),
                                                ('payment_order_id', '=', False)
                                            ]"
                                                context="{
                                                'default_internal_type': 'issued',
                                                'default_checkbook_id': checkbook_id,
                                                'default_journal_id': journal_id,
                                                'default_amount': amount,
                                                'default_issue_date': issue_date,
                                                'default_crossed': crossed,
                                                'default_signatory': signatory,
                                                'default_checkbook_format': checkbook_format,
                                                'default_clearing': clearing,
                                                'default_origin': origin,
                                                'default_not_order': not_order,
                                            }"
                                            />
                                        <field name="type" />
                                        <field name="checkbook_format" />
                                        <field name="amount" />
                                    </group>
                                    <group>
                                        <field name="issue_date" required="type == 'deferred'" />
                                        <field
                                                name="payment_date"
                                                invisible="type == 'common'"
                                                required="type == 'deferred'"
                                            />
                                        <field name="clearing" />
                                        <field name="signatory" />
                                        <field name="origin" />
                                        <field name="crossed" />
                                        <field name="not_order" />
                                    </group>
                                </group>
                            </form>
                        </field>
                        <label for="third_party_check_ids" invisible="type == 'receipt'" />
                        <field
                                name="third_party_check_ids"
                                string="Third Party Checks"
                                nolabel="1"
                                invisible="type == 'receipt'"
                                colspan="4"
                                readonly="state != 'draft'"
                                domain="[
                                ('internal_type', '=', 'third_party'),
                                ('third_party_check_state', '=', 'in_wallet'),
                                ('company_id', '=', company_id)
                            ]"
                                context="{'tree_view_ref': 'l10n_ar_eynes.account_third_party_check_view_tree'}"
                            >
                            <list create="false">
                                <field name="currency_id" column_invisible="1" />
                                <field name="number" />
                                <field name="source_partner_id" />
                                <field name="issue_date" />
                                <field name="payment_date" />
                                <field name="bank_id" />
                                <field name="origin" />
                                <field name="amount" sum="Total" />
                                <field
                                        name="amount_currency"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}"
                                        column_invisible="not parent.is_multi_currency"
                                        sum="Total Amount"
                                    />
                                <field name="third_party_check_state" column_invisible="1" />
                            </list>
                        </field>
                        <!-- ********************************* FIN PAGOS ********************************* -->
                    </page>
                    <page string="Journal Items" name="journal_items" invisible="state != 'posted'">
                        <group col="4">
                            <field name="move_id" />
                        </group>
                        <field name="move_line_ids" readonly="True">
                            <list>
                                <field name="move_id" />
                                <field name="ref" />
                                <field name="date" />
                                <field name="statement_id" />
                                <field name="partner_id" />
                                <field name="account_id" />
                                <field name="name" />
                                <field name="debit" />
                                <field name="credit" />
                                <field
                                        name="amount_currency"
                                        widget="monetary"
                                        options="{'currency_field': 'original_currency_id'}"
                                        column_invisible="not parent.is_multi_currency"
                                    />
                                <field name="currency_id" groups="base.group_multi_currency" />
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <chatter invisible="context.get('line_type', False)"/>
        </form>
        </field>
    </record>

    <record id="other_receipts_action" model="ir.actions.act_window">
        <field name="name">Other Receipts</field>
        <field name="res_model">account.payment.order</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('journal_id.type','=','receipt'), ('type','=','receipt'), ('other_payment', '=', True)]</field>
        <field
            name="context"
        >{'default_type': 'receipt', 'type': 'receipt', 'default_other_payment': True}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('account_payment_order_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('other_payment_view_form')})]"
        />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to register a receipt.
                </p><p>
                Other ways of getting receipts.
            </p>
        </field>
    </record>

    <record id="other_payments_action" model="ir.actions.act_window">
        <field name="name">Other Payments</field>
        <field name="res_model">account.payment.order</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('journal_id.type','=','payment'), ('type','=','payment'), ('other_payment', '=', True), ('employee_payment', '=', False)]</field>
        <field
            name="context"
        >{'default_type': 'payment', 'type': 'payment', 'default_other_payment': True}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('account_payment_order_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('other_payment_view_form')})]"
        />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to register a purchase receipt.
                </p><p>
                When the purchase receipt is confirmed, you can record the
                supplier payment related to this purchase receipt.
            </p>
        </field>
    </record>

    <menuitem
        id="other_payments_menu"
        name="Other Payments"
        action="other_payments_action"
        parent="account.menu_finance_payables"
        sequence="5"
    />

    <menuitem
        id="other_receipts_menu"
        name="Other Receipts"
        action="other_receipts_action"
        parent="account.menu_finance_receivables"
        sequence="5"
    />
</odoo>
