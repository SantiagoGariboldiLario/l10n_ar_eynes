<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_view_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit.</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="/form/header//button[@name='%(stock.act_stock_return_picking)d']" position="after">
                <button
                    name="%(act_stock_cancel_done_picking)d"
                    string="Cancel"
                    invisible="state != 'done'"
                    type="action"
                />
            </xpath>
            <xpath expr="//field[@name='priority']" position="after">
                <field name="renum_pick_id" invisible="[('picking_type_code', '!=', 'outgoing')]" />
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="name_original" />
            </xpath>
            <xpath expr="//field[@name='scheduled_date']" position="after">
                <field
                    name="cot_date"
                    invisible="['|',('voucher','=', False),('pick_type','!=','outgoing')]"
                />
                <field name="pick_type" invisible="False" />
            </xpath>
            <xpath expr="//field[@name='group_id']" position="after">
                <field
                    name="shipping_number"
                    invisible="[('picking_type_code', '!=', 'incoming')]"
                    readonly="False"
                />
            </xpath>
            <field name="partner_id" invisible="False" />
            <field name="origin" position="after">
                <field name="is_origin" readonly="[('voucher','!=', False)]" />
            </field>
            <xpath expr="/form/header/field[@name='state']" position="before">
                <button
                    name="do_cot_file"
                    type="object"
                    string="Generate COT"
                    class="oe_highlight"
                    invisible="[
                        '|',
                        '|',
                        '|',
                        ('pick_type', '!=', 'outgoing'),
                        ('state', '!=', 'done'),
                        ('voucher', '!=', False),
                        ('carrier_id', '=', False),
                    ]"
                    groups="l10n_ar_eynes.group_check_cot"
                />
            </xpath>
            <xpath expr="/form/sheet/notebook/page[@name='extra']" position="after">
                <page
                    string="COT"
                    invisible="[
                        ('picking_type_code', '=', 'production') or
                        ('picking_type_code', '=', 'incoming')
                    ]"
                >
                    <group col="2" colspan="2" string="COT Information">
                        <group>
                            <field name="declared_value" readonly="[('voucher','!=', False)]" />
                            <field name="dimension" readonly="[('voucher','!=', False)]" />
                            <field name="cot" readonly="1" />
                            <field
                                name="voucher"
                                groups="l10n_ar_eynes.group_check_cot"
                                invisible="[('pick_type','!=','outgoing')]"
                            />
                        </group>
                        <group>
                            <field name="cot_date_transfer" readonly="[('state','=','done')]" />
                            <field name="carrier_id" readonly="[('state','=','done')]" />
                            <field name="truck_license_plate" readonly="[('state','=','done')]" />
                            <field name="trailer_license_plate" readonly="[('state','=','done')]" />
                            <field name="express_id" invisible="[('voucher','=', False)]" readonly="True" />
                            <field name="dom_partner_id" invisible="True" />
                            <!-- Solo sirve con WS -->
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Add an internal note..." class="oe_inline" />
                    </group>
                </page>
            </xpath>
            <field name="note" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>
