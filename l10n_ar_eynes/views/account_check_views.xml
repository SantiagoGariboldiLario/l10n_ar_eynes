<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- CHECK CONFIGURATION FORM VIEW-->
    <record id="account_check_view_form_config" model="ir.ui.view">
        <field name="name">account.check.config.view.form</field>
        <field name="model">account.check.config</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Check Config" version="7.0">
                <sheet>
                    <h1>
                        <p>Account Check Configuration</p>
                    </h1>
                    <group>
                        <field name="company_id" readonly="True" />
                        <field name="account_id" />
                        <field name="deferred_account_id" />
                        <field name="receivable_rejected_account_id" />
                        <field name="rejected_account_id" />
                        <field name="rejected_issued_checks_journal_id" />
                        <field name="deferred_journal_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- CHECK CONFIGURATION TREE VIEW-->
    <record id="account_check_view_tree_config" model="ir.ui.view">
        <field name="name">account.check.config.view.tree</field>
        <field name="model">account.check.config</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree>
                <field name="company_id" />
                <field name="account_id" />
                <field name="deferred_account_id" />
                <field name="receivable_rejected_account_id" />
                <field name="rejected_account_id" />
                <field name="rejected_issued_checks_journal_id" />
                <field name="deferred_journal_id" />
            </tree>
        </field>
    </record>

    <!-- CHECK CONFIGURATION ACTION-->
    <record id="account_check_config_action" model="ir.actions.act_window">
        <field name="name">Check Config</field>
        <field name="res_model">account.check.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ISSUED CHECK FORM VIEW-->
    <record id="account_issued_check_view_form" model="ir.ui.view">
        <field name="name">account.issued.check.view.form</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <form string="Checks" create="false" edit="false">
                <header>
                    <button
                        name="%(change_check_state_action)d"
                        string="Change State"
                        type="action"
                        class="oe_highlight"
                    />
                    <field
                        name="issued_check_state"
                        widget="statusbar"
                        statusbar_visible="draft,waiting_accreditation,cancelled,paid,expired,rejected,waiting_numeration"
                        statusbar_colors='{"cancel":"red"}'
                        attrs="{'invisible' : [('internal_type', '=', 'third_party')]}"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="number" string="Check Number" />
                            <field name="number" class="oe_inline" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="checkbook_id" required="1" />
                            <field name="checkbook_format" />
                            <field name="type" />
                            <field name="internal_type" readonly="1" />
                            <field name="amount" required="1" />
                            <field name="journal_id" string="Bank Account" />
                            <field name="bank_id" />
                        </group>
                        <group>
                            <field name="issue_date" />
                            <field name="payment_date" attrs="{'invisible': [('type', '=', 'common')]}" />
                            <field
                                name="reject_date"
                                attrs="{'invisible': [('issued_check_state', '!=', 'rejected')]}"
                            />
                            <field name="crossed" />
                            <field name="not_order" />
                        </group>
                    </group>
                    <group string="Adittional Information">
                        <group>
                            <field name="clearing" />
                            <field name="signatory" />
                        </group>
                        <group>
                            <field name="origin" />
                            <field name="payment_move_id" />
                            <field
                                name="clearance_move_id"
                                attrs="{'readonly': True, 'invisible': [('type', '=', 'common')]}"
                            />
                            <field name="accredited" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="note"
                            attrs="{'invisible': [('issued_check_state', '!=', 'rejected')]}"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ISSUED CHECK TREE VIEW-->
    <record id="account_issued_check_view_tree" model="ir.ui.view">
        <field name="name">account.issued.check.view.tree</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="number" />
                <field name="checkbook_id" />
                <field name="bank_id" />
                <field name="issue_date" />
                <field name="payment_date" />
                <field name="amount" />
                <field name="type" />
                <field name="checkbook_format" />
                <field name="issued_check_state" string="State" />
            </tree>
        </field>
    </record>

    <!-- ISSUED CHECK CALENDAR VIEWS -->
    <record id="account_issued_check_view_calendar_issued" model="ir.ui.view">
        <field name="name">account.issued.check.issued.calendar</field>
        <field name="model">account.check</field>
        <field name="type">calendar</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <calendar color="bank_id" date_start="issue_date" string="Issued Checks by Issue Date">
                <field name="number" />
                <field name="amount" />
            </calendar>
        </field>
    </record>

    <record id="account_issued_check_view_calendar_payment" model="ir.ui.view">
        <field name="name">account.issued.check.payment.calendar</field>
        <field name="model">account.check</field>
        <field name="type">calendar</field>
        <field eval="10" name="priority" />
        <field name="arch" type="xml">
            <calendar color="bank_id" date_start="payment_date" string="Issued Checks by Payment Date">
                <field name="number" />
                <field name="amount" />
            </calendar>
        </field>
    </record>

    <!-- ISSUED CHECK ACTION-->
    <record id="account_issued_check_action" model="ir.actions.act_window">
        <field name="name">Issued Checks</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('internal_type', '=', 'issued')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('account_issued_check_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_issued_check_view_form')})]"
        />
    </record>

    <record id="account_issued_check_action_calendar_payment_date" model="ir.actions.act_window">
        <field name="name">Issued Checks by Payment Date</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">calendar,form</field>
        <field name="domain">[('internal_type', '=', 'issued')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'calendar', 'view_id': ref('account_issued_check_view_calendar_payment')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_issued_check_view_form')})]"
        />
    </record>

    <record id="account_issued_check_action_calendar_issued_date" model="ir.actions.act_window">
        <field name="name">Issued Checks by Issue Date</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">calendar,form</field>
        <field name="domain">[('internal_type', '=', 'issued')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'calendar', 'view_id': ref('account_issued_check_view_calendar_issued')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_issued_check_view_form')})]"
        />
    </record>

    <!-- THIRD PARTY CHECK FORM VIEW-->
    <record id="account_third_party_check_view_form" model="ir.ui.view">
        <field name="name">account.third.party.check.view.form</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <form string="Checks" create="false">
                <header>
                    <button
                        name="%(change_check_state_action)d"
                        string="Change State"
                        type="action"
                        class="oe_highlight"
                    />
                    <button
                        string="Deposit Check"
                        name="%(deposit_check_action)d"
                        type="action"
                        class="oe_highlight"
                        attrs="{'invisible' : ['|', ('third_party_check_state', '!=', 'in_wallet'), ('internal_type', '=', 'issued')]}"
                    />
                    <button
                        name="check_to_wallet"
                        type='object'
                        string='Back to Wallet'
                        class="btn-secondary"
                        attrs="{'invisible': [('internal_type', '=', 'third_party'), ('third_party_check_state','in', ('draft', 'in_wallet'))]}"
                        confirm="You are going to delete an account move. Are you sure?"
                    />

                    <field
                        name="third_party_check_state"
                        widget="statusbar"
                        statusbar_visible="in_wallet,deposited,delivered,rejected"
                        statusbar_colors='{"cancel":"red"}'
                        attrs="{'invisible' : [('internal_type', '=', 'issued')]}"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="number" string="Check Number" />
                            <field name="number" class="oe_inline" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type" readonly="1" />
                            <field name="amount" readonly="True" />
                            <field name="source_partner_id" readonly="1" />
                            <field
                                name="destiny_partner_id"
                                attrs="{
                                    'invisible': [('third_party_check_state', 'not in', ('delivered', 'rejected'))],
                                    'readonly': [('third_party_check_state', '!=', 'in_wallet')]
                                }"
                            />
                            <field name="checkbook_format" readonly="1" />
                            <field name="internal_type" readonly="1" />
                        </group>
                        <group>
                            <field
                                name="reception_date"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="issue_date"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="endorsement_date"
                                attrs="{
                                    'invisible': [('third_party_check_state', 'not in', ('in_wallet', 'delivered', 'rejected'))],
                                    'readonly': [('third_party_check_state', '!=', 'in_wallet')]
                                }"
                            />
                            <field
                                name="payment_date"
                                attrs="{
                                    'invisible': [('type', '=', 'common')],
                                    'readonly': [('third_party_check_state', '!=', 'in_wallet')]
                                }"
                            />
                        </group>
                    </group>
                    <group string="Other Information">
                        <group>
                            <field
                                name="bank_id"
                                string="Issuing Bank"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="bank_branch"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="zip"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="origin"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="crossed"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="not_order"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="dest"
                                attrs="{
                                    'invisible': [('third_party_check_state','!=','delivered')],
                                    'readonly': [('third_party_check_state', '!=', 'in_wallet')]
                                }"
                            />
                        </group>
                        <group>
                            <field
                                name="clearing"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="signatory"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="signatory_vat"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="signatory_account"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                        </group>
                    </group>
                    <group
                        string="Check Deposit"
                        attrs="{
                            'invisible': [('third_party_check_state','not in',('deposited', 'rejected'))],
                            'readonly': [('third_party_check_state', '!=', 'in_wallet')]
                        }"
                    >
                        <group>
                            <field
                                name="deposit_date"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="deposit_slip"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="deposit_move_id"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                            <field
                                name="deposit_bank_id"
                                attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            />
                        </group>
                    </group>
                    <group string="Payments, Receipts and Debits">
                        <group>
                            <field name="source_payment_order_id" readonly="1" />
                            <field name="debit_note_id" readonly="1" />
                            <field
                                name="reject_date"
                                attrs="{
                                    'invisible': [('third_party_check_state', '!=', 'rejected')],
                                    'readonly': [('third_party_check_state', '!=', 'in_wallet')]
                                }"
                            />
                        </group>
                    </group>
                    <group string="Additional Information">
                        <div class="oe_clear" />
                        <field
                            name="note"
                            attrs="{'readonly': [('third_party_check_state', '!=', 'in_wallet')]}"
                            colspan="4"
                            nolabel="1"
                            placeholder="Additional Information..."
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- THIRD PARTY CHECK TREE VIEW-->
    <record id="account_third_party_check_view_tree" model="ir.ui.view">
        <field name="name">account.third.party.check.view.tree</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="number" />
                <field name="checkbook_format" />
                <field name="type" />
                <field name="receiving_partner_id" />
                <field name="source_partner_id" />
                <field name="issue_date" />
                <field name="reception_date" />
                <field name="payment_date" />
                <field name="bank_id" />
                <field name="deposit_journal_id" />
                <field name="deposit_slip" />
                <field name="amount" />
                <field name="third_party_check_state" string="State" />
            </tree>
        </field>
    </record>

    <!-- THIRD PARTY CHECK CALENDAR VIEW-->
    <record id="account_third_check_view_calendar_issued" model="ir.ui.view">
        <field name="name">account.third.check.issued.calendar</field>
        <field name="model">account.check</field>
        <field name="type">calendar</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <calendar color="bank_id" date_start="issue_date" string="Third Checks by Issue Date">
                <field name="number" />
                <field name="amount" />
            </calendar>
        </field>
    </record>

    <record id="account_third_check_view_calendar_payment" model="ir.ui.view">
        <field name="name">account.third.check.payment.calendar</field>
        <field name="model">account.check</field>
        <field name="type">calendar</field>
        <field eval="10" name="priority" />
        <field name="arch" type="xml">
            <calendar color="bank_id" date_start="payment_date" string="Third Checks by Payment Date">
                <field name="number" />
                <field name="amount" />
            </calendar>
        </field>
    </record>

    <record id="account_third_check_view_calendar_endorsement" model="ir.ui.view">
        <field name="name">account.third.check.endorsement.calendar</field>
        <field name="model">account.check</field>
        <field name="type">calendar</field>
        <field eval="10" name="priority" />
        <field name="arch" type="xml">
            <calendar color="bank_id" date_start="endorsement_date" string="Third Checks by Endorsement Date">
                <field name="number" />
                <field name="amount" />
            </calendar>
        </field>
    </record>

    <!-- THIRD PARTY CHECK ACTION -->
    <record id="account_third_party_check_action" model="ir.actions.act_window">
        <field name="name">Third Party Checks</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('internal_type', '=', 'third_party')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('account_third_party_check_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_third_party_check_view_form')})]"
        />
    </record>

    <record id="account_third_check_action_calendar_payment_date" model="ir.actions.act_window">
        <field name="name">Third Checks by Payment Date</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">calendar,form</field>
        <field name="domain">[('internal_type', '=', 'third_party')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'calendar', 'view_id': ref('account_third_check_view_calendar_payment')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_third_party_check_view_form')})]"
        />
    </record>

    <record id="account_third_check_action_calendar_issued_date" model="ir.actions.act_window">
        <field name="name">Third Checks by Issue Date</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">calendar,form</field>
        <field name="domain">[('internal_type', '=', 'third_party')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'calendar', 'view_id': ref('account_third_check_view_calendar_issued')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_third_party_check_view_form')})]"
        />
    </record>

    <record id="account_third_check_action_calendar_endorsement_date" model="ir.actions.act_window">
        <field name="name">Third Checks by Endorsement Date</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">calendar,form</field>
        <field name="domain">[('internal_type', '=', 'third_party'),('endorsement_date','!=',False)]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'calendar', 'view_id': ref('account_third_check_view_calendar_endorsement')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_third_party_check_view_form')})]"
        />
    </record>

</odoo>
