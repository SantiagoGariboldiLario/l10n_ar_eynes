<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- CHECK CONFIGURATION FORM VIEW-->
    <record id="account_check_view_form_config" model="ir.ui.view">
        <field name="name">account.check.config.view.form</field>
        <field name="model">account.check.config</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Check Config" version="7.0">
                <sheet>
                    <h1>
                        <p>Account Check Configuration</p>
                    </h1>
                    <group>
                        <field name="company_id" readonly="True" />
                        <field name="account_id" />
                        <field name="deferred_account_id" />
                        <field name="receivable_rejected_account_id" />
                        <field name="rejected_account_id" />
                        <field name="expired_issued_checks_account_id" />
                        <field name="rejected_issued_checks_journal_id" />
                        <field name="deferred_journal_id" />
                        <field name="rejected_check_product_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- CHECK CONFIGURATION TREE VIEW-->
    <record id="account_check_view_tree_config" model="ir.ui.view">
        <field name="name">account.check.config.view.tree</field>
        <field name="model">account.check.config</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree>
                <field name="company_id" />
                <field name="account_id" />
                <field name="deferred_account_id" />
                <field name="receivable_rejected_account_id" />
                <field name="rejected_account_id" />
                <field name="expired_issued_checks_account_id" />
                <field name="rejected_issued_checks_journal_id" />
                <field name="deferred_journal_id" />
            </tree>
        </field>
    </record>

    <!-- CHECK CONFIGURATION ACTION-->
    <record id="account_check_config_action" model="ir.actions.act_window">
        <field name="name">Check Config</field>
        <field name="res_model">account.check.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ISSUED CHECK FILTERS AND GROUPS -->
    <record id="issued_checks_filter" model="ir.ui.view">
        <field name="name">issued.checks.filter</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <search string="Search Issued Check">
                <field name="number" />
                <field name="bank_id" />
                <field name="checkbook_id" />
                <filter name="draft" string="Draft" domain="[('issued_check_state','=','draft')]" />
                <filter
                    name="waiting_debit"
                    string="Waiting accreditation"
                    domain="[('issued_check_state', '=', 'waiting_debit')]"
                />
                <filter
                    name="cancelled"
                    string="Cancelled"
                    domain="[('issued_check_state', '=', 'cancelled')]"
                />
                <filter name="debited" string="Debited" domain="[('issued_check_state','=','debited')]" />
                <filter name="expired" string="Expired" domain="[('issued_check_state', '=', 'expired')]" />
                <filter
                    name="returned"
                    string="Returned"
                    domain="[('issued_check_state', '=', 'returned')]"
                />
                <filter
                    name="rejected"
                    string="Rejected"
                    domain="[('issued_check_state', '=', 'rejected')]"
                />
            </search>
        </field>
    </record>

    <!-- ISSUED CHECK FORM VIEW-->
    <record id="account_issued_check_view_form" model="ir.ui.view">
        <field name="name">account.issued.check.view.form</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <form string="Checks" create="false" edit="false">
                <header>
                    <button
                        name="%(change_check_state_action)d"
                        string="Change State"
                        type="action"
                        class="oe_highlight"
                        invisible="issued_check_state in ('debited', 'rejected', 'cancelled', 'expired')"
                    />
                    <button
                        name="%(reject_issued_check_action)d"
                        string="Reject Check"
                        type="action"
                        class="oe_highlight"
                        invisible="issued_check_state != 'debited'"
                    />
                     <button
                        string="Debit Check"
                        name="%(debit_one_check_wizard_action)d"
                        type="action"
                        class="oe_highlight"
                        invisible="issued_check_state != 'waiting_debit'"
                    />
                    <field
                        name="issued_check_state"
                        widget="statusbar"
                        statusbar_visible="draft,waiting_debit,debited,cancelled,returned,rejected,expired"
                        statusbar_colors='{"cancel":"red"}'
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="number" string="Check Number" />
                            <field name="number" class="oe_inline" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="checkbook_id" required="1" />
                            <field name="checkbook_format" />
                            <field name="type" />
                            <field name="internal_type" readonly="1" />
                            <field name="amount" required="1" />
                            <field name="journal_id" string="Bank Account" />
                            <field name="bank_id" />
                        </group>
                        <group>
                            <field name="issue_date" />
                            <field name="payment_date" invisible="type == 'common'" />
                            <field name="crossed" />
                            <field name="not_order" />
                        </group>
                    </group>
                    <group
                        string="Check Deposit"
                        invisible="issued_check_state not in ('debited', 'rejected')"
                        readonly="issued_check_state != 'debited'"
                    >
                         <group>
                            <field
                                name="deposit_date"
                                string="Debit date"
                                readonly="issued_check_state != 'debited'"
                            />
                            <field
                                name="clearance_move_id"
                                string="Debit move"
                                readonly="issued_check_state != 'debited'"
                            />
                            <field
                                name="deposit_bank_id"
                                string="Debit account"
                                readonly="issued_check_state != 'debited'"
                            />
                        </group>
                    </group>
                    <group string="Check Rejection">
                         <group>
                            <field name="reject_date" />
                            <field name="reject_move_id" />
                        </group>
                    </group>
                    <group string="Check Cancelation">
                         <group>
                            <field name="cancel_date" />
                            <field name="cancel_move_id" />
                        </group>
                    </group>
                    <group string="Check Expiration">
                         <group>
                            <field name="expired_date" />
                            <field name="expired_move_id" />
                        </group>
                    </group>
                    <group string="Adittional Information">
                        <group>
                            <field name="company_id" />
                            <field name="clearing" />
                            <field name="signatory" />
                        </group>
                        <group>
                            <field name="origin" />
                            <field name="payment_move_id" />
                            <field name="accredited" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" options="{'display_log_button': True}" />
                </div>
            </form>
        </field>
    </record>

    <!-- ISSUED CHECK TREE VIEW-->
    <record id="account_issued_check_view_tree" model="ir.ui.view">
        <field name="name">account.issued.check.view.tree</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="number" />
                <field name="checkbook_id" />
                <field name="bank_id" />
                <field name="issue_date" />
                <field name="payment_date" />
                <field name="receiving_partner_id" />
                <field name="payment_order_id" />
                <field name="amount" />
                <field name="type" />
                <field name="checkbook_format" />
                <field name="journal_bank_id" />
                <field name="issued_check_state" string="State" />
                <field name="company_id" />
            </tree>
        </field>
    </record>

    <!-- ISSUED CHECK CALENDAR VIEWS -->
    <record id="account_issued_check_view_calendar_issued" model="ir.ui.view">
        <field name="name">account.issued.check.issued.calendar</field>
        <field name="model">account.check</field>
        <field name="type">calendar</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <calendar color="bank_id" date_start="issue_date" string="Issued Checks by Issue Date">
                <field name="number" />
                <field name="amount" />
            </calendar>
        </field>
    </record>

    <record id="account_issued_check_view_calendar_payment" model="ir.ui.view">
        <field name="name">account.issued.check.payment.calendar</field>
        <field name="model">account.check</field>
        <field name="type">calendar</field>
        <field eval="10" name="priority" />
        <field name="arch" type="xml">
            <calendar color="bank_id" date_start="payment_date" string="Issued Checks by Payment Date">
                <field name="number" />
                <field name="amount" />
            </calendar>
        </field>
    </record>

    <!-- ISSUED CHECK ACTION-->
    <record id="account_issued_check_action" model="ir.actions.act_window">
        <field name="name">Issued Checks</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('internal_type', '=', 'issued')]</field>
        <field name="search_view_id" ref="issued_checks_filter" />
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('account_issued_check_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_issued_check_view_form')})]"
        />
    </record>

    <record id="account_issued_check_action_calendar_payment_date" model="ir.actions.act_window">
        <field name="name">Issued Checks by Payment Date</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">calendar,form</field>
        <field name="domain">[('internal_type', '=', 'issued')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'calendar', 'view_id': ref('account_issued_check_view_calendar_payment')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_issued_check_view_form')})]"
        />
    </record>

    <record id="account_issued_check_action_calendar_issued_date" model="ir.actions.act_window">
        <field name="name">Issued Checks by Issue Date</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">calendar,form</field>
        <field name="domain">[('internal_type', '=', 'issued')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'calendar', 'view_id': ref('account_issued_check_view_calendar_issued')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_issued_check_view_form')})]"
        />
    </record>

    <!-- THIRD PARTY CHECK FILTERS AND GROUPS -->
    <record id="third_party_checks_filter" model="ir.ui.view">
        <field name="name">third.party.checks.filter</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <search string="Search Third Party Check">
                <field name="number" />
                <field name="bank_id" />
                <field name="checkbook_id" />
                <filter name="draft" string="Draft" domain="[('third_party_check_state','=','draft')]" />
                <filter
                    name="in_wallet"
                    string="In wallet"
                    domain="[('third_party_check_state', '=', 'in_wallet')]"
                />
                <filter
                    name="deposited"
                    string="Deposited"
                    domain="[('third_party_check_state','=','deposited')]"
                />
                <filter
                    name="delivered"
                    string="Delivered"
                    domain="[('third_party_check_state', '=', 'delivered')]"
                />
                <filter
                    name="expired"
                    string="Expired"
                    domain="[('third_party_check_state', '=', 'expired')]"
                />
                <filter
                    name="rejected"
                    string="Rejected"
                    domain="[('third_party_check_state', '=', 'rejected')]"
                />
            </search>
        </field>
    </record>

    <!-- THIRD PARTY CHECK FORM VIEW-->
    <record id="account_third_party_check_view_form" model="ir.ui.view">
        <field name="name">account.third.party.check.view.form</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <form string="Checks" create="false">
                <header>
                    <button
                        name="%(change_check_state_action)d"
                        string="Change State"
                        type="action"
                        class="oe_highlight"
                        invisible="third_party_check_state in ('draft', 'deposited', 'accredited', 'rejected', 'expired')"
                    />
                    <button
                        string="Deposit Check"
                        name="%(deposit_check_action)d"
                        type="action"
                        class="oe_highlight"
                        invisible="third_party_check_state != 'in_wallet'"
                    />
                    <button
                        string="Accredit Check"
                        name="%(accredit_check_action)d"
                        type="action"
                        class="oe_highlight"
                        invisible="third_party_check_state != 'deposited'"
                    />
                    <button
                        name="check_to_wallet"
                        type='object'
                        string='Back to Wallet'
                        class="btn-secondary"
                        invisible="third_party_check_state in ('draft', 'in_wallet')"
                        confirm="You are going to delete an account move. Are you sure?"
                    />
                    <button
                        name="%(reject_third_party_check_action)d"
                        string="Reject Check"
                        type="action"
                        class="oe_highlight"
                        invisible="third_party_check_state not in ('accredited', 'delivered')"
                    />
                    <field
                        name="third_party_check_state"
                        widget="statusbar"
                        statusbar_visible="draft,in_wallet,deposited,accredited,delivered,rejected,expired"
                        statusbar_colors='{"cancel":"red"}'
                    />
                     <button
                        name="create_debit_note_from_rejected_check"
                        type='object'
                        string='Create Debit Note'
                        class="oe_highlight"
                        invisible="third_party_check_state not in ('rejected') or debit_note_id"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="number" string="Check Number" />
                            <field name="number" class="oe_inline" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type" readonly="1" />
                            <field name="amount" readonly="True" />
                            <field name="source_partner_id" readonly="1" />
                            <field
                                name="destiny_partner_id"
                                invisible="third_party_check_state not in ('delivered', 'rejected')"
                                readonly="third_party_check_state != 'in_wallet'"
                            />
                            <field name="checkbook_format" readonly="1" />
                            <field name="internal_type" readonly="1" />
                            <field name="debit_note_id" readonly="1" invisible="not debit_note_id" />

                        </group>
                        <group>
                            <field name="reception_date" readonly="third_party_check_state != 'in_wallet'" />
                            <field name="issue_date" readonly="third_party_check_state != 'in_wallet'" />
                            <field
                                name="endorsement_date"
                                invisible="third_party_check_state not in ('in_wallet', 'delivered', 'rejected')"
                                readonly="third_party_check_state != 'in_wallet'"
                            />
                            <field
                                name="payment_date"
                                invisible="type == 'common'"
                                readonly="third_party_check_state != 'in_wallet'"
                            />
                        </group>
                    </group>
                    <group string="Other Information">
                        <group>
                            <field name="company_id" />
                            <field
                                name="bank_id"
                                string="Issuing Bank"
                                readonly="third_party_check_state != 'in_wallet'"
                            />
                            <field name="bank_branch" readonly="third_party_check_state != 'in_wallet'" />
                            <field name="zip" readonly="third_party_check_state != 'in_wallet'" />
                            <field name="origin" readonly="third_party_check_state != 'in_wallet'" />
                            <field name="crossed" readonly="third_party_check_state != 'in_wallet'" />
                            <field name="not_order" readonly="third_party_check_state != 'in_wallet'" />
                            <field
                                name="dest"
                                invisible="third_party_check_state != 'delivered'"
                                readonly="third_party_check_state != 'in_wallet'"
                            />
                        </group>
                        <group>
                            <field name="clearing" readonly="third_party_check_state != 'in_wallet'" />
                            <field name="signatory" readonly="third_party_check_state != 'in_wallet'" />
                            <field name="signatory_vat" readonly="third_party_check_state != 'in_wallet'" />
                            <field
                                name="signatory_account"
                                readonly="third_party_check_state != 'in_wallet'"
                            />
                        </group>
                    </group>
                    <group
                        string="Check Deposit"
                        invisible="third_party_check_state not in ('deposited', 'rejected', 'accredited')"
                        readonly="third_party_check_state != 'in_wallet'"
                    >
                        <group>
                            <field name="deposit_date" readonly="third_party_check_state != 'in_wallet'" />
                            <field name="deposit_slip" readonly="third_party_check_state != 'in_wallet'" />
                            <field name="deposit_move_id" readonly="third_party_check_state != 'in_wallet'" />
                            <field name="deposit_bank_id" readonly="third_party_check_state != 'in_wallet'" />
                        </group>
                    </group>
                     <group string="Check Accreditation" invisible="third_party_check_state != 'accredited'">
                        <group>
                            <field name="accredit_date" readonly="third_party_check_state != 'deposited'" />
                            <field
                                name="accredit_move_id"
                                readonly="third_party_check_state != 'deposited'"
                            />
                        </group>
                    </group>
                    <group string="Payments, Receipts and Debits">
                        <group>
                            <field name="source_payment_order_id" readonly="1" />
                            <field name="debit_note_id" readonly="1" />
                            <field
                                name="reject_date"
                                invisible="third_party_check_state != 'rejected'"
                                readonly="third_party_check_state != 'in_wallet'"
                            />
                        </group>
                    </group>
                    <group string="Check Rejection">
                         <group>
                            <field name="reject_date" />
                            <field name="reject_move_id" />
                        </group>
                    </group>
                    <group string="Check Cancelation">
                         <group>
                            <field name="cancel_date" />
                            <field name="cancel_move_id" />
                        </group>
                    </group>
                    <group string="Check Expiration">
                         <group>
                            <field name="expired_date" />
                            <field name="expired_move_id" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" options="{'display_log_button': True}" />
                </div>
            </form>
        </field>
    </record>

    <!-- THIRD PARTY CHECK TREE VIEW-->
    <record id="account_third_party_check_view_tree" model="ir.ui.view">
        <field name="name">account.third.party.check.view.tree</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="number" />
                <field name="checkbook_format" />
                <field name="type" />
                <field name="receiving_partner_id" />
                <field name="source_partner_id" />
                <field name="issue_date" />
                <field name="reception_date" />
                <field name="payment_date" />
                <field name="bank_id" />
                <field name="deposit_journal_id" />
                <field name="deposit_bank_id" />
                <field name="deposit_slip" />
                <field name="amount" />
                <field name="third_party_check_state" string="State" />
                <field name="company_id" />
            </tree>
        </field>
    </record>

    <!-- THIRD PARTY CHECK CALENDAR VIEW-->
    <record id="account_third_check_view_calendar_issued" model="ir.ui.view">
        <field name="name">account.third.check.issued.calendar</field>
        <field name="model">account.check</field>
        <field name="type">calendar</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <calendar color="bank_id" date_start="issue_date" string="Third Checks by Issue Date">
                <field name="number" />
                <field name="amount" />
            </calendar>
        </field>
    </record>

    <record id="account_third_check_view_calendar_payment" model="ir.ui.view">
        <field name="name">account.third.check.payment.calendar</field>
        <field name="model">account.check</field>
        <field name="type">calendar</field>
        <field eval="10" name="priority" />
        <field name="arch" type="xml">
            <calendar color="bank_id" date_start="payment_date" string="Third Checks by Payment Date">
                <field name="number" />
                <field name="amount" />
            </calendar>
        </field>
    </record>

    <record id="account_third_check_view_calendar_endorsement" model="ir.ui.view">
        <field name="name">account.third.check.endorsement.calendar</field>
        <field name="model">account.check</field>
        <field name="type">calendar</field>
        <field eval="10" name="priority" />
        <field name="arch" type="xml">
            <calendar color="bank_id" date_start="endorsement_date" string="Third Checks by Endorsement Date">
                <field name="number" />
                <field name="amount" />
            </calendar>
        </field>
    </record>

    <!-- THIRD PARTY CHECK ACTION -->
    <record id="account_third_party_check_action" model="ir.actions.act_window">
        <field name="name">Third Party Checks</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('internal_type', '=', 'third_party')]</field>
        <field name="search_view_id" ref="third_party_checks_filter" />
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('account_third_party_check_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_third_party_check_view_form')})]"
        />
    </record>

    <record id="account_third_check_action_calendar_payment_date" model="ir.actions.act_window">
        <field name="name">Third Checks by Payment Date</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">calendar,form</field>
        <field name="domain">[('internal_type', '=', 'third_party')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'calendar', 'view_id': ref('account_third_check_view_calendar_payment')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_third_party_check_view_form')})]"
        />
    </record>

    <record id="account_third_check_action_calendar_issued_date" model="ir.actions.act_window">
        <field name="name">Third Checks by Issue Date</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">calendar,form</field>
        <field name="domain">[('internal_type', '=', 'third_party')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'calendar', 'view_id': ref('account_third_check_view_calendar_issued')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('account_third_party_check_view_form')})]"
        />
    </record>

    <record id="account_third_check_action_calendar_endorsement_date" model="ir.actions.act_window">
        <field name="name">Third Checks by Endorsement Date</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">calendar,form</field>
        <field name="domain">[('internal_type', '=', 'third_party'),('endorsement_date','!=',False)]</field>
        <field
