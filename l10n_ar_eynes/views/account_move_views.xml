<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_move_view_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath
                expr="//sheet/div[hasclass('oe_title')]/span[hasclass('o_form_label')]"
                position="replace"
            >
                <span
                    class="o_form_label"
                    attrs="{'invisible': ['|', ('move_type', '=', 'entry'), ('debit_origin_id', '!=', False)]}"
                >
                    <field name="move_type" readonly="1" nolabel="1" />
                </span>
                <span
                    class="o_form_label"
                    attrs="{'invisible': ['|', ('move_type', '=', 'entry'), ('debit_origin_id', '=', False)]}"
                >
                    <span>Debit Note</span>
                </span>
            </xpath>

            <xpath expr="//sheet/div[hasclass('oe_title')]/h1[1]" position="attributes">
                <attribute name="attrs">{'invisible': 1}</attribute>
            </xpath>

            <xpath expr="//h1[hasclass('mt0')]" position="replace">
                <h1 class="mt0">
                    <field name="denomination" force_save="1" readonly="1" />
                    <field
                        name="name"
                        class="oe_inline"
                        readonly="1"
                        force_save="1"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                    />
                    <field
                        name="supplier_move_reference"
                        class="oe_inline"
                        attrs="{
                            'invisible': [
                                '|',
                                ('state', '!=', 'draft'),
                                ('move_type','not in', ('in_invoice', 'in_refund'))
                            ],
                            'required': [('move_type','in',('in_invoice', 'in_refund'))]

                        }"
                    />
                </h1>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="attrs">
                    {
                        'required': [('move_type', 'in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund'))],
                        'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund'))],
                    }
                </attribute>
            </xpath>

            <xpath expr="//field[@name='payment_reference']" position="after">
                <field
                    name="fiscal_type"
                    attrs="{
                        'required': [('move_type', 'in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund'))],
                        'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund'))],
                    }"
                />
            </xpath>

            <div name="journal_div" position="after">
                <field
                    name="currency_rate"
                    placeholder="Currency Rate"
                    class="oe_inline"
                    attrs="{'invisible': [('is_company_cur','=', True)]}"
                />
                <button
                    name="%(action_account_change_currency)d"
                    aria-label="Opened"
                    type="action"
                    class="btn-link"
                    states="draft"
                    groups="account.group_account_user"
                >
                    <i
                        title="Update Currency: Will convert the amount lines to the new currency set"
                        class="fa fa-fw fa-refresh"
                    />
                </button>
                <p attrs="{'invisible': [('currency_preciated', '=', False)]}">
                    <i
                    >Cuidado, la moneda es preciada! ponga el monto correspondiente.</i>
                </p>
                <field name="currency_preciated" invisible="1" />
                <field name="is_company_cur" invisible="1" />
                <field name="is_multi_currency" invisible="1" />
                <field
                    name="company_currency_id"
                    invisible="1"
                    string="Company Currency"
                />
            </div>

            <field name="fiscal_position_id" position="after">
                <field name="currency_converted" invisible="1" />
                <field
                    name="secondary_currency_id"
                    attrs="{'invisible': [('is_company_cur', '=', True)]}"
                />
                <field
                    name="secondary_currency_rate"
                    attrs="{'invisible': [('is_company_cur', '=', True)]}"
                />
            </field>

            <xpath
                expr="//group[@class='oe_invoice_lines_tab']/group[1]"
                position="replace"
            >
                <!-- If the invoice has same currency than the company -->
                <group
                    colspan="8"
                    attrs="{'invisible': [('secondary_currency_id', '!=', False), ('is_company_cur','=', False)]}"
                >
                    <field
                        name="narration"
                        placeholder="Terms and Conditions"
                        class="oe_inline text-break"
                        nolabel="1"
                    />
                </group>

                <!-- otherwise -->
                <group
                    colspan="4"
                    attrs="{'invisible': ['|',('secondary_currency_id', '=', False), ('is_company_cur','=', True)]}"
                >
                    <field
                        name="narration"
                        placeholder="Terms and Conditions"
                        class="oe_inline text-break"
                        nolabel="1"
                    />
                </group>

                <group
                    colspan="4"
                    class="oe_subtotal_footer oe_right"
                    attrs="{'invisible': ['|',('secondary_currency_id', '=', False), ('is_company_cur','=', True)]}"
                >
                    <field name="amount_taxed_cur" />
                    <field name="amount_no_taxed_cur" />
                    <field name="amount_exempt_cur" />
                    <field
                        name="amount_untaxed_cur"
                        class="oe_subtotal_footer_separator"
                    />
                    <field name="amount_tax_cur" />
                    <field
                        name="amount_total_cur"
                        class="oe_subtotal_footer_separator"
                    />
                    <i>- Amounts in Secondary Currency</i>
                </group>
            </xpath>


            <xpath
                expr="//group[@name='accounting_info_group']/field[@name='fiscal_position_id']"
                position="attributes"
            >
                <attribute name="attrs">
                    {
                        'required': [('move_type', 'in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund'))],
                        'readonly': [('move_type', 'in', ('out_invoice', 'out_refund'))]
                    }
                </attribute>
            </xpath>

            <xpath
                expr="//group[@name='accounting_info_group']/field[@name='fiscal_position_id']"
                position="after"
            >
                <field
                    name="denomination"
                    force_save="1"
                    attrs="{
                        'required': [('move_type', 'in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund'))],
                        'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund'))],
                        'readonly': [('move_type', 'in', ('out_invoice', 'out_refund'))]
                    }"
                />
                <field name="aut_cae" />
                <field name="local" invisible="1" />
                <field
                    name="export_type_id"
                    widget="selection"
                    attrs="{
                        'required': [
                            ('move_type', 'in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')),
                            ('local','=',False)
                        ],
                        'invisible': [
                            ('move_type', 'in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')),
                            ('local','=', True),
                            '|',
                            ('move_type', 'not in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')),
                        ],
                    }"
                />
                <field
                    name="dst_country_id"
                    attrs="{
                        'required': [
                            ('move_type', 'in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')),
                            ('local','=',False)
                        ],
                        'invisible': [
                            ('move_type', 'in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')),
                            ('local','=', True),
                            '|',
                            ('move_type', 'not in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')),
                        ],
                    }"
                />
            </xpath>

            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field
                    name="is_FCE_invoice"
                    attrs="{'invisible': [('move_type','not in', ['out_refund', 'out_invoice', 'in_refund', 'in_invoice'])]}"
                />
                <field
                    name="cae"
                    string="CAE"
                    attrs="{
                        'readonly': [('move_type','in', ['out_refund', 'out_invoice'])],
                        'invisible': [('move_type','not in', ['out_refund', 'out_invoice', 'in_refund', 'in_invoice'])]
                    }"
                />
                <field
                    name="cae_due_date"
                    attrs="{
                        'readonly': [('move_type','in', ['out_refund', 'out_invoice'])],
                        'invisible': [('move_type','not in', ['out_refund', 'out_invoice', 'in_refund', 'in_invoice'])]
                    }"
                />
            </xpath>

            <page name="other_info" position="inside">
                <group string="Associated Invoices">
                    <field name="associated_inv_ids" nolabel="1">
                        <tree>
                            <field name="partner_id" groups="base.group_user" />
                            <field name="date" />
                            <field name="denomination" />
                            <field name="name" />
                            <field name="amount_residual" sum="Residual Amount" />
                            <field name="amount_untaxed" sum="Untaxed Amount" />
                            <field name="amount_total" sum="Total Amount" />
                            <field name="state" />
                        </tree>
                    </field>
                </group>
            </page>

            <page name="other_info" position="before">
                <page
                    string="Perceptions"
                    attrs="{
                        'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund'))]
                    }"
                >
                    <field
                        name="perception_ids"
                        nolabel="1"
                        colspan="4"
                        context="{'default_partner_id': partner_id}"
                    >
                        <tree>
                            <field name="name" />
                            <field name="partner_id" invisible="1" />
                            <field name="date" />
                            <field name="perception_id" string="Perception Type" />
                            <field name="concept_id" />
                            <field name="base" />
                            <field name="amount" />
                            <field name="state_id" />
                        </tree>
                        <form>
                            <h1>
                                <field
                                    name="perception_id"
                                    class="oe_inline"
                                    domain="[('type', '=', 'perceptions')]"
                                />
                            </h1>
                            <group>
                                <group string="Information" name="info">
                                    <field name="name" />
                                    <field name="partner_id" invisible="1" />
                                    <field name="state_id" />
                                    <field name="date" />
                                    <span
                                        string="Keep date empty if the date is the same as the invoice."
                                        class="oe_grey"
                                    />
                                </group>
                                <group string="Amounts" name="amount">
                                    <field name="base" />
                                    <field name="amount" />
                                    <field name="concept_id" />
                                </group>
                            </group>
                        </form>
                    </field>
                </page>

                <page
                    string="FCRED"
                    attrs="{'invisible': [('is_FCE_invoice','=', False)]}"
                >
                    <group string="Optionals">
                        <field name="optional_ids" nolabel="1">
                            <tree editable="bottom">
                                <field
                                    name="optional_id"
                                    options="{'no_create': True, 'no_create_edit':True, 'no_open':True}"
                                />
                                <field name="value" />
                            </tree>
                        </field>
                    </group>
                </page>

                <page
                    string="Export Invoice"
                    attrs="{'invisible': [
                        '|',
                        ('local','=', True),
                        ('move_type', 'not in', ('in_invoice', 'in_refund', 'out_invoice', 'out_refund'))
                        ]}"
                >
                    <group string="Shipping Permissions">
                        <field
                            name="shipping_perm_ids"
                            nolabel="1"
                            widget="one2many_list"
                        >
                            <tree editable="bottom">
                                <field name="name" />
                                <field name="dst_country_id" />
                            </tree>
                        </field>
                    </group>
                    <group string="History Requests">
                        <field name="wsfex_request_ids" nolabel="1">
                            <tree>
                                <field name="request_id" />
                                <field name="date" />
                                <field name="voucher_number" />
                                <field name="voucher_type_id" />
                                <field name="result" />
                            </tree>
                            <form string="Requests" version="7.0">
                                <group>
                                    <group>
                                        <field name="voucher_type_id" />
                                        <field name="voucher_number" />
                                        <field name="request_id" />
                                    </group>
                                    <group>
                                        <field name="date" />
                                        <field name="result" />
                                        <field name="cae" />
                                        <field name="cae_duedate" />
                                    </group>
                                </group>
                                <group>
                                    <group string="Error">
                                        <field name="error" nolabel="1" />
                                    </group>
                                    <group string="Event">
                                        <field name="event" nolabel="1" />
                                    </group>
                                </group>
                                <group string="Details">
                                    <field name="detail" nolabel="1" />
                                </group>
                            </form>
                        </field>
                    </group>
                </page>

                <page
                    string="WSFE Requests"
                    attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund'))]}"
                >
                    <field name="wsfe_request_ids" readonly="1">
                        <tree>
                            <field name="voucher_date" />
                            <field name="voucher_number" />
                            <field name="result" />
                            <field name="errors" />
                        </tree>
                    </field>
                </page>


            </page>

            <xpath
                expr="//field[@name='line_ids']/form/group/field[@name='currency_id']"
                position="after"
            >
                <field
                    name="currency_rate"
                    attrs="{'invisible': [('currency_id', '=', False)]}"
                    groups="base.group_multi_currency"
                />
            </xpath>

            <xpath
                expr="//group[@name='sale_info_group']/field[@name='debit_origin_id']"
                position="before"
            >
                <field name="is_debit_note" invisible="1" />
                <field
                    name="origin_invoice_id"
                    domain="[
                        ('move_type', '=', 'out_invoice'),
                        ('state', '=', 'posted')
                    ]"
                    attrs="{
                    'invisible': [('move_type', '!=', 'out_refund'), ('is_debit_note', '=', False)],
                    'required': ['|', ('move_type', '=', 'out_refund'), ('is_debit_note', '=', True)],
                    'readonly': [('id', '!=', False)]
                }"
                />
                <field
                    name="vat_date"
                    attrs="{'readonly': [('state', '!=', 'draft')]}"
                />
            </xpath>

        </field>
    </record>

    <record id="account_move_view_tree_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">account.move.view.tree.inherit.l10n_ar_eynes</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="denomination" />
            </field>
        </field>
    </record>

    <record id="account_invoice_action_debit_note" model="ir.actions.act_window">
        <field name="name">Customer Debit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field eval="False" name="view_id" />
        <field
            name="domain"
        >[('move_type','=','out_invoice'), ('is_debit_note','=', True)]</field>
        <field name="context">{
            'default_move_type':'out_invoice',
            'move_type': 'out_invoice',
            'journal_type': 'sale',
            'default_is_debit_note': True
        }</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter" />
        <field
            name="help"
        >With Customer Debit Notes you can manage the debit notes for your customers. A debit note is a document that increases the value of the debt or account balance, either by an error in billing, interest for late payment, or any other circumstance that means the increase in the balance of an account.</field>
    </record>

    <record
        id="account_invoice_action_debit_note_supplier"
        model="ir.actions.act_window"
    >
        <field name="name">Supplier Debit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field eval="False" name="view_id" />
        <field
            name="domain"
        >[('move_type','=','in_invoice'), ('is_debit_note','=', True)]</field>
        <field name="context">{
            'default_move_type':'in_invoice',
            'move_type': 'in_invoice',
            'journal_type': 'purchase',
            'default_is_debit_note': True
        }</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter" />
        <field
            name="help"
        >With Supplier Debit Notes you can manage the debit notes for your suppliers.
        A debit note is a document that increases the value of the debt or account balance, either by an error in billing, interest for late payment, or any other circumstance that means the increase in the balance of an account.</field>
    </record>

    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="domain">
            [('move_type','=','out_invoice'), ('is_debit_note','=', False)]
        </field>
    </record>

    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field name="name">Supplier Invoices</field>
        <field name="domain">
            [('move_type', '=', 'in_invoice'), ('is_debit_note','=', False)]
        </field>
    </record>

    <record id="view_account_move_multicurrency_filter" model="ir.ui.view">
        <field name="name">account.move.multicurrency.select</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <filter name="late" position="after">
                <separator />
                <filter
                    name="multicurrency"
                    string="MultiCurrency"
                    domain="[('is_multi_currency','=',True)]"
                    help="Invoices not in company currency"
                />
            </filter>
        </field>
    </record>


    <menuitem
        id="account_invoice_menu_debit_note"
        name="Debit Notes"
        action="account_invoice_action_debit_note"
        sequence="7"
        parent="account.menu_finance_receivables"
    />

    <menuitem
        id="account_invoice_menu_dn_supp"
        name="Debit Notes"
        action="account_invoice_action_debit_note_supplier"
        sequence="7"
        parent="account.menu_finance_payables"
    />

</odoo>
