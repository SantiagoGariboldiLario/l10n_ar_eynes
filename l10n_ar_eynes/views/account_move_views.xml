<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_move_view_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath
                expr="//sheet/div[hasclass('oe_title')]/span[hasclass('o_form_label')]"
                position="replace"
            >
                <span
                    class="o_form_label"
                    attrs="{'invisible': ['|', ('move_type', '=', 'entry'), ('debit_origin_id', '!=', False)]}"
                >
                    <field name="move_type" readonly="1" nolabel="1" />
                </span>
                <span
                    class="o_form_label"
                    attrs="{'invisible': ['|', ('move_type', '=', 'entry'), ('debit_origin_id', '=', False)]}"
                >
                    <span>Debit Note</span>
                </span>
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]/h1[1]" position="attributes">
                <attribute name="attrs">{'invisible': 1}</attribute>
            </xpath>

            <xpath expr="//h1[hasclass('mt0')]" position="replace">
                <h1 class="mt0">
                    <field name="denomination" force_save="1" readonly="1" />
                    <field
                        name="name"
                        class="oe_inline"
                        attrs="{
                            'readonly': [
                                '|',
                                ('state', '!=', 'draft'),
                                ('move_type','not in', ('in_invoice', 'in_refund'))
                            ],
                            'invisible': [
                                ('state', '=', 'draft'),
                                ('move_type','not in', ('in_invoice', 'in_refund'))
                            ],
                            'required': [
                                ('move_type','in', ('in_invoice', 'in_refund'))
                            ]
                        }"
                    />
                </h1>
            </xpath>

            <xpath
                expr="//group[@name='accounting_info_group']/field[@name='fiscal_position_id']"
                position="attributes"
            >
                <attribute name="attrs">
                    {
                        'required': 1,
                        'readonly': [('move_type', 'in', ('out_invoice', 'out_refund'))]
                    }
                </attribute>
            </xpath>
            <xpath
                expr="//group[@name='accounting_info_group']/field[@name='fiscal_position_id']"
                position="after"
            >
                <field
                    name="denomination"
                    force_save="1"
                    required="1"
                    attrs="{'readonly': [('move_type', 'in', ('out_invoice', 'out_refund'))]}"
                />
                <field name="aut_cae" />
                <field name="local" invisible="1" />
                <field
                    name="export_type_id"
                    widget="selection"
                    attrs="{'invisible': [('local','=', True)], 'required': [('local','=',False)]}"
                />
                <field
                    name="dst_country_id"
                    attrs="{'invisible': [('local','=', True)], 'required': [('local','=',False)]}"
                />
            </xpath>

            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="is_FCE_invoice" />
                <field name="cae" string="CAE" readonly="1" />
                <field name="cae_due_date" readonly="1" />
            </xpath>

            <page name="other_info" position="inside">
                <group string="Associated Invoices">
                    <field name="associated_inv_ids" nolabel="1">
                        <tree>
                            <field name="partner_id" groups="base.group_user" />
                            <field name="date" />
                            <field name="denomination" />
                            <field name="name" />
                            <field name="amount_residual" sum="Residual Amount" />
                            <field name="amount_untaxed" sum="Untaxed Amount" />
                            <field name="amount_total" sum="Total Amount" />
                            <field name="state" />
                        </tree>
                    </field>
                </group>
            </page>
            <page name="other_info" position="before">
                <page string="FCRED" attrs="{'invisible': [('local','=', False)]}">
                    <group string="Optionals">
                        <field name="optional_ids" nolabel="1">
                            <tree editable="bottom">
                                <field
                                    name="optional_id"
                                    options="{'no_create': True, 'no_create_edit':True, 'no_open':True}"
                                />
                                <field name="value" />
                            </tree>
                        </field>
                    </group>
                </page>
                <page
                    string="Export Invoice"
                    attrs="{'invisible': [('local','=', True)]}"
                >
                    <group string="Shipping Permissions">
                        <field
                            name="shipping_perm_ids"
                            nolabel="1"
                            widget="one2many_list"
                        >
                            <tree editable="bottom">
                                <field name="name" />
                                <field name="dst_country_id" />
                            </tree>
                        </field>
                    </group>
                    <group string="History Requests">
                        <field name="wsfex_request_ids" nolabel="1">
                            <tree>
                                <field name="request_id" />
                                <field name="date" />
                                <field name="voucher_number" />
                                <field name="voucher_type_id" />
                                <field name="result" />
                            </tree>
                            <form string="Requests" version="7.0">
                                <group>
                                    <group>
                                        <field name="voucher_type_id" />
                                        <field name="voucher_number" />
                                        <field name="request_id" />
                                    </group>
                                    <group>
                                        <field name="date" />
                                        <field name="result" />
                                        <field name="cae" />
                                        <field name="cae_duedate" />
                                    </group>
                                </group>
                                <group>
                                    <group string="Error">
                                        <field name="error" nolabel="1" />
                                    </group>
                                    <group string="Event">
                                        <field name="event" nolabel="1" />
                                    </group>
                                </group>
                                <group string="Details">
                                    <field name="detail" nolabel="1" />
                                </group>
                            </form>
                        </field>
                    </group>
                </page>
                <page string="WSFE Requests">
                    <field name="wsfe_request_ids" readonly="1">
                        <tree>
                            <field name="voucher_date" />
                            <field name="voucher_number" />
                            <field name="result" />
                            <field name="errors" />
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <record id="account_move_view_tree_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">account.move.view.tree.inherit.l10n_ar_eynes</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="denomination" />
            </field>
        </field>
    </record>

    <record id="account_invoice_action_debit_note" model="ir.actions.act_window">
        <field name="name">Customer Debit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field eval="False" name="view_id" />
        <field
            name="domain"
        >[('move_type','=','out_invoice'), ('debit_origin_id','!=', False)]</field>
        <field name="context">{
            'default_move_type':'out_invoice',
            'move_type': 'out_invoice',
            'journal_type': 'sale',
            'default_is_debit_note': True
        }</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter" />
        <field
            name="help"
        >With Customer Debit Notes you can manage the debit notes for your customers. A debit note is a document that increases the value of the debt or account balance, either by an error in billing, interest for late payment, or any other circumstance that means the increase in the balance of an account.</field>
    </record>

    <record
        id="account_invoice_action_debit_note_supplier"
        model="ir.actions.act_window"
    >
        <field name="name">Supplier Debit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field eval="False" name="view_id" />
        <field
            name="domain"
        >[('move_type','=','in_invoice'), ('debit_origin_id','!=', False)]</field>
        <field name="context">{
            'default_move_type':'in_invoice',
            'move_type': 'in_invoice',
            'journal_type': 'purchase',
            'default_is_debit_note': True
        }</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter" />
        <field
            name="help"
        >With Supplier Debit Notes you can manage the debit notes for your suppliers.
        A debit note is a document that increases the value of the debt or account balance, either by an error in billing, interest for late payment, or any other circumstance that means the increase in the balance of an account.</field>
    </record>

    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field
            name="domain"
        >[('move_type','=','out_invoice'), ('debit_origin_id','=', False)]</field>
    </record>

    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field
            name="domain"
        >[('move_type', '=', 'in_invoice'), ('debit_origin_id','=', False)]</field>
    </record>

    <menuitem
        id="account_invoice_menu_debit_note"
        name="Debit Notes"
        action="account_invoice_action_debit_note"
        sequence="7"
        parent="account.menu_finance_receivables"
    />

    <menuitem
        id="account_invoice_menu_dn_supp"
        name="Debit Notes"
        action="account_invoice_action_debit_note_supplier"
        sequence="7"
        parent="account.menu_finance_payables"
    />

</odoo>
