<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_move_view_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="%(force_journal_change_action)d"
                    string="Force Jornal Change"
                    class="oe_highlight"
                    type="action"
                    invisible="move_type in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                />
            </header>

            <!-- RIBBON -->
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <widget
                    name="web_ribbon"
                    title="COBRADO"
                    invisible="payment_state != 'paid' or move_type not in ('out_invoice', 'out_refund', 'out_receipt')"
                />
                <widget
                    name="web_ribbon"
                    title="PAGADO"
                    invisible="payment_state != 'paid' or move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
                />
            </xpath>

            <!-- MODIFICACIONES AL NAME -->
            <xpath expr="//sheet/div[hasclass('oe_title')]/span[hasclass('o_form_label')]" position="replace">
                <span class="o_form_label" invisible="move_type == 'entry' or debit_origin_id">
                    <field name="move_type" readonly="1" nolabel="1" />
                </span>
                <span class="o_form_label" invisible="move_type == 'entry' or not debit_origin_id">
                    <span>Debit Note</span>
                </span>
            </xpath>

            <xpath expr="//sheet/div[hasclass('oe_title')]/h1[1]/field[@name='name']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//sheet/div[hasclass('oe_title')]/h1[1]" position="inside">
                <h1>
                    <field
                        name="denomination"
                        force_save="1"
                        readonly="1"
                        invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                    />
                    <field
                        name="name"
                        class="oe_inline"
                        readonly="1"
                        force_save="1"
                        invisible="state == 'draft'"
                    />
                    <field
                        name="supplier_move_reference"
                        class="oe_inline"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund')"
                        required="move_type in ('in_invoice', 'in_refund')"
                    />
                </h1>
            </xpath>

            <!-- MODIFICACIONES EN VENCIMIENTO / TERMINOS DE PAGO FACTURA -->
            <xpath expr="//div[@name='due_date']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//div[@name='due_date']" position="after">
                <div
                    class="d-flex"
                    invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"
                >
                    <field
                        name="invoice_date_due"
                        force_save="1"
                        placeholder="Date"
                        readonly="invoice_payment_term_id or state != 'draft'"
                    />
                    <span class="o_form_label mx-3 oe_edit_only"> or </span>
                    <field name="invoice_payment_term_id" placeholder="Terms" readonly="state != 'draft'" />
                </div>
            </xpath>

            <!-- MODIFICACION ATRIBUTOS PARTNER -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="required">
                    move_type in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')
                </attribute>
                <attribute name="invisible">
                    move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')
                </attribute>
            </xpath>

            <!-- MODIFICACION ATRIBUTOS PARTNER BANK -->
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="invisible">
                    move_type in ('in_invoice', 'in_refund')
                </attribute>
            </xpath>

            <!-- NUEVOS CAMPOS EN SECCION IZQUIERDA -->
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field
                    name="disable_perceptions"
                    invisible="move_type not in ('out_invoice', 'out_refund')"
                    readonly="state != 'draft'"
                />
                <field name="is_FCE_invoice" invisible="True" />
                <field name="voucher_type_domain" invisible="True" />
                <field
                    name="voucher_type_id"
                    invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                    required="move_type in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                    domain="voucher_type_domain"
                    widget="selection"
                    readonly="state != 'draft' or move_type in ('out_invoice', 'out_refund')"
                />
                <field name="fiscal_type" invisible="move_type not in ('out_invoice', 'out_refund')" />
            </xpath>

            <!-- NUEVOS CAMPOS MULTI MONEDA -->
            <div name="journal_div" position="after">
                <field name="currency_preciated" invisible="1" />
                <field name="is_multi_currency" invisible="1" />
                <label for="currency_rate" invisible="not is_multi_currency" />
                <div class="d-flex">
                    <field
                        name="currency_rate"
                        placeholder="Currency Rate"
                        invisible="not is_multi_currency"
                        readonly="state != 'draft'"
                        class="oe_inline"
                    />
                    <button
                        name="%(action_account_change_currency)d"
                        aria-label="Opened"
                        type="action"
                        class="btn-link oe_inline"
                        invisible="state != 'draft'"
                        groups="account.group_account_user"
                    >
                        <i
                            title="Update Currency: Will convert the amount lines to the new currency set"
                            class="fa fa-fw fa-refresh"
                        />
                        <span>Update Rate</span>
                    </button>
                </div>
                <label for="preciated_alert" invisible="not currency_preciated" />
                <div>
                    <!-- Se agrega el campo currency_preciated para linkearlo al label y lograr que este -->
                    <!-- div se situe en la columna derecha de la vista -->
                    <field id="preciated_alert" name="currency_preciated" invisible="1" />
                    <i
                        invisible="not currency_preciated"
                    >Cuidado, la moneda es preciada! ponga el monto correspondiente.</i>
                </div>
            </div>

            <!-- MODIFICACION ATRIBUTOS FISCAL POSITION -->
            <xpath
                expr="//group[@name='accounting_info_group']/field[@name='fiscal_position_id']"
                position="attributes"
            >
                <attribute name="readonly">
                    move_type in ('out_invoice', 'out_refund') or state != 'draft'
                </attribute>
                <attribute name="required">
                    move_type in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')
                </attribute>
            </xpath>

            <!-- MODIFICACION EN LAS LÍNEAS DE FACTURA POR IVA PRORRATEABLE -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="after">
                <field name="fiscal_credit" column_invisible="not parent.show_fiscal_credit" />
            </xpath>

            <!-- NUEVOS CAMPOS EN PESTAÑA "OTRA INFORMACION" -->
            <xpath
                expr="//group[@name='accounting_info_group']/field[@name='fiscal_position_id']"
                position="after"
            >
                <field
                    name="company_currency_id"
                    invisible="not is_multi_currency"
                    readonly="state != 'draft'"
                />
                <field
                    name="denomination"
                    force_save="1"
                    required="move_type in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                    invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                    readonly="move_type in ('out_invoice', 'out_refund') or state != 'draft'"
                />
                <field
                    name="cae"
                    string="CAE"
                    readonly="move_type in ('out_invoice', 'out_refund')"
                    invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                />
                <field
                    name="cae_due_date"
                    readonly="move_type in ('out_invoice', 'out_refund')"
                    invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                />
                <field name="iva_digital_operation_code" />
                <field name="show_fiscal_credit" invisible="True" />
                <field name="local" invisible="1" />
            </xpath>

            <page name="other_info" position="inside">
                <div>
                    <separator string="Associated Invoices" />
                    <group>
                        <field name="inform_period" readonly="state != 'draft'" />
                        <field
                            name="inform_period_date_from"
                            invisible="not inform_period"
                            readonly="state != 'draft'"
                        />
                        <field
                            name="inform_period_date_to"
                            invisible="not inform_period"
                            readonly="state != 'draft'"
                        />
                    </group>
                    <field
                        name="associated_inv_ids"
                        nolabel="1"
                        domain="[('state', '=', 'posted'), ('partner_id', '=', partner_id)]"
                        invisible="inform_period"
                        readonly="state != 'draft'"
                    >
                        <tree>
                            <field name="partner_id" groups="base.group_user" />
                            <field name="date" />
                            <field name="denomination" />
                            <field name="name" />
                            <field name="amount_residual" sum="Residual Amount" />
                            <field name="amount_untaxed" sum="Untaxed Amount" />
                            <field name="amount_total" sum="Total Amount" />
                            <field name="state" />
                        </tree>
                    </field>
                </div>
            </page>

            <!-- NUEVAS PESTAÑAS -->
            <page name="other_info" position="before">
                <page
                    string="Perceptions"
                    invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                >
                    <field
                        name="perception_ids"
                        nolabel="1"
                        colspan="4"
                        context="{'default_partner_id': partner_id, 'default_company_id': company_id, 'default_date': date}"
                        readonly="state != 'draft'"
                    >
                        <tree editable="bottom">
                            <field name="name" column_invisible="True" force_save="True" />
                            <field name="partner_id" column_invisible="True" force_save="True" />
                            <field name="company_id" column_invisible="True" force_save="True" />
                            <field name="tax_app_id" column_invisible="True" force_save="True" />
                            <field name="perception_id_domain" column_invisible="True" />
                            <field name="date" />
                            <field
                                name="perception_id"
                                string="Perception Type"
                                domain="perception_id_domain"
                            />
                            <field name="concept_id" />
                            <field name="base" />
                            <field name="amount" />
                            <field
                                name="base_secondary_currency"
                                column_invisible="not parent.is_multi_currency"
                            />
                            <field
                                name="amount_secondary_currency"
                                column_invisible="not parent.is_multi_currency"
                            />
                            <field name="state_id" />
                        </tree>
                    </field>
                </page>

                <page string="FCRED" invisible="not is_FCE_invoice">
                    <field name="optional_ids">
                        <tree editable="bottom">
                            <field name="code" />
                            <field
                                name="optional_id"
                                options="{'no_create': True, 'no_create_edit':True, 'no_open':True}"
                            />
                            <field name="value" />
                        </tree>
                    </field>
                </page>

                <page
                    string="Export Invoice"
                    invisible="local or move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                >
                    <group>
                        <field
                            name="export_type_id"
                            widget="selection"
                            required="not local and move_type in ('out_invoice', 'out_refund')"
                        />
                        <field
                            name="dst_country_id"
                            required="not local and move_type in ('out_invoice', 'out_refund')"
                        />
                    </group>
                    <group string="Shipping Permissions">
                        <field name="shipping_perm_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="name" />
                                <field name="dst_country_id" />
                            </tree>
                        </field>
                    </group>
                </page>

                <page string="WS Requests" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="ws_request_ids" readonly="1">
                        <tree>
                            <field name="request_id" />
                            <field name="result" />
                            <field name="errors" />
                        </tree>
                    </field>
                </page>
            </page>

            <!-- FOOTER -->
            <xpath expr="//group[hasclass('oe_invoice_lines_tab')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[hasclass('oe_invoice_lines_tab')]" position="after">
                <group col="12" class="oe_invoice_lines_tab">
                    <!-- If the invoice has same currency than the company -->
                    <group colspan="8" invisible="is_multi_currency">
                        <span colspan="2">
                            <field
                                name="narration"
                                placeholder="Terms and Conditions"
                                class="oe_inline text-break"
                                nolabel="1"
                            />
                        </span>
                    </group>

                    <!-- otherwise -->
                    <group colspan="4" invisible="not is_multi_currency">
                        <span colspan="2">
                            <field
                                name="narration"
                                placeholder="Terms and Conditions"
                                class="oe_inline text-break"
                                nolabel="1"
                            />
                        </span>
                    </group>
                    <!-- Totals (only invoices / receipts) -->
                    <group colspan="4" class="oe_subtotal_footer" invisible="not is_multi_currency">
                        <field
                            name="amount_taxed_cur"
                            invisible="amount_taxed_cur == 0"
                            widget="monetary"
                            options="{'currency_field': 'secondary_currency_id'}"
                        />
                        <field
                            name="amount_no_taxed_cur"
                            invisible="amount_no_taxed_cur == 0"
                            widget="monetary"
                            options="{'currency_field': 'secondary_currency_id'}"
                        />
                        <field
                            name="amount_exempt_cur"
                            invisible="amount_exempt_cur == 0"
                            widget="monetary"
                            options="{'currency_field': 'secondary_currency_id'}"
                        />
                        <field
                            name="amount_perception_curr"
                            invisible="amount_perception_curr == 0"
                            widget="monetary"
                            options="{'currency_field': 'secondary_currency_id'}"
                        />
                        <field
                            name="amount_tax_cur"
                            invisible="amount_tax_cur == 0"
                            widget="monetary"
                            options="{'currency_field': 'secondary_currency_id'}"
                        />
                        <field
                            name="amount_total_cur"
                            class="oe_subtotal_footer_separator"
                            widget="monetary"
                            options="{'currency_field': 'secondary_currency_id'}"
                        />
                        <label for="subtotal_label" />
                        <div>
                            <!-- Se agrega el campo is_multi_currency para linkearlo al label y lograr que este -->
                            <!-- div se situe en la columna derecha de la vista -->
                            <field id="subtotal_label" name="is_multi_currency" invisible="1" />
                            <span class="oe_inline">Amounts in </span><field
                                name="secondary_currency_id"
                                readonly="True"
                                options="{'no_create': True, 'no_open': True}"
                                class="oe_inline"
                            />
                        </div>
                    </group>
                    <group colspan="4">
                        <group
                            class="oe_subtotal_footer"
                            invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or payment_state == 'invoicing_legacy'"
                        >

                            <field
                                name="tax_totals"
                                widget="account-tax-totals-field"
                                nolabel="1"
                                colspan="2"
                                readonly="state != 'draft' or (move_type not in ('in_invoice', 'in_refund', 'in_receipt') and not quick_edit_mode)"
                            />

                            <field name="invoice_payments_widget" colspan="2" nolabel="1" widget="payment" />
                            <field
                                name="amount_residual"
                                class="oe_subtotal_footer_separator"
                                invisible="state == 'draft'"
                            />
                        </group>
                        <field
                            name="invoice_outstanding_credits_debits_widget"
                            class="oe_invoice_outstanding_credits_debits"
                            colspan="2"
                            nolabel="1"
                            widget="payment"
                            invisible="state != 'posted'"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="account_move_view_tree_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">account.move.view.tree.inherit.l10n_ar_eynes</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="denomination" />
                <field name="voucher_type_id" />
            </field>
        </field>
    </record>

    <record id="account_invoice_action_debit_note" model="ir.actions.act_window">
        <field name="name">Customer Debit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field eval="False" name="view_id" />
        <field name="domain">[('move_type','=','out_invoice'), ('is_debit_note','=', True)]</field>
        <field name="context">{
            'default_move_type':'out_invoice',
            'move_type': 'out_invoice',
            'journal_type': 'sale',
            'default_is_debit_note': True
            }</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter" />
        <field name="help">With Customer Debit Notes you can manage the debit notes for your
            customers.
            A debit note is a document that increases the value of the debt or account balance,
            either by an error in billing, interest for late payment, or any other circumstance that
            means the increase in the balance of an account.</field>
    </record>

    <record id="account_invoice_action_debit_note_supplier" model="ir.actions.act_window">
        <field name="name">Supplier Debit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field eval="False" name="view_id" />
        <field name="domain">[('move_type','=','in_invoice'), ('is_debit_note','=', True)]</field>
        <field name="context">{
            'default_move_type':'in_invoice',
            'move_type': 'in_invoice',
            'journal_type': 'purchase',
            'default_is_debit_note': True
            }</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter" />
        <field name="help">With Supplier Debit Notes you can manage the debit notes for your
            suppliers.
            A debit note is a document that increases the value of the debt or account balance,
            either by an error in billing, interest for late payment, or any other circumstance that
            means the increase in the balance of an account.</field>
    </record>

    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="domain">[('move_type','=','out_invoice'), ('is_debit_note','=', False)]</field>
    </record>

    <record id="account.menu_action_move_out_receipt_type" model="ir.ui.menu">
        <field name="name">Receipts</field>
        <field name="active" eval="False" />
    </record>

    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field name="name">Supplier Invoices</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('is_debit_note','=', False)]</field>
    </record>

    <record id="view_account_move_multicurrency_filter" model="ir.ui.view">
        <field name="name">account.move.multicurrency.select</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <filter name="late" position="after">
                <separator />
                <filter
                    name="multicurrency"
                    string="MultiCurrency"
                    domain="[('is_multi_currency','=',True)]"
                    help="Invoices not in company currency"
                />
            </filter>
        </field>
    </record>


    <menuitem
        id="account_invoice_menu_debit_note"
        name="Debit Notes"
        action="account_invoice_action_debit_note"
        sequence="7"
        parent="account.menu_finance_receivables"
    />

    <menuitem
        id="account_invoice_menu_dn_supp"
        name="Debit Notes"
        action="account_invoice_action_debit_note_supplier"
        sequence="7"
        parent="account.menu_finance_payables"
    />

</odoo>
