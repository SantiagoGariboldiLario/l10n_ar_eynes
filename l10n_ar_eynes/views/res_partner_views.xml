<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_partner_view_form_inherit_l10n_ar_eynes" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    icon="fa-id-card"
                    name="%(action_partner_update_from_afip)d"
                    type="action"
                >
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_value">PADRON AFIP</span>
                        <span class="o_stat_text oe_text_center">
                            <field name="last_update_from_afip" readonly="True" />
                        </span>
                    </div>
                </button>
            </div>

            <group name="sale" position="inside">
                <field name="express_id" domain="[('supplier_rank', '>', 0)]" />
            </group>

            <xpath expr="//field[@name='country_id']" position="attributes">
                <attribute name="readonly">type == 'contact' and parent_id</attribute>
                <attribute name="required">dst_cuit</attribute>
            </xpath>

            <xpath expr="//field[@name='vat']" position="before">
                <field name="dst_cuit" invisible="1" />
                <field name="is_checked_special_partner_required_fields" invisible="1" />
                <field
                    name="document_type_id"
                    placeholder="Document Type..."
                    widget="selection"
                    required="is_checked_special_partner_required_fields"
                />
                <field
                    name="dst_cuit_id"
                    invisible="not dst_cuit"
                    required="dst_cuit"
                    options="{'no_create': True}"
                />
                <field name="supplier_rank" invisible="1" />
                <field name="customer_rank" invisible="1" />
            </xpath>

            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="string">NIF</attribute>
                <attribute name="required" eval="is_checked_special_partner_required_fields" />
            </xpath>

            <xpath expr="//field[@name='vat']" position="after">
                <field name="nro_insc_iibb" />
            </xpath>

            <xpath expr="//field[@name='property_account_position_id']" position="after">
                <field name="fcred_transfer" />
            </xpath>

            <xpath expr="//field[@name='property_account_position_id']" position="attributes">
                <attribute name="required" eval="is_checked_special_partner_required_fields" />
            </xpath>

            <page name="accounting" position="after">
                <page
                    string="Perceptions"
                    groups="account.group_account_invoice,account.group_account_manager"
                >
                    <field name="perception_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="perception_id" />
                            <field name="activity_id" />
                            <field name="period" widget='month_year_format' />
                            <field name="percent" />
                            <field name="excluded_percent" />
                            <field name="ex_date_from" />
                            <field name="ex_date_to" />
                            <field name="exclusion_certificate" />
                            <field name="sit_iibb" />
                        </tree>
                    </field>
                    <separator string="IIBB" />
                    <field name="gross_income_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="province_id" />
                            <field name="type_taxpayer" />
                        </tree>
                    </field>
                </page>
                <page
                    string="Retentions"
                    name="retentions"
                    groups="account.group_account_invoice,account.group_account_manager"
                >
                    <group name="retention_activity" string="Retention activity">
                        <field name="retention_activity_id" />
                    </group>
                    <field name="retention_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="retention_id" />
                            <field name="period" widget='month_year_format' />
                            <field name="percent" />
                            <field name="excluded_percent" />
                            <field name="ex_date_from" />
                            <field name="ex_date_to" />
                            <field name="exclusion_certificate" />
                            <field name="exclusion_date_certificate" />
                            <field name="sit_iibb" />
                            <field name="from_padron" readonly="True" />
                            <field name="company_id" invisible="1" />
                        </tree>
                    </field>
                    <group string="Advance Payment Retentions" invisible="supplier_rank == 0">
                        <field name="advance_retention_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="retention_id" />
                                <field name="concept_id" />
                                <field name="company_id" invisible="1" />
                            </tree>
                        </field>
                    </group>
                </page>
            </page>

        </field>
    </record>

    <record id="address_street_extended_city_form" model="ir.ui.view">
        <field name="name">partner.form.address.order</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_address_extended.address_street_extended_city_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_address_format')]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <div class="o_address_format">
                    <field
                        name="street"
                        placeholder="Street..."
                        class="o_address_street"
                        readonly="type == 'contact' and parent_id"
                    />

                    <field
                        name="street2"
                        placeholder="Street 2..."
                        class="o_address_street"
                        readonly="type == 'contact' and parent_id"
                    />

                    <field name="num" placeholder="Number" />
                    <field name="floor" placeholder="Floor" />
                    <field name="door" placeholder="Door" />
                    <field name="apartment" placeholder="Apartment" />

                </div>
                <field
                    name="country_id"
                    placeholder="Country"
                    class="o_address_country"
                    options='{"no_open": True, "no_create": True}'
                    readonly="type == 'contact' and parent_id"
                />

                <field
                    name="state_id"
                    class="o_address_state"
                    placeholder="State"
                    options="{'no_open': True, 'no_quick_create': True}"
                    readonly="type == 'contact' and parent_id"
                    context="{'country_id': country_id, 'default_country_id': country_id}"
                />

                <field
                    name="city"
                    placeholder="City"
                    class="o_address_city"
                    invisible="country_enforce_cities and (city_id or city in ('', False))"
                    readonly="type == 'contact' and parent_id"
                />

                <field name="country_enforce_cities" invisible="1" />

                <field
                    name="city_id"
                    placeholder="City"
                    class="o_address_city"
                    domain="[('country_id', '=', country_id)]"
                    invisible="not country_enforce_cities"
                    readonly="type == 'contact' and parent_id"
                    context="{'default_country_id': country_id, 'default_state_id': state_id, 'default_zipcode': zip}"
                />

                <field
                    name="zip"
                    placeholder="ZIP"
                    class="o_address_zip"
                    readonly="type == 'contact' and parent_id"
                />
            </xpath>
        </field>
    </record>

    <record id="res_partner_bank_view_form_check" model="ir.ui.view">
        <field name="name">res.partner.bank.form.check.inherit</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form" />
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">

            <field name="acc_number" position="after">
                <field name="account_id" />
            </field>

            <field name="bank_id" position="attributes">
                <attribute name="required">True</attribute>
            </field>

        </field>
    </record>

</odoo>
