<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="libro_iva_generated_files_tree_view" model="ir.ui.view">
        <field name="name">Libro.iva.generated.files.tree</field>
        <field name="model">libroiva.generated.files</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="code" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="attachment_id" />
            </tree>
        </field>
    </record>

    <record id="libro_iva_generated_files_form_view" model="ir.ui.view">
        <field name="name">Libro.iva.generated.files.form</field>
        <field name="model">libroiva.generated.files</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Libro IVA generated files" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="date_from" />
                        <field name="date_to" />
                        <label for="datas" string="Generated File" />
                        <div class="oe_inline">
                            <field name="datas" class="pr-3" />
                            <field name="attachment_id" />
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_libro_IVA_generated_files" model="ir.actions.act_window">
        <field name="name">Libro IVA generated files</field>
        <field name="res_model">libroiva.generated.files</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
