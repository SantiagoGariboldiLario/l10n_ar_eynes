<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ***************** -->
    <!-- * Voucher Types * -->
    <!-- ***************** -->
    <!-- Form View for res_voucher_type -->
    <record id="view_wsfe_voucher_type_form" model="ir.ui.view">
        <field name="name">res.voucher.type.form</field>
        <field name="model">res.voucher.type</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Voucher Types">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="afip_code" />
                        <field name="voucher_model" />
                        <field name="doc_type" />
                        <field name="denomination" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View for voucher type -->
    <record id="view_wsfe_voucher_type_tree" model="ir.ui.view">
        <field name="name">res.voucher.type.tree</field>
        <field name="model">res.voucher.type</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="afip_code" />
                <field name="voucher_model" />
                <field name="doc_type" />
                <field name="denomination" />
            </tree>
        </field>
    </record>

    <!--Window Action para Voucher Types-->
    <record id="action_wsfe_voucher_type_tree" model="ir.actions.act_window">
        <field name="name">Voucher Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.voucher.type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
