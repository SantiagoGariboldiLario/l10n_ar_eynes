<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="report_files_view_form" model="ir.ui.view">
        <field name="name">report.files.form</field>
        <field name="model">report.files</field>
        <field name="arch" type="xml">
            <form string="Report Files" create="false" edit="false">
                <header>
                    <button
                        name="to_declared"
                        type="object"
                        states="generated"
                        string="Declare"
                        class="oe_highlight"
                    />
                    <button
                        name="to_generated"
                        type="object"
                        states="declared"
                        string="Un-Declare"
                        class="oe_highlight"
                    />
                    <button
                        name="regenerate"
                        type="object"
                        attrs="{'invisible': [('state', 'in', 'declared')]}"
                        string="Regenerate"
                        class="oe_highlight"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="error,generated,declared" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="exporter_id" />
                            <field name="company_id" />
                        </group>
                        <group>
                            <field name="date_start" />
                            <field name="date_stop" />
                            <field name="write_date" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Errors" attrs="{'invisible': [('error_ids', '=', [])]}">
                            <field name="error_ids">
                                <tree decoration-danger="type=='error'">
                                    <button
                                        type="object"
                                        name="goto"
                                        title="Go To"
                                        class="btn-link mb4 fa fa-arrow-right"
                                        context="{'field_name': 'resource_name'}"
                                    />
                                    <field name="resource_name" />
                                    <field name="error" />
                                    <field name="type" />
                                </tree>
                            </field>
                        </page>
                        <page string="Files">
                            <field name="attachment_ids">
                                <tree>
                                    <field name="name" />
                                    <field name="write_date" />
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="report_files_view_tree" model="ir.ui.view">
        <field name="name">report.files.tree</field>
        <field name="model">report.files</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="name" />
                <field name="exporter_id" />
                <field name="date_start" />
                <field name="date_stop" />
                <field name="state" />
            </tree>
        </field>
    </record>

</odoo>
