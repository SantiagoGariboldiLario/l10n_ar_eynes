<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- TREE SIFERE REPORTS -->
    <record id="report_files_sifere" model="ir.actions.act_window">
        <field name="name">SIFERE - Generated Reports</field>
        <field name="res_model">report.files</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('exporter_codename', 'ilike', '%sifere%')]</field>
        <field name="context">{}</field>
    </record>

    <!-- WIZARD VIEW -->
    <record id="wizard_create_sifere_files" model="ir.ui.view">
        <field name="name">SIFERE File Generation</field>
        <field name="model">create.sifere.files</field>
        <field name="arch" type="xml">
            <form>
                <h4>Esta ventana te permite generar los reportes de SIFERE para un periodo determinado"</h4>
                <separator colspan="4" />
                <group>
                    <field name="company_id_domain" invisible="True" />
                    <field name="company_id" domain="company_id_domain" />
                    <field name="period_start" />
                    <field name="period_end" />
                </group>
                <footer>
                    <button name="create_files" string="Generar" type="object" class="btn-primary" />
                    <button special="cancel" string="Cancelar" class="btn-default" />
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_create_sifere_files_action" model="ir.actions.act_window">
        <field name="name">SIFERE File Generation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">create.sifere.files</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
