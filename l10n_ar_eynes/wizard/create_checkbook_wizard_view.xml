<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="create_checkbook_wizard_view_form" model="ir.ui.view">
        <field name="name">create.checkbook.wizard.view.form</field>
        <field name="model">create.checkbook.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Checkbook">
                <sheet>
                    <group>
                        <group>
                            <field name="journal_id" />
                            <field name="checkbook_format" />
                            <field name="type" required="1" />
                            <field name="required_num_readonly" invisible="True" />
                            <field name="required_num" readonly="required_num_readonly" />
                        </group>
                        <group>
                            <field name="number" />
                            <field name="start_num" required="required_num" invisible="not required_num" />
                            <field name="end_num" required="required_num" invisible="not required_num" />
                        </group>
                    </group>
                    <div invisible="required_num" class="text-danger">
                        <p>
                            Echeqs without number will be created on the Payment Order when you have the real number assigned by bank.
                        </p>
                    </div>
                    <footer>
                        <button name="create_checkbook" type="object" class="btn btn-primary">
                            Create Checkbook
                        </button>
                        <button string="Cancel" class="btn-default" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="create_checkbook_wizard_action" model="ir.actions.act_window">
        <field name="name">Create Checkbook</field>
        <field name="res_model">create.checkbook.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
