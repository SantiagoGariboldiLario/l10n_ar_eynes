<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="export_sales_by_jurisdiction_view" model="ir.ui.view">
        <field name="name">Sales/Purchases By Jurisdiction</field>
        <field name="model">export.sales.by.jurisdiction.xls</field>
        <field name="arch" type="xml">
        <form string="Report Options">
            <group colspan="4">
            </group>
            <notebook tabpos="up" colspan="4">
                <page string="Filters" name="filters">
                    <group string="Company">
                        <field name="company_ids" widget="many2many_tags" />
                        <field name="report_type" />
                    </group>
                    <group string="Periods">
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                </page>
            </notebook>
            <footer>
                <button
                        name="create_report"
                        string="Export"
                        type="object"
                        class="oe_highlight"
                        context="{'xls_export':1}"
                    />
                or
                <button string="Cancel" class="oe_link" special="cancel" />
            </footer>
        </form>
        </field>
    </record>

    <record id="action_export_sales_by_jurisdiction" model="ir.actions.act_window">
        <field name="name">Export Sales/Purchases by Jurisdiction</field>
        <field name="res_model">export.sales.by.jurisdiction.xls</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
