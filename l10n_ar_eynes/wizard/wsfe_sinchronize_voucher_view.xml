<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_wsfe_sinchronize_voucher" model="ir.ui.view">
        <field name="name">WSFE Sincronizador</field>
        <field name="model">wsfe.sinchronize.voucher</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="WSFE Sincronizador">
                <group string="Datos de consulta">
                    <group>
                        <field name="config_id" invisible="1" />
                        <field name="voucher_type" widget="selection" />
                        <field name="pos_id_domain" invisible="1" />
                        <field name="pos_id" domain="pos_id_domain" />
                        <field name="voucher_number" />
                    </group>
                    <group>
                    </group>
                </group>
                <field name="infook" invisible="1" />
                <group string="Respuesta AFIP" attrs="{'invisible': [('infook','=',False)]}">
                        <group>
                            <field name="document_type" />
                            <field name="document_number" string="Documento" />
                            <field name="date_process" string="Fecha de procesamiento" />
                            <field name="date_invoice" readonly="1" string="Fecha de factura" />
                            <field name="cae" invisible="0" string="CAE" readonly="1" />
                            <field name="cae_due_date" invisible="0" string="FV CAE" readonly="1" />
                        </group>
                        <group>
                            <!-- <field name="amount_no_taxed" /> -->
                            <!-- <field name="amount_exempt" /> -->
                            <field name="amount_taxed" />
                            <field name="amount_tax" />
                            <field name="amount_total" />
                            <!--<field name="amount_untaxed"/>-->
                            <!--<field name="currency"/>-->
                        </group>
                </group>
                <group string="Mensaje de error" attrs="{'invisible': [('infook','=',True)]}">
                    <field name="error_msg" />
                </group>
                <group
                    name="invoice"
                    string="Invoice Relationship"
                    attrs="{'invisible': [('infook','=',False)]}"
                >
                    <field name="invoice_id_domain" invisible="1" />
                    <field name="invoice_id" domain="invoice_id_domain" />
                </group>
                <footer>
                    <button name="relate_invoice" string="Sincronizar" type="object" class="oe_highlight" />
                    o
                    <button class="oe_link" special="cancel" string="Cancelar" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wsfe_sinchronize_voucher" model="ir.actions.act_window">
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="name">WSFE Sincronizador</field>
        <field name="res_model">wsfe.sinchronize.voucher</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
