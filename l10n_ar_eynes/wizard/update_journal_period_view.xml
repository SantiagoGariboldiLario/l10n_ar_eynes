<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="update_journal_period_wizard_view_form" model="ir.ui.view">
        <field name="name">update.journal.period.wizard.view.form</field>
        <field name="model">update.journal.period.wizard</field>
        <field name="arch" type="xml">
            <form string="Update journals period">
                <sheet>
                    <group>
                        <field name="due_date" />
                        <field name="selection_type" />
                    </group>
                    <field
                        name="journal_ids"
                        mode="tree"
                        invisible="selection_type != 'some'"
                        class="custom-control custom-checkbox"
                    >
                        <tree create="false" delete="false" editable="bottom">
                            <field name="selected" />
                            <field name="journal_id" readonly="1" />
                            <field name="journal_due_date" readonly="1" />
                        </tree>
                    </field>
                    <footer>
                        <button
                            name="update_periods"
                            type="object"
                            class="btn btn-primary"
                            confirm="Are you sure you want to do this?"
                        >
                            Update Periods
                        </button>
                        <button string="Cancel" class="btn-default" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="update_journals_period_action" model="ir.actions.act_window">
        <field name="name">Update journals period</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">update.journal.period.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="update_journal_period_wizard_view_form" />
        <field name="binding_model_id" ref="account.model_account_journal" />
    </record>

    <menuitem
        id="update_journals_period_menu"
        name="Update journals period"
        action="update_journals_period_action"
        parent="account.menu_finance_entries_actions"
    />

</odoo>
