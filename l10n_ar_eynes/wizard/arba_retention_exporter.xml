<odoo>
    <record id="arba_retention_exporter_wizard_view" model="ir.ui.view">
        <field name="name">arba.retention.exporter.wizard.view</field>
        <field name="model">arba.retention.exporter.wizard</field>
        <field name="arch" type="xml">
        <form string="Export ARBA Retentions">
            <span>
                This wizard allows you to create export ARBA IIBB Retentions. The generated files
                will be attached to the corresponding period
            </span>
            <group>
                <field name="date_from" />
                <field name="date_to" />
            </group>
            <footer>
                <button name="create_file" type="object" string="Create File" class="oe_highlight" />
                or
                <button string="Cancel" special="cancel" class="oe_link" />
            </footer>
        </form>
        </field>
    </record>

    <record id="action_create_arba_retention_file" model="ir.actions.act_window">
        <field name="name">Export ARBA Retentions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">arba.retention.exporter.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
