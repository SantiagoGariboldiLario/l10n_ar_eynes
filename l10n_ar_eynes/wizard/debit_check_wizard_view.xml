<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="debit_check_form_view" model="ir.ui.view">
        <field name="name">debit.check.form.view</field>
        <field name="model">debit.check.wizard</field>
        <field name="arch" type="xml">
            <form string="Debit Checks">
                <group>
                    <field name="multichecks" invisible="True" />
                    <field name="deposit_date" />
                    <field name="issued_check_id" invisible="multichecks" />
                </group>
                <separator string="Checks to Debit" invisible="not multichecks" />
                <field
                    name="issued_checks"
                    nolabel="1"
                    invisible="not multichecks"
                    domain="[('internal_type', '=', 'issued'), ('issued_check_state', '=', 'waiting_debit')]"
                >
                    <list create="false">
                        <field name="number" />
                        <field name="checkbook_id" />
                        <field name="bank_id" />
                        <field name="payment_date" />
                        <field name="amount" sum="Total" />
                    </list>
                </field>
                <footer>
                    <button
                        type="object"
                        string="Debit Checks"
                        name="button_debit_checks"
                        class="oe_highlight"
                        icon="fa-check"
                    />
                    <button type="special" special="cancel" string="Cancel" icon="fa-times" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Debit several checks -->
    <record id="debit_check_wizard_action" model="ir.actions.act_window">
        <field name="name">Debit Checks</field>
        <field name="res_model">debit.check.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False" />
    </record>

    <!-- Debit a single check, opened from the issued check form -->
    <record id="debit_one_check_wizard_action" model="ir.actions.act_window">
        <field name="name">Debit Checks</field>
        <field name="res_model">debit.check.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'one_check': True}</field>
    </record>

</odoo>
