<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_vat_exporter_view" model="ir.ui.view">
        <field name="name">Sale VAT</field>
        <field name="model">sale.vat.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_start" widget="month_year_format" />
                    <field name="date_end" widget="month_year_format" />
                    <field name="company_id_domain" invisible="True" />
                    <field name="company_id" domain="company_id_domain" />
                </group>
                <footer>
                    <button name="run" string="Generate" colspan="1" type="object" class="oe_highlight" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_export_sale_vat" model="ir.actions.act_window">
        <field name="name">Sale VAT</field>
        <field name="res_model">sale.vat.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
