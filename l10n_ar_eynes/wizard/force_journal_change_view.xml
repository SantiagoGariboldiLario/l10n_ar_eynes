<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_check_deposit_form_view" model="ir.ui.view">
        <field name="name">force.journal.change.wizard.form</field>
        <field name="model">force.journal.change.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="new_journal_id" widget="selection" />
                    </group>
                </group>
                <footer>
                    <button
                        type="object"
                        name="force_journal_change"
                        string="Force Change"
                        class="oe_highlight"
                    />
                    or
                    <button class="oe_link" special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="force_journal_change_action" model="ir.actions.act_window">
        <field name="name">Force Journal Change</field>
        <field name="res_model">force.journal.change.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="l10n_ar_eynes.model_account_move" />
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
