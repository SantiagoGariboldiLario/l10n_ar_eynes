<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="accredit_check_action" model="ir.actions.act_window">
        <field name="name">Accredit check</field>
        <field name="res_model">accredit.check.wizard</field>
        <field name="view_mode">form</field>
        <field name="arch" type="xml">
            <form string="Accredit Checks">
                <group colspan="8" col="8">
                    <field name="issued_checks" widget="many2many_checkboxes" colspan="8"/>
                </group>
                <footer>
                    <button type="object" string="Accredit Checks" name="button_accredit_checks"
                        class="oe_highlight" icon="fa-check"/>
                    <button type="special" special="cancel" string="Cancel" icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="accredit_check_wizard_action" model="ir.actions.act_window">
        <field name="name">Accredit Checks</field>
        <field name="res_model">accredit.check.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
