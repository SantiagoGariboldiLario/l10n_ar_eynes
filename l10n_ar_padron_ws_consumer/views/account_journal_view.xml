<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_journal_inherit_l10n_ar_padron" model="ir.ui.view">
        <field name="name">account.journal.inherit.l10n.ar.padron</field>
        <field name="model">account.journal</field>
        <field
            name="inherit_id"
            ref="l10n_ar_eynes.account_journal_view_form_inherit_l10n_ar_eynes"
        />
        <field name="arch" type="xml">

            <xpath expr="//page[@name='perceptions']" position="inside">
                <group string="Padron Information">
                    <field name="padron_state_id" />
                </group>
            </xpath>

            <xpath expr="//page[@name='retentions']" position="inside">
                <group string="Padron Information">
                    <field name="padron_state_id" />
                </group>
            </xpath>

        </field>
    </record>
</odoo>
