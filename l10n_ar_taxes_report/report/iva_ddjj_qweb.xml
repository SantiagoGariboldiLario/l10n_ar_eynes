<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="weblearns_layout_iva_ddjj">
        <div class="header">
            <table style="width: 100%; margin: 40px auto; border: transparent;">
                <thead>
                </thead>
                <tbody>
                    <tr>
                        <td style="text-align: left; font-size: small;">
                            <strong> <t t-out="o.company_id.name" /> </strong>
                        </td>
                        <td style="width: 50%; text-align: center; font-size: medium;">
                            <strong> POSICION IVA </strong>
                        </td>
                        <td style="width: 30%; text-align: right; font-size: small;">
                            <span>Desde el: <t t-out="date_start" /> </span>
                            <br />
                            <span>Hasta el: <t t-out="date_end" /> </span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div
            class="article"
            t-att-data-oe-model="o and o._name"
            t-att-data-oe-id="o and o.id"
            t-att-data-oe-lang="o and o.env.context.get('lang')"
        >
          <t t-out="0" />
        </div>
    </template>

    <template id="iva_ddjj_qweb">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_ar_taxes_report.weblearns_layout_iva_ddjj">
                    <div class="page">
                        <!-- REPORT BODY -->
                        <table style="width: 90%; margin: 10px auto;">
                            <thead>
                            </thead>
                            <tbody>
                                <t t-foreach="vat_info" t-as="line">
                                    <tr class="global-row">
                                        <td class="text-col"><t t-out="line[0]" /></td>
                                        <td class="numeric-col">
                                            <t t-set="amount" t-value="float(line[1])" />
                                            <t
                                                t-set="amount_formatted"
                                                t-value="'{:,.2f}'.format(amount).replace(',', 'X').replace('.', ',').replace('X', '.')"
                                            />
                                            <t t-out="amount_formatted" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <style>
                        .total-row td {
                            border-top-width: 1px !important;
                            border-top-color: black !important;
                            border-top-style: solid !important;
                            border-bottom-width: 1px !important;
                            border-bottom-color: black !important;
                            border-bottom-style: solid !important;
                            font-weight: bold;
                            font-size: medium;
                        }
                        .global-row {
                            font-size: medium;
                        }
                        .text-col {
                            text-align: left;
                        }
                        .numeric-col {
                            text-align: right;
                        }
                    </style>
                </t>
            </t>
        </t>
    </template>
</odoo>
