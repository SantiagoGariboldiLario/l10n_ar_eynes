<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="iibb_ddjj_config_tree" model="ir.ui.view">
        <field name="name">iibb.ddjj.config.tree</field>
        <field name="model">iibb.ddjj.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="company_id" />
            </tree>
        </field>
    </record>

    <record id="iibb_ddjj_config_form" model="ir.ui.view">
        <field name="name">iibb.ddjj.config.form</field>
        <field name="model">iibb.ddjj.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" />
                        <field name="name" />
                    </group>
                    <h2 class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small">Relación de Provincias con su Cuenta de Saldo a Favor</h2>
                    <field name="jurisdiction_line_ids">
                        <tree editable="top">
                            <field name="config_id" column_invisible="True" />
                            <field name="company_id" column_invisible="True" />
                            <field name="state_id" />
                            <field name="account_id" />
                            <field name="coefficient" />
                            <field name="percentage" />
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iibb_ddjj_config" model="ir.actions.act_window">
        <field name="name">IIBB DDJJ Report Configuration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">iibb.ddjj.config</field>
        <field name="view_mode">tree</field>
        <field
            name="view_ids"
            eval="[
        (5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('iibb_ddjj_config_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('iibb_ddjj_config_form')})
        ]"
        />
    </record>
</odoo>
