<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="iva_ddjj_config_tree" model="ir.ui.view">
        <field name="name">iva.ddjj.config.tree</field>
        <field name="model">iva.ddjj.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="company_id" />
            </tree>
        </field>
    </record>

    <record id="iva_ddjj_config_form" model="ir.ui.view">
        <field name="name">iva.ddjj.config.form</field>
        <field name="model">iva.ddjj.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" />
                        <field name="free_availability_balance_account_id" />
                        <field name="last_period_balance_account_id" />
                        <field name="technical_balance_account_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iva_ddjj_config" model="ir.actions.act_window">
        <field name="name">IVA DDJJ Report Configuration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">iva.ddjj.config</field>
        <field name="view_mode">tree</field>
        <field
            name="view_ids"
            eval="[
        (5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('iva_ddjj_config_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('iva_ddjj_config_form')})
        ]"
        />
    </record>
</odoo>
