<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="iibb_ddjj_wizard" model="ir.ui.view">
        <field name="name">iibb.ddjj.wizard</field>
        <field name="model">iibb.ddjj</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" />
                        <field name="config_id" />
                        <field name="period" />
                    </group>
                </sheet>
                <footer>
                    <button name="create_pdf" string="Generar" type="object" class="btn-primary" />
                    <button special="cancel" string="Cancelar" class="btn-default" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_iibb_ddjj" model="ir.actions.act_window">
        <field name="name">IIBB DDJJ Report</field>
        <field name="res_model">iibb.ddjj</field>
        <field name="view_mode">form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="target">new</field>
    </record>
</odoo>
